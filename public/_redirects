# Host and scheme canonicalisation is NOT possible in this file: Cloudflare Pages
# _redirects only matches a path, not a scheme or hostname (domain-level redirects are
# explicitly unsupported), so the rules below are path-only. Verified live behaviour:
#   http://btechwaletech.in/      -> 301 https://btechwaletech.in/        OK (edge)
#   http://www.btechwaletech.in/  -> 301 https://www.btechwaletech.in/    stays on www
#   https://www.btechwaletech.in/ -> 200, full duplicate of the site      NEEDS FIXING
#   https://btechwaletech.in/about -> 308 /about/                         OK (Pages)
# www serves all 2670 pages with a non-www canonical, which is what Search Console
# reports as "Alternate page with proper canonical tag". Fix it in the Cloudflare
# dashboard, not here: either remove www.btechwaletech.in from the Pages project's
# custom domains, or add a zone Redirect Rule
#   (hostname eq "www.btechwaletech.in") -> https://btechwaletech.in${http.request.uri}  301
# Trailing slashes already 308 to the canonical form via Pages asset serving. Do not add
# a splat rule for it: /* /:splat/ loops, and /:path /:path/ would break /robots.txt,
# /sitemap-index.xml, /llms.txt and every file under /_astro/.

# Misspelled freelance URLs -> canonical pages
/freelencers /freelancers/ 301
/freelencers/ /freelancers/ 301
/freelencing /freelancing/ 301
/freelencing/ /freelancing/ 301

# Bhiwadi pages renamed (we are freelancers, not a company)
/bhiwadi-rajasthan/software-development-company /bhiwadi-rajasthan/software-development-services/ 301
/bhiwadi-rajasthan/software-development-company/ /bhiwadi-rajasthan/software-development-services/ 301
/bhiwadi-rajasthan/it-company /bhiwadi-rajasthan/it-solutions/ 301
/bhiwadi-rajasthan/it-company/ /bhiwadi-rajasthan/it-solutions/ 301

# Common sitemap URLs crawlers try
/sitemap.xml /sitemap-index.xml 301
/sitemap_index.xml /sitemap-index.xml 301

# Two confirmed 404s traced through git history.
# /india/bihar/ was linked from src/pages/india/west-bengal/index.astro (397cb7e, 2026-08-11)
# but the route was never built; Bihar is served by /it-services/bihar/.
/india/bihar /it-services/bihar/ 301
/india/bihar/ /it-services/bihar/ 301

# /favicon.svg shipped in ebd4af3 and was referenced from every page's <link rel="icon">
# until it was deleted in 038238e (2026-09-21). Googlebot fetched it site-wide for six weeks.
/favicon.svg /favicon.ico 301
