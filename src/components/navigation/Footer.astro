---
import { Image } from "astro:assets";
import WhatsAppIcon from "@components/common/WhatsAppIcon.astro";
import { siteBrand, siteContact } from "@data/site/site-config";
import { itServicesRegions, regionPath } from "@data/it-services/locations";
import logo from "../../assets/images/mainlogo.png";

const countries = [
  ["USA", "/usa/"],
  ["United Kingdom", "/uk/"],
  ["Canada", "/canada/"],
  ["Australia", "/australia/"],
  ["New Zealand", "/new-zealand/"],
  ["UAE", "/uae/"],
  ["Saudi Arabia", "/saudi-arabia/"],
  ["Singapore", "/singapore/"],
  ["Japan", "/japan/"],
  ["Germany", "/germany/"],
  ["Netherlands", "/netherlands/"],
  ["India", "/india/"],
  ["All countries", "/countries/"],
];

const columns = [
  {
    title: "Services",
    links: [
      ["Web development", "/services/web-development/"],
      ["SEO services", "/services/seo-services/"],
      ["Android & iOS apps", "/it-services/android-ios-app/"],
      ["IT services", "/it-services/"],
      ["Hire IT freelancers", "/freelancers/"],
      ["Freelancing services", "/freelancing/"],
      ["All services", "/services/"],
      ["Industries", "/industries/"],
    ],
  },
  {
    title: "Locations",
    links: [
      ["Delhi", "/india/delhi/"],
      ["Mumbai", "/it-services/maharashtra/mumbai/"],
      ["Hyderabad", "/it-services/telangana/hyderabad/"],
      ["Bangalore", "/india/karnataka/bangalore/"],
      ["Gurugram", "/it-services/haryana/gurugram/"],
      ["Gujarat", "/gujarat/"],
      ["Bhiwadi", "/bhiwadi-rajasthan/"],
      ["All India locations", "/it-services/"],
    ],
  },
  {
    title: "Hire freelancers",
    links: [
      ["Freelance web developer", "/freelance-web-developer/"],
      ["Web developer near me", "/web-developer-near-me/"],
      ["Freelance app developer", "/freelance-app-developer/"],
      ["Hire Android developer", "/hire-android-developer/"],
      ["Freelance AI developer", "/freelance-ai-developer/"],
      ["Freelance SEO expert", "/freelance-seo-expert/"],
      ["Hire software developer", "/hire-software-developer/"],
    ],
  },
  {
    title: "About us",
    links: [
      ["About", "/about/"],
      ["Portfolio", "/portfolio/"],
      ["Case studies", "/case-studies/"],
      ["Pricing", "/pricing/"],
      ["Contact", "/contact/"],
      ["Privacy policy", "/privacy-policy/"],
      ["Terms of service", "/terms/"],
      ["Refund policy", "/refund-policy/"],
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <!-- Top: brand + nav columns -->
    <div class="footer-top">
      <div class="footer-brand-col">
        <a class="footer-brand" href="/" aria-label={`${siteBrand.name} home`}>
          <Image src={logo} alt="" height={96} densities={[1, 2]} />
          <span class="footer-brand-wordmark">BtechWaleTech</span>
        </a>
        <p class="footer-blurb">
          Freelance IT services for websites, software, SEO, AI automation, and data workflows — built in India, delivered worldwide.
        </p>
        <div class="footer-trust-row">
          <span class="trust-badge">Engineering Ethics</span>
          <span class="trust-badge">IP Ownership</span>
          <span class="trust-badge">India-First</span>
        </div>

        <div class="footer-contact" aria-label="Contact details">
          <a href={siteContact.emailHref}>{siteContact.email}</a>
          <a href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp us on BtechWaleTech">
            <WhatsAppIcon />
            <span>{siteContact.whatsappLabel}</span>
          </a>
        </div>
      </div>

      <nav class="footer-columns" aria-label="Footer navigation">
        {columns.map((col) => (
          <div class="footer-col">
            <p class="footer-col-title">{col.title}</p>
            <ul>
              {col.links.map(([label, href]) => (
                <li><a href={href}>{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <!-- Countries row -->
    <nav class="footer-states" aria-label="IT services by country">
      <p class="footer-col-title">IT services across countries</p>
      <ul>
        {countries.map(([name, href]) => (
          <li><a href={href}>{name}</a></li>
        ))}
      </ul>
    </nav>

    <!-- States row -->
    <nav class="footer-states" aria-label="IT services by state">
      <p class="footer-col-title">IT services across India</p>
      <ul>
        {itServicesRegions.map((region) => (
          <li><a href={regionPath(region)}>{region.name}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} {siteBrand.name}. India's professional IT services freelancing group.</p>
      <p class="footer-made">Made in India &middot; Serving worldwide</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    background: var(--bw-ink);
    color: #A8ACB4;
    font-family: var(--font-display);
    border-top: var(--bw-bd);
  }

  .footer-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(2.25rem, 4vw, 3.25rem) clamp(1rem, 4vw, 3.25rem) 1.25rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(14rem, 0.95fr) 2.3fr;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* ---------- brand ---------- */
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.85rem;
    text-decoration: none;
  }

  .footer-brand :global(img) {
    display: block;
    width: 1.7rem;
    height: auto;
    padding: 0.3rem;
    background: var(--bw-amber);
    border: var(--bw-bd);
    border-radius: var(--bw-r-sm);
    box-sizing: content-box;
  }

  .footer-brand-wordmark {
    color: #FFFFFF;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .footer-blurb {
    margin: 0 0 0.85rem;
    max-width: 23rem;
    font-size: 0.83rem;
    font-weight: 400;
    line-height: 1.6;
    color: #A8ACB4;
  }

  .footer-trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.1rem;
  }

  .trust-badge {
    padding: 0.26rem 0.6rem;
    border: 1.5px solid rgba(255, 255, 255, 0.26);
    border-radius: 999px;
    color: #D6D9DE;
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ---------- link columns ---------- */
  .footer-columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }

  .footer-col-title {
    margin: 0 0 0.6rem;
    color: var(--bw-amber);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .footer-col ul,
  .footer-states ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-col li { margin-bottom: 0.28rem; }

  .footer-col a {
    color: #A8ACB4;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.45;
    text-decoration: none;
    transition: color 180ms ease;
  }
  .footer-col a:hover { color: #FFFFFF; }

  /* ---------- region chip rows ---------- */
  .footer-states {
    padding: clamp(1rem, 2.2vw, 1.4rem) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer-states ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .footer-states a {
    display: inline-block;
    padding: 0.28rem 0.62rem;
    border: 1.5px solid rgba(255, 255, 255, 0.17);
    border-radius: 999px;
    color: #9DA1A9;
    font-size: 0.73rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
  }
  .footer-states a:hover {
    color: var(--bw-ink);
    background: var(--bw-amber);
    border-color: var(--bw-amber);
  }

  /* ---------- contact (inside the brand column) ---------- */
  .footer-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .footer-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 2px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    color: #FFFFFF;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 220ms var(--bw-ease), background 220ms ease, color 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }
  .footer-contact a:hover {
    background: var(--bw-amber);
    border-color: var(--bw-amber);
    color: var(--bw-ink);
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 rgba(255, 255, 255, 0.22);
  }
  .footer-contact :global(svg) { width: 0.95rem; height: 0.95rem; }

  /* ---------- bottom ---------- */
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding-top: 1.1rem;
  }

  .footer-bottom p {
    margin: 0;
    color: #7E828A;
    font-size: 0.74rem;
    font-weight: 500;
  }

  .footer-made { letter-spacing: 0.04em; }

  @media (max-width: 1000px) {
    .footer-top { grid-template-columns: 1fr; }
  }

  /* Two columns all the way down: one tall list per screen wastes the width. */
  @media (max-width: 620px) {
    .footer-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.1rem 1rem; }
    .footer-col a { font-size: 0.78rem; }
    .footer-contact a { flex: 1; justify-content: center; }
    .footer-bottom { flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-contact a, .footer-states a, .footer-col a { transition-duration: 1ms; }
  }
</style>
