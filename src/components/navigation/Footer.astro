---
import { Image } from "astro:assets";
import WhatsAppIcon from "@components/common/WhatsAppIcon.astro";
import { siteBrand, siteContact } from "@data/site/site-config";
import { itServicesRegions, regionPath } from "@data/it-services/locations";
import logo from "../../assets/images/mainlogo.png";

const columns = [
  {
    title: "Services",
    links: [
      ["Web development", "/services/web-development/"],
      ["SEO services", "/services/seo-services/"],
      ["IT services", "/it-services/"],
      ["All services", "/services/"],
      ["Industries", "/industries/"],
    ],
  },
  {
    title: "Locations",
    links: [
      ["Delhi", "/india/delhi/"],
      ["Mumbai", "/it-services/maharashtra/mumbai/"],
      ["Hyderabad", "/it-services/telangana/hyderabad/"],
      ["Bangalore", "/india/karnataka/bangalore/"],
      ["Gurugram", "/it-services/haryana/gurugram/"],
      ["All India locations", "/it-services/"],
    ],
  },
  {
    title: "Company",
    links: [
      ["About", "/about/"],
      ["Portfolio", "/portfolio/"],
      ["Case studies", "/case-studies/"],
      ["Pricing", "/pricing/"],
      ["Contact", "/contact/"],
    ],
  },
  {
    title: "Legal",
    links: [
      ["Privacy policy", "/privacy-policy/"],
      ["Terms of service", "/terms/"],
      ["Refund policy", "/refund-policy/"],
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <!-- Top: brand + nav columns -->
    <div class="footer-top">
      <div class="footer-brand-col">
        <a class="footer-brand" href="/" aria-label={`${siteBrand.name} home`}>
          <Image src={logo} alt="" height={96} densities={[1, 2]} />
          <span class="footer-brand-wordmark">BtechWaleTech</span>
        </a>
        <p class="footer-blurb">
          Freelance IT services for websites, software, SEO, AI automation, and data workflows — built in India, delivered worldwide.
        </p>
        <div class="footer-trust-row">
          <span class="trust-badge">Engineering Ethics</span>
          <span class="trust-badge">IP Ownership</span>
          <span class="trust-badge">India-First</span>
        </div>
      </div>

      <nav class="footer-columns" aria-label="Footer navigation">
        {columns.map((col) => (
          <div class="footer-col">
            <p class="footer-col-title">{col.title}</p>
            <ul>
              {col.links.map(([label, href]) => (
                <li><a href={href}>{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <!-- States row -->
    <nav class="footer-states" aria-label="IT services by state">
      <p class="footer-col-title">IT services across India</p>
      <ul>
        {itServicesRegions.map((region) => (
          <li><a href={regionPath(region)}>{region.name}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Contact row -->
    <div class="footer-contact" aria-label="Contact details">
      <a href={siteContact.emailHref}>{siteContact.email}</a>
      <a href={siteContact.phoneHref}>{siteContact.phone}</a>
      <a href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp us on BtechWaleTech">
        <WhatsAppIcon />
        <span>{siteContact.whatsappLabel}</span>
      </a>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} {siteBrand.name}. India-First Professional IT Excellence.</p>
      <p class="footer-made">Made in India &middot; Serving worldwide</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    color: #8fa0ad;
    background: #0F172A;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(3.5rem, 7vw, 5.5rem) clamp(1.25rem, 5vw, 5rem) 2.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(16rem, 1.1fr) 2fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    margin-bottom: 1.4rem;
  }

  .footer-brand img {
    display: block;
    width: auto;
    height: 2.75rem;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .footer-brand-wordmark {
    color: #F8F9FA;
    font-family: 'Libre Caslon Text', Georgia, serif;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }

  .footer-blurb {
    max-width: 22rem;
    margin: 0 0 1.5rem;
    font-size: 0.9rem;
    line-height: 1.75;
    color: #64748B;
  }

  .footer-trust-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .trust-badge {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 2px;
    color: #D4AF37;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .footer-col-title {
    margin: 0 0 1.1rem;
    color: #F8F9FA;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-col ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-col a {
    color: #64748B;
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 300ms ease;
  }

  .footer-col a:hover,
  .footer-col a:focus-visible {
    color: #D4AF37;
  }

  .footer-states {
    padding: 2rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .footer-states ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-states a {
    color: #64748B;
    font-size: 0.85rem;
    text-decoration: none;
    transition: color 300ms ease;
  }

  .footer-states a:hover,
  .footer-states a:focus-visible {
    color: #D4AF37;
  }

  .footer-contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.875rem;
  }

  .footer-contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #94a3b8;
    text-decoration: none;
    transition: color 300ms ease;
  }

  .footer-contact a:hover,
  .footer-contact a:focus-visible {
    color: #D4AF37;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.75rem;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  .footer-bottom p {
    margin: 0;
    color: #475569;
  }

  .footer-made {
    color: #475569;
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
    }

    .footer-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .footer-columns {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
