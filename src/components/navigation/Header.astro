---
import { Image } from "astro:assets";
import { primaryNavigation, siteBrand } from "@data/site/site-config";
import logo from "../../assets/images/mainlogo.png";
---

<header class="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label={`${siteBrand.name} home`}>
      <Image src={logo} alt={siteBrand.name} height={88} densities={[1, 2]} loading="eager" />
      <span class="brand-wordmark">BtechWaleTech</span>
    </a>

    <ul class="nav-links">
      {primaryNavigation.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
    </button>
  </nav>
</header>

<div class="mobile-menu" id="mobile-menu">
  <ul>
    {primaryNavigation.map((item, i) => (
      <li style={`--i: ${i}`}><a href={item.href}>{item.label}</a></li>
    ))}
  </ul>
  <a class="nav-cta mobile-cta" href="/contact/" style={`--i: ${primaryNavigation.length}`}>
    <span>Start a project</span>
    <span class="nav-cta-arrow" aria-hidden="true">&rarr;</span>
  </a>
</div>

<script>
  const header = document.querySelector(".site-header");
  const toggle = document.querySelector(".nav-toggle");

  if (header) {
    const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.classList.toggle("menu-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      document.documentElement.classList.toggle("nav-lock", open);
    };

    toggle.addEventListener("click", () => {
      setOpen(!header.classList.contains("menu-open"));
    });

    document.querySelectorAll(".mobile-menu a").forEach((a) => {
      a.addEventListener("click", () => setOpen(false));
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });

    matchMedia("(min-width: 821px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  :global(html.nav-lock) {
    overflow: hidden;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid transparent;
    background: transparent;
    transition:
      background-color 450ms cubic-bezier(0.32, 0.72, 0, 1),
      border-color 450ms cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 450ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .site-header.scrolled,
  .site-header.menu-open {
    border-bottom-color: rgba(15, 23, 42, 0.08);
    background: rgba(255, 255, 255, 0.72);
    box-shadow: 0 12px 40px rgba(15, 23, 42, 0.06);
    backdrop-filter: blur(20px) saturate(180%);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 1240px;
    height: 4.5rem;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3rem);
  }

  .brand,
  .nav-cta,
  .site-nav a,
  .mobile-menu a {
    text-decoration: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
  }

  .brand img {
    display: block;
    width: auto;
    height: 2.6rem;
  }

  .brand-wordmark {
    color: #12313b;
    font-size: clamp(1rem, 1.8vw, 1.22rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex: 1;
    gap: clamp(0.9rem, 2.4vw, 2.2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    color: #4a5560;
    font-size: 0.93rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    white-space: nowrap;
    transition: color 350ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .nav-links a::after {
    position: absolute;
    right: 0;
    bottom: 0.45rem;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: #0f766e;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 450ms cubic-bezier(0.32, 0.72, 0, 1);
    content: "";
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: #0f172a;
  }

  .nav-links a:hover::after,
  .nav-links a:focus-visible::after {
    transform: scaleX(1);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.7rem;
    padding: 0 1.15rem;
    border-radius: 0.7rem;
    color: #ffffff;
    background: #0f172a;
    font-size: 0.93rem;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 10px 26px rgba(15, 23, 42, 0.18);
    transition:
      background-color 450ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 450ms cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 450ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .nav-cta-arrow {
    transition: transform 450ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .nav-cta:hover,
  .nav-cta:focus-visible {
    background: #0f766e;
    box-shadow: 0 14px 32px rgba(15, 118, 110, 0.28);
  }

  .nav-cta:hover .nav-cta-arrow,
  .nav-cta:focus-visible .nav-cta-arrow {
    transform: translateX(3px);
  }

  .nav-cta:active {
    transform: scale(0.97);
  }

  /* ---------- hamburger ---------- */
  .nav-toggle {
    display: none;
    position: relative;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 0.7rem;
    background: transparent;
    cursor: pointer;
  }

  .toggle-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1.15rem;
    height: 2px;
    border-radius: 2px;
    background: #0f172a;
    transition: transform 450ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .toggle-bar:nth-child(1) {
    transform: translate(-50%, calc(-50% - 3.5px));
  }

  .toggle-bar:nth-child(2) {
    transform: translate(-50%, calc(-50% + 3.5px));
  }

  .menu-open .toggle-bar:nth-child(1) {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  .menu-open .toggle-bar:nth-child(2) {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* ---------- mobile menu ---------- */
  .mobile-menu {
    display: none;
    position: fixed;
    top: 3.9rem;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 39;
    flex-direction: column;
    padding: 1.5rem clamp(1rem, 5vw, 2rem) 2.5rem;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(28px) saturate(180%);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 450ms cubic-bezier(0.32, 0.72, 0, 1),
      visibility 450ms;
    overflow-y: auto;
  }

  .menu-open + .mobile-menu {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu ul {
    display: grid;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .mobile-menu li a {
    display: flex;
    align-items: center;
    min-height: 3.6rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    color: #0f172a;
    font-family: "Bricolage Grotesque", ui-sans-serif, system-ui, sans-serif;
    font-size: 1.45rem;
    font-weight: 620;
    letter-spacing: -0.015em;
  }

  .mobile-menu li,
  .mobile-cta {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 550ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 550ms cubic-bezier(0.32, 0.72, 0, 1);
    transition-delay: 0ms;
  }

  .menu-open + .mobile-menu li,
  .menu-open + .mobile-menu .mobile-cta {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(60ms * var(--i, 0) + 80ms);
  }

  .mobile-cta {
    justify-content: center;
    min-height: 3.4rem;
    font-size: 1.02rem;
  }

  /* ---------- breakpoints ---------- */
  @media (max-width: 820px) {
    .site-nav {
      height: 3.9rem;
      gap: 0.8rem;
    }

    .brand img {
      height: 2.2rem;
    }

    .brand-wordmark {
      font-size: 1rem;
    }

    .nav-links,
    .desktop-cta {
      display: none;
    }

    .nav-toggle {
      display: block;
    }

    .mobile-menu {
      display: flex;
    }
  }

  @media (max-width: 360px) {
    .brand img {
      height: 1.9rem;
    }

    .brand-wordmark {
      font-size: 0.9rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header.scrolled,
    .site-header.menu-open {
      background: #ffffff;
      backdrop-filter: none;
    }

    .mobile-menu {
      background: #ffffff;
      backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .nav-links a,
    .nav-links a::after,
    .nav-cta,
    .nav-cta-arrow,
    .toggle-bar,
    .mobile-menu,
    .mobile-menu li,
    .mobile-cta {
      transition-duration: 1ms;
    }
  }
</style>
