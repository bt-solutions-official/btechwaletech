---
import { Image } from "astro:assets";
import { primaryNavigation, siteBrand, siteContact } from "@data/site/site-config";
import logo from "../../assets/images/mainlogo.png";
---

<!-- Announcement strip: the single strongest offer, above everything else. -->
<div class="topbar">
  <div class="topbar-inner">
    <p class="topbar-offer">
      <span class="topbar-dot" aria-hidden="true"></span>
      <span class="tb-a">Websites from <strong>₹10,000 (US$150)</strong></span>
      <span class="tb-sep" aria-hidden="true">&middot;</span>
      <span class="tb-b"><strong>2 months</strong> maintenance free after launch</span>
    </p>
    <p class="topbar-contact">
      <a href={siteContact.phoneHref}>{siteContact.phone}</a>
      <span class="topbar-sep" aria-hidden="true">&middot;</span>
      <a href={siteContact.emailHref}>{siteContact.email}</a>
    </p>
  </div>
</div>

<header class="site-header" id="site-header">
  <nav class="site-nav" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label={`${siteBrand.name} home`}>
      <span class="brand-badge">
        <Image src={logo} alt="" height={72} densities={[1, 2]} loading="eager" />
      </span>
      <span class="brand-wordmark">BtechWale<span>Tech</span></span>
    </a>

    <ul class="nav-links">
      {primaryNavigation.slice(0, -1).map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>

    <a class="nav-cta desktop-cta" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
      <span>Get a quote</span>
      <span class="nav-cta-arrow" aria-hidden="true">&rarr;</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
      <span class="toggle-bar"></span>
    </button>
  </nav>
</header>

<div class="mobile-menu" id="mobile-menu">
  <ul>
    {primaryNavigation.map((item, i) => (
      <li style={`--i: ${i}`}><a href={item.href}>{item.label}</a></li>
    ))}
  </ul>
  <a class="nav-cta mobile-cta" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer" style={`--i: ${primaryNavigation.length}`}>
    <span>WhatsApp us</span>
    <span class="nav-cta-arrow" aria-hidden="true">&rarr;</span>
  </a>
</div>

<script>
  const header = document.querySelector(".site-header");
  const toggle = document.querySelector(".nav-toggle");

  if (header) {
    const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.classList.toggle("menu-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      document.documentElement.classList.toggle("nav-lock", open);
    };

    toggle.addEventListener("click", () => {
      setOpen(!header.classList.contains("menu-open"));
    });

    document.querySelectorAll(".mobile-menu a").forEach((a) => {
      a.addEventListener("click", () => setOpen(false));
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape") setOpen(false);
    });

    matchMedia("(min-width: 901px)").addEventListener("change", (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  :global(html.nav-lock) { overflow: hidden; }

  /* ---------- announcement strip ---------- */
  .topbar {
    background: var(--bw-amber);
    border-bottom: var(--bw-bd);
    color: var(--bw-ink);
    font-family: var(--font-display);
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0.55rem clamp(1rem, 4vw, 3.25rem);
  }

  .topbar p { margin: 0; }

  .topbar-offer {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
  }
  .topbar-offer strong { font-weight: 800; }

  .topbar-dot {
    width: 7px; height: 7px;
    flex: none;
    border-radius: 50%;
    background: var(--bw-ink);
    animation: tb-blink 2.4s ease-in-out infinite;
  }

  @keyframes tb-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.25; }
  }

  .topbar-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .topbar-contact a {
    color: var(--bw-ink);
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
  }
  .topbar-contact a:hover { border-bottom-color: var(--bw-ink); }

  /* ---------- nav bar ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bw-paper);
    border-bottom: var(--bw-bd);
    transition: box-shadow 300ms var(--bw-ease);
  }
  .site-header.scrolled { box-shadow: 0 5px 0 rgba(18, 19, 22, 0.08); }

  .site-header.menu-open {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    max-width: 1320px;
    height: 4.5rem;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 3.25rem);
  }

  /* ---------- brand ---------- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    flex: none;
  }

  .brand-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.45rem;
    height: 2.45rem;
    overflow: hidden;
    background: var(--bw-amber);
    border: var(--bw-bd);
    border-radius: var(--bw-r-sm);
    box-shadow: var(--bw-sh-sm);
    transition: transform 280ms var(--bw-ease), box-shadow 280ms var(--bw-ease);
  }
  .brand-badge :global(img) {
    width: 1.95rem;
    height: auto;
    display: block;
  }
  .brand:hover .brand-badge { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--bw-ink); }

  .brand-wordmark {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--bw-ink);
  }
  .brand-wordmark span { color: var(--bw-ink-mute); }

  /* ---------- links ---------- */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    display: inline-block;
    padding: 0.5rem 0.8rem;
    border: 2px solid transparent;
    border-radius: 999px;
    color: var(--bw-ink-soft);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 200ms ease, background 200ms ease, border-color 200ms ease;
  }
  .nav-links a:hover {
    color: var(--bw-ink);
    background: var(--bw-butter);
    border-color: var(--bw-ink);
  }

  /* ---------- CTA ---------- */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: none;
    padding: 0.6rem 1.15rem;
    background: var(--bw-amber);
    border: var(--bw-bd);
    border-radius: 999px;
    box-shadow: var(--bw-sh-sm);
    color: var(--bw-ink);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 240ms var(--bw-ease), box-shadow 240ms var(--bw-ease), background 240ms ease;
  }
  .nav-cta:hover { transform: translate(-1px, -1px); box-shadow: 5px 5px 0 var(--bw-ink); background: var(--bw-amber-deep); }
  .nav-cta:active { transform: translate(2px, 2px); box-shadow: 0 0 0 var(--bw-ink); }
  .nav-cta-arrow { transition: transform 300ms var(--bw-ease); }
  .nav-cta:hover .nav-cta-arrow { transform: translateX(3px); }

  /* ---------- hamburger ---------- */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0 0.6rem;
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: var(--bw-r-sm);
    box-shadow: var(--bw-sh-sm);
    cursor: pointer;
  }

  .toggle-bar {
    display: block;
    height: 2px;
    background: var(--bw-ink);
    transition: transform 280ms var(--bw-ease), opacity 200ms ease;
  }
  .site-header.menu-open .toggle-bar:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .site-header.menu-open .toggle-bar:nth-child(2) { opacity: 0; }
  .site-header.menu-open .toggle-bar:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* ---------- mobile menu ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 39;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    padding: 6rem clamp(1.25rem, 6vw, 2.5rem) 3rem;
    background: var(--bw-paper);
    opacity: 0;
    visibility: hidden;
    transition: opacity 320ms var(--bw-ease), visibility 320ms;
  }
  :global(.site-header.menu-open) ~ .mobile-menu { opacity: 1; visibility: visible; }

  .mobile-menu ul {
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .mobile-menu li {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 360ms var(--bw-ease), transform 360ms var(--bw-ease);
  }
  :global(.site-header.menu-open) ~ .mobile-menu li { opacity: 1; transform: none; transition-delay: calc(45ms * var(--i, 0) + 80ms); }

  .mobile-menu a {
    display: block;
    padding: 0.9rem 1.1rem;
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: var(--bw-r);
    box-shadow: var(--bw-sh-sm);
    color: var(--bw-ink);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    text-decoration: none;
  }
  .mobile-menu a:active { transform: translate(2px, 2px); box-shadow: 0 0 0 var(--bw-ink); }

  .mobile-cta {
    justify-content: center;
    width: 100%;
    padding: 1rem;
    font-size: 1rem;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 360ms var(--bw-ease), transform 360ms var(--bw-ease);
  }
  :global(.site-header.menu-open) ~ .mobile-menu .mobile-cta { opacity: 1; transform: none; transition-delay: calc(45ms * var(--i, 0) + 80ms); }

  /* ---------- breakpoints ---------- */
  @media (max-width: 1080px) {
    .nav-links a { padding: 0.5rem 0.6rem; font-size: 0.83rem; }
  }

  @media (max-width: 900px) {
    .nav-links, .desktop-cta { display: none; }
    .nav-toggle { display: flex; }
    .site-nav { height: 4rem; }
  }

  .topbar-offer .tb-a, .topbar-offer .tb-b { white-space: nowrap; }

  /* One line, always: a wrapped two-line strip reads like a layout bug. */
  @media (max-width: 860px) {
    .topbar-contact { display: none; }
    .topbar-inner { justify-content: center; }
  }

  @media (max-width: 640px) {
    .topbar-offer .tb-b, .topbar-offer .tb-sep { display: none; }
    .topbar-offer { font-size: 0.73rem; }
    .topbar-inner { padding-top: 0.45rem; padding-bottom: 0.45rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .topbar-dot { animation: none; }
    .nav-cta, .brand-badge, .toggle-bar, .mobile-menu, .mobile-menu li, .mobile-cta { transition-duration: 1ms; }
  }
</style>
