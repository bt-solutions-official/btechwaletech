---
interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  title: string;
  links?: LinkItem[];
}

const { title, links = [] } = Astro.props;
---

{links.length > 0 && (
  <section aria-labelledby={`${title.toLowerCase().replaceAll(" ", "-")}-links`}>
    <h2 id={`${title.toLowerCase().replaceAll(" ", "-")}-links`}>{title}</h2>
    <ul>
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </section>
)}
