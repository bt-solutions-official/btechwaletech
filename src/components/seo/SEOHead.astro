---
import { canonicalUrl } from "@lib/urls/url-utils";
import { applyTitleTemplate, normalizeSeoMeta } from "@lib/seo/seo-config";
import { siteBrand, siteDefaults } from "@data/site/site-config";
import type { SeoMeta } from "@app-types/seo";

interface Props {
  meta: SeoMeta;
}

const { meta: rawMeta } = Astro.props;
const meta = normalizeSeoMeta(rawMeta);
const title = applyTitleTemplate(meta.title);
const canonical = canonicalUrl(meta.canonicalPath);
const ogImage = meta.ogImage?.url ?? siteDefaults.defaultOgImage;
const ogImageUrl = new URL(ogImage, siteBrand.domain).toString();

// Indexable pages opt into the largest SERP treatment Google offers: large image
// thumbnails (worth a lot on mobile, which is 49% of impressions here) and untruncated
// snippets. Without these Google defaults to a small thumbnail and a short snippet.
// Pages carrying noindex get the bare directive - preview limits are meaningless there.
const robots = meta.robots?.startsWith("noindex")
  ? meta.robots
  : `${meta.robots}, max-image-preview:large, max-snippet:-1, max-video-preview:-1`;

// No <meta name="keywords"> is emitted. Google has ignored it since 2009 and Bing treats a
// stuffed list as a spam signal, so the 700-1,500 characters it added to each of 2,720
// pages (~2.4MB of markup per full crawl) bought nothing. The `keywords` arrays stay in the
// page data as authoring notes for whoever writes the next page; they just are not shipped.
---

<title>{title}</title>
<meta name="description" content={meta.description} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />
<meta name="google-site-verification" content="ciu5Cf7pmyMCp6i8G-E13RT6lxiF68UtlNnPJBIi_zU" />
<meta name="google-adsense-account" content="ca-pub-4227329033349842" />
<link rel="canonical" href={canonical} />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta property="og:site_name" content={siteBrand.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={meta.description} />
<meta property="og:type" content={meta.ogType} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
{meta.ogImage?.alt && <meta property="og:image:alt" content={meta.ogImage.alt} />}
{meta.ogImage?.width && <meta property="og:image:width" content={String(meta.ogImage.width)} />}
{meta.ogImage?.height && <meta property="og:image:height" content={String(meta.ogImage.height)} />}
<meta property="og:locale" content={meta.locale} />
{meta.alternateLocales?.map((locale) => <meta property="og:locale:alternate" content={locale} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={meta.description} />
<meta name="twitter:image" content={ogImageUrl} />
{meta.ogImage?.alt && <meta name="twitter:image:alt" content={meta.ogImage.alt} />}
