---
// Shared layout for the freelance landing pages: /freelancers/, /freelancing/, /{keyword}/ and /{country}/{service}/.
// Sections and styles mirror the country pages (src/pages/usa/index.astro).
import BaseLayout from "@layouts/BaseLayout.astro";
import { createPageSeo } from "@lib/seo/seo-config";
import { createBreadcrumbs } from "@lib/breadcrumbs/breadcrumbs";
import { breadcrumbListSchema, faqSchema } from "@lib/schema/schema";
import { canonicalUrl } from "@lib/urls/url-utils";
import { siteBrand, siteContact, teamSocialProfiles } from "@data/site/site-config";
import { pricingPlans, pricingNote, usdPrice } from "@data/pricing/plans";
import { countryOgImage, priceRows, regions, usd } from "@data/countries/international";
import type { FreelanceContent } from "@data/freelance/types";
import type { Market } from "@data/keywords/markets";

interface Props {
  content: FreelanceContent;
  /** Set on /{country}/{service}/ pages: the one country the page is written for (USD prices, its locale and areaServed). */
  market?: Market;
}

const { content: c, market } = Astro.props;
const url = canonicalUrl(c.path);

const page = createPageSeo({
  title: c.meta.title,
  description: c.meta.description,
  canonicalPath: c.path,
  h1: c.hero.h1,
  keywords: c.meta.keywords,
  breadcrumbs: createBreadcrumbs(market
    ? [{ label: "Countries", href: "/countries/" }, { label: market.name, href: `/${market.slug}/` }, { label: c.crumb, href: c.path }]
    : [{ label: c.crumb, href: c.path }]),
  locale: market?.locale,
  ogImage: countryOgImage(`${siteBrand.name}: IT freelancers in India building websites, apps, SEO and AI automation for clients worldwide`),
});

const toc = [
  ...c.guide.map((g) => ({ id: g.id, heading: g.heading })),
  ...c.tables.map((t) => ({ id: t.id, heading: t.heading })),
  { id: "areas-heading", heading: c.areas.heading },
  { id: "faq-heading", heading: "FAQs" },
];

const team = [
  { name: "Ankur Kumar", jobTitle: "Full stack developer" },
  { name: "Santosh Sharma", jobTitle: "AI, machine learning, AWS, data science and technical SEO" },
  { name: "Vedansh Shrivastava", jobTitle: "Project management, data science, AI and automation" },
].map((p, i) => ({ "@type": "Person", ...p, sameAs: teamSocialProfiles[i] }));

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${url}#service`,
  name: `${siteBrand.name}: ${c.crumb}`,
  description: c.meta.description,
  url,
  image: new URL("/banner_logo.png", siteBrand.domain).toString(),
  email: siteContact.email,
  telephone: siteContact.phone,
  priceRange: market ? `${usd("Maintenance")} - ${usd("Custom web app")}+` : "₹8,000 - ₹60,000+",
  currenciesAccepted: market ? "USD" : "INR, USD",
  paymentAccepted: "UPI, Bank transfer, Wise, PayPal",
  address: { "@type": "PostalAddress", addressCountry: "IN" },
  knowsLanguage: ["en", "hi"],
  employee: team,
  areaServed: market ? [{ "@type": "Country", name: market.name }] : [
    { "@type": "Country", name: "India" },
    ...["United States", "United Kingdom", "Canada", "Australia", "New Zealand", "United Arab Emirates", "Saudi Arabia", "Singapore", "Japan", "Germany", "Netherlands"]
      .map((name) => ({ "@type": "Country", name })),
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: `${c.crumb}: starting prices`,
    itemListElement: pricingPlans.map((plan) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: plan.name, description: plan.summary },
      priceSpecification: {
        "@type": "PriceSpecification",
        minPrice: Number((market ? usdPrice(plan.price) : plan.price).replace(/[^\d]/g, "")),
        priceCurrency: market ? "USD" : "INR",
        ...(plan.unit ? { unitText: plan.unit } : {}),
      },
    })),
  },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${url}#webpage`,
  url,
  name: page.title,
  description: page.description,
  inLanguage: market?.lang ?? "en-IN",
  dateModified: c.updated,
  about: { "@id": `${url}#service` },
  speakable: { "@type": "SpeakableSpecification", cssSelector: ["#quick-answer", "h1"] },
};
---

<BaseLayout meta={page} schema={[webPageSchema, serviceSchema, breadcrumbListSchema(page.breadcrumbs), faqSchema(c.faqs)]}>

  <!-- ===================== HERO ===================== -->
  <section class="hero" aria-labelledby="page-heading">
    <div class="hero-inner">
      <div class="hero-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {page.breadcrumbs.map((b, i) => (
              <li>{i + 1 === page.breadcrumbs.length ? <span aria-current="page">{b.label}</span> : <a href={b.href}>{b.label}</a>}</li>
            ))}
          </ol>
        </nav>
        <p class="eyebrow">{c.hero.eyebrow}</p>
        <h1 id="page-heading">{c.hero.h1}</h1>
        <p class="lede" set:html={c.hero.lede} />
        <ul class="facts" aria-label="Quick facts">
          {c.facts.map(([label, value]) => <li><strong>{label}</strong><span>{value}</span></li>)}
        </ul>
        <div class="hero-actions">
          <a class="btn-primary" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp for a free quote</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-ghost" href={siteContact.phoneHref}>Call {siteContact.phone}</a>
        </div>
        <ul class="hero-pills" aria-label="What we do">
          {c.hero.pills.map((p) => <li>{p}</li>)}
        </ul>
        <p class="hero-origin">
          <span class="origin-dot" aria-hidden="true"></span>
          {c.hero.origin}
        </p>
      </div>

      <aside class="quote-card" aria-label="Starting prices">
        <p class="quote-kicker">{market ? `Starting prices for ${market.name}` : "Starting prices · India & worldwide"}</p>
        <ul class="quote-rows">
          {pricingPlans.slice(0, 5).map((plan) => (
            <li><span>{plan.name}</span><strong><small>from </small>{market ? usdPrice(plan.price) : <>{plan.price} <small>/ {usdPrice(plan.price)}</small></>}</strong></li>
          ))}
        </ul>
        <p class="quote-foot">{market ? "Quoted in US dollars." : "INR for India, USD for international clients."} 5 months maintenance free after launch. Itemised quote in 2 working days.</p>
        <a class="btn-primary btn-block" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
          <span>Get my quote on WhatsApp</span><span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </aside>
    </div>
  </section>

  <!-- ===================== STATS ===================== -->
  <section class="stats-section" aria-label={`${siteBrand.name} in numbers`}>
    <div class="section-wrap">
      <ul class="stat-band">
        {c.stats.map((s) => (
          <li><span class="stat-num">{s.value}</span><span class="stat-label">{s.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== QUICK ANSWER + SNAPSHOT ===================== -->
  <section class="answer" aria-labelledby="answer-heading">
    <div class="section-wrap answer-grid">
      <div>
        <p class="eyebrow">The short answer</p>
        <h2 id="answer-heading">{c.answer.heading}</h2>
        <p id="quick-answer" class="answer-text">{c.answer.text}</p>
        <p class="answer-more" set:html={c.answer.more} />
        <p class="updated">Last updated <time datetime={c.updated}>{new Date(c.updated).toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" })}</time></p>
      </div>
      <table class="snapshot">
        <caption>{c.snapshot.caption}</caption>
        <tbody>
          {c.snapshot.rows.map((row) => (
            <tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="services" aria-labelledby="services-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">{c.services.eyebrow}</p>
        <h2 id="services-heading">{c.services.heading}</h2>
        <p class="section-note">{c.services.note}</p>
      </div>
      <div class="bento">
        {c.services.cards.map((s) => {
          const inner = (
            <div class="card-core">
              <h3>{s.name}</h3>
              <p>{s.note}</p>
              {s.href && <span class="card-arrow" aria-hidden="true">&rarr;</span>}
            </div>
          );
          return s.href ? <a class={`card card-${s.size}`} href={s.href}>{inner}</a> : <div class={`card card-${s.size}`}>{inner}</div>;
        })}
      </div>
    </div>
  </section>

  <!-- ===================== WHY US ===================== -->
  <section class="advantage" aria-labelledby="why-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Why choose us</p>
        <h2 id="why-heading">{c.comparison.heading}</h2>
        <p class="section-note">{c.comparison.note}</p>
      </div>
      <div class="comparison-table-wrap">
        <table class="comparison-table">
          <caption class="sr-only">{c.comparison.heading}</caption>
          <thead>
            <tr>
              <th scope="col">{c.comparison.columns[0]}</th>
              <th scope="col" class="col-other">{c.comparison.columns[1]}</th>
              <th scope="col" class="col-other hide-sm">{c.comparison.columns[2]}</th>
              <th scope="col" class="col-us">{c.comparison.columns[3]}</th>
            </tr>
          </thead>
          <tbody>
            {c.comparison.rows.map(([aspect, a, b, us]) => (
              <tr>
                <th scope="row" class="td-aspect">{aspect}</th>
                <td class="col-other">{a}</td>
                <td class="col-other hide-sm">{b}</td>
                <td class="td-us"><span class="td-us-inner"><span class="td-check" aria-hidden="true">✓</span>{us}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine">{c.comparison.fine}</p>
    </div>
  </section>

  <!-- ===================== PRICING ===================== -->
  <section class="pricing" aria-labelledby="pricing-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Pricing</p>
        <h2 id="pricing-heading">{c.pricing.heading}</h2>
        <p class="section-note">{c.pricing.note}</p>
      </div>
      <div class="comparison-table-wrap">
        <table class="price-table">
          <caption class="sr-only">Starting prices in INR and USD</caption>
          <thead>
            <tr><th scope="col">Service</th><th scope="col">India (INR)</th><th scope="col">Worldwide (USD)</th><th scope="col">Typical timeline</th><th scope="col" class="hide-sm">What is included</th></tr>
          </thead>
          <tbody>
            {priceRows.map((r) => (
              <tr>
                <th scope="row">{r.service}</th>
                <td class="price"><small>from </small>{r.inr}</td>
                <td class="price"><small>from </small>{r.usd}</td>
                <td>{r.timeline}</td>
                <td class="hide-sm">{r.includes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine">{pricingNote} <a href="/pricing/">See full pricing</a>.</p>
    </div>
  </section>

  <!-- ===================== LONG-FORM GUIDE ===================== -->
  <section class="guide" aria-label={c.guideLabel}>
    <div class="section-wrap guide-grid">
      <nav class="toc" aria-label="On this page">
        <p class="toc-title">On this page</p>
        <ol>
          {toc.map((t) => <li><a href={`#${t.id}`}>{t.heading}</a></li>)}
        </ol>
      </nav>
      <div class="prose">
        {c.guide.map((g) => (
          <article aria-labelledby={g.id}>
            <h2 id={g.id}>{g.heading}</h2>
            {g.paragraphs.map((p) => <p set:html={p} />)}
            {g.list && <ul>{g.list.map((li) => <li set:html={li} />)}</ul>}
            {g.subs && g.subs.map((s) => (
              <div class="state-block">
                <h3>{s.heading}</h3>
                <p set:html={s.text} />
              </div>
            ))}
            {g.after && g.after.map((p) => <p set:html={p} />)}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== DATA TABLES ===================== -->
  {c.tables.map((t, n) => (
    <section class={n % 2 ? "pricing" : "industries"} aria-labelledby={t.id}>
      <div class="section-wrap">
        <div class="section-head">
          <p class="eyebrow">{t.eyebrow}</p>
          <h2 id={t.id}>{t.heading}</h2>
          <p class="section-note" set:html={t.note} />
        </div>
        <div class="comparison-table-wrap">
          <table class="price-table fit-sm">
            <caption class="sr-only">{t.heading}</caption>
            <thead>
              <tr>{t.columns.map((col, i) => <th scope="col" class={t.hideSm?.includes(i) ? "hide-sm" : undefined}>{col}</th>)}</tr>
            </thead>
            <tbody>
              {t.rows.map(([first, ...rest]) => (
                <tr>
                  <th scope="row" set:html={first} />
                  {rest.map((cell, i) => <td class={t.hideSm?.includes(i + 1) ? "hide-sm" : undefined} set:html={cell} />)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  ))}

  <!-- ===================== AREAS ===================== -->
  <section class="locations" aria-labelledby="areas-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">{c.areas.eyebrow}</p>
        <h2 id="areas-heading">{c.areas.heading}</h2>
        <p class="section-note">{c.areas.note}</p>
      </div>
      <ul class="area-grid">
        {c.areas.cards.map((a) => (
          <li><h3>{a.href ? <a href={a.href}>{a.name}</a> : a.name}</h3><p>{a.note}</p></li>
        ))}
      </ul>
      <div class="city-cloud region-cloud">
        {regions.map((r) => <a class="city-chip" href={r.href}>Freelance IT services in {r.country}</a>)}
      </div>
    </div>
  </section>

  <!-- ===================== PROCESS ===================== -->
  <section class="process" aria-labelledby="process-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="process-heading">{c.process.heading}</h2>
      </div>
      <ol class="steps steps-six">
        {c.process.steps.map(([step, detail], i) => (
          <li><span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span><h3>{step}</h3><p>{detail}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="faq" aria-labelledby="faq-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-heading">{c.faqHeading}</h2>
      </div>
      <div class="faq-list">
        {c.faqs.map((f) => (
          <details class="faq-item">
            <summary><span>{f.question}</span><span class="faq-mark" aria-hidden="true">+</span></summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== RELATED ===================== -->
  <section class="locations" aria-labelledby="related-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Keep reading</p>
        <h2 id="related-heading">{c.related.heading}</h2>
      </div>
      <div class="city-cloud">
        {c.related.links.map((l) => <a class="city-chip" href={l.href}>{l.name}</a>)}
      </div>
    </div>
  </section>

  <!-- ===================== CLOSING CTA ===================== -->
  <section class="closing" aria-labelledby="cta-heading">
    <div class="section-wrap">
      <div class="closing-inner">
        <p class="eyebrow">Next step</p>
        <h2 id="cta-heading">{c.cta.heading}</h2>
        <p class="closing-note">{c.cta.note}</p>
        <div class="hero-actions closing-actions">
          <a class="btn-primary" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp us</span><span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-ghost" href={siteContact.emailHref}>{siteContact.email}</a>
        </div>
        <p class="closing-links">
          <a href="/services/">All services</a> · <a href="/services/web-development/">Web development</a> · <a href="/services/seo-services/">SEO services</a> ·
          <a href="/it-services/android-ios-app/">Android &amp; iOS apps</a> · <a href="/pricing/">Pricing</a> · <a href="/portfolio/">Portfolio</a> ·
          <a href="/about/">About</a> · <a href="/countries/">Countries</a> · <a href="/india/">India</a> · <a href="/contact/">Contact</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Copied from src/pages/usa/index.astro so freelance pages match the country and city pages. */
  :root {
    --paper: #FDFCFB;
    --surface: #F8F9FA;
    --surface-low: #F3F4F5;
    --midnight: #0F172A;
    --slate: #334155;
    --slate-muted: #64748B;
    --gold: #D4AF37;
    --gold-muted: #C5A059;
    --hairline: rgba(15, 23, 42, 0.10);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --font: 'Hanken Grotesk', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  :global(body) { background: var(--paper); color: var(--midnight); }

  h1, h2, h3 { margin: 0; font-family: var(--font); color: var(--midnight); letter-spacing: -0.02em; font-weight: 700; }
  p { margin: 0; }
  section { scroll-margin-top: 5rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .section-wrap { max-width: 1280px; margin: 0 auto; padding: 0 clamp(1rem, 5vw, 5rem); }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 0.65rem; margin: 0 0 1.25rem;
    color: var(--gold-muted); font-family: var(--font); font-size: 0.75rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
  }
  .eyebrow::before { width: 1.75rem; height: 1px; background: var(--gold-muted); content: ""; flex-shrink: 0; }

  .section-head { max-width: 48rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .section-head h2 { font-size: clamp(1.75rem, 3.5vw, 2.6rem); line-height: 1.15; font-weight: 600; margin-bottom: 1rem; }
  .section-note { color: var(--slate); font-size: 1.05rem; line-height: 1.7; }
  .section-note a, .fine a { color: var(--midnight); text-decoration-color: var(--gold); text-underline-offset: 3px; }

  /* Buttons */
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }
  .btn-primary, .btn-ghost {
    display: inline-flex; align-items: center; gap: 0.6rem; min-height: 3.1rem; padding: 0 1.6rem;
    border-radius: 2px; font-family: var(--font); font-size: 0.9rem; font-weight: 600; text-decoration: none;
    transition: all 250ms var(--ease); max-width: 100%; overflow-wrap: anywhere;
  }
  .btn-primary { background: var(--midnight); color: var(--paper); border: 1px solid var(--midnight); }
  .btn-primary:hover { background: #1E293B; transform: translateY(-1px); }
  .btn-arrow { color: var(--gold); transition: transform 250ms var(--ease); }
  .btn-primary:hover .btn-arrow { transform: translateX(3px); }
  .btn-ghost { color: var(--midnight); border: 1px solid var(--hairline); background: transparent; }
  .btn-ghost:hover { border-color: var(--gold); }
  .btn-block { width: 100%; justify-content: center; }

  /* Hero */
  .hero { padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--hairline); }
  .hero-inner {
    max-width: 1280px; margin: 0 auto; padding: 0 clamp(1rem, 5vw, 5rem);
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr); gap: clamp(2rem, 4vw, 4rem); align-items: center;
  }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1.5rem; padding: 0; list-style: none; font-size: 0.8rem; color: var(--slate-muted); }
  .crumbs li + li::before { content: "/"; margin-right: 0.4rem; color: var(--hairline); }
  .crumbs a { color: var(--slate-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--midnight); }
  h1 {
    font-size: clamp(2.1rem, 4vw, 3.25rem); line-height: 1.12; margin-bottom: 1.25rem;
    max-width: 100%; overflow-wrap: anywhere; text-wrap: balance;
  }
  .lede { color: var(--slate); font-size: clamp(1rem, 1.3vw, 1.1rem); line-height: 1.7; max-width: 38rem; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: 0.6rem; max-width: 46rem; margin: 1.6rem 0 0; padding: 0; list-style: none; }
  .facts li { display: grid; gap: 0.2rem; padding: 0.75rem 0.95rem; border: 1px solid var(--hairline); border-radius: 4px; background: #fff; }
  .facts strong { color: var(--gold-muted); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  .facts span { color: var(--midnight); font-weight: 600; font-size: 0.92rem; line-height: 1.4; }
  .hero-pills { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.75rem 0 0; padding: 1.5rem 0 0; border-top: 1px solid var(--hairline); list-style: none; }
  .hero-pills li { padding: 0.35rem 0.8rem; border: 1px solid var(--hairline); border-radius: 2px; color: var(--slate); font-size: 0.8rem; font-weight: 500; }
  .hero-origin { display: flex; align-items: center; gap: 0.5rem; margin-top: 1.25rem; color: var(--slate-muted); font-size: 0.8rem; font-weight: 500; }
  .origin-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }

  .quote-card {
    padding: clamp(1.5rem, 3vw, 2.25rem); background: var(--midnight); color: #F8F9FA; border-radius: 4px;
    box-shadow: 0 24px 50px -20px rgba(15, 23, 42, 0.45);
  }
  .quote-kicker { color: var(--gold); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 1rem; }
  .quote-rows { margin: 0 0 1.25rem; padding: 0; list-style: none; }
