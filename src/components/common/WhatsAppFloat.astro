---
import { siteContact } from "@data/site/site-config";
---

<!-- Site-wide floating WhatsApp link: logo only, label slides out on hover, tap or keyboard focus. -->
<a class="wa-float" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp">
  <span class="wa-ring" aria-hidden="true"></span>
  <svg class="wa-logo" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
  </svg>
  <span class="wa-float-text" aria-hidden="true">WhatsApp us</span>
</a>

<style>
  /* z-index stays under the header (39/40) so the open mobile menu covers it. */
  .wa-float {
    --wa-ease: cubic-bezier(0.16, 1, 0.3, 1);
    position: fixed; right: max(1.25rem, env(safe-area-inset-right)); bottom: max(1.25rem, env(safe-area-inset-bottom)); z-index: 38;
    display: inline-flex; align-items: center; height: 3.6rem; padding: 0 0.95rem;
    border-radius: 999px; background: #25D366; color: #fff; text-decoration: none;
    font-family: 'Hanken Grotesk', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; font-size: 0.95rem; font-weight: 700; letter-spacing: 0.01em;
    box-shadow: 0 10px 24px -6px rgba(37, 211, 102, 0.55), 0 4px 10px rgba(15, 23, 42, 0.18);
    transition: padding 350ms var(--wa-ease), background-color 250ms ease, transform 250ms var(--wa-ease), box-shadow 250ms ease;
    -webkit-tap-highlight-color: transparent;
  }
  .wa-logo { position: relative; width: 1.7rem; height: 1.7rem; flex-shrink: 0; }
  .wa-float-text {
    position: relative; max-width: 0; margin-left: 0; opacity: 0; overflow: hidden; white-space: nowrap;
    transition: max-width 350ms var(--wa-ease), margin 350ms var(--wa-ease), opacity 250ms ease;
  }

  /* Soft pulse that draws the eye without being noisy; stops while the button is in use. */
  .wa-ring { position: absolute; inset: 0; border-radius: inherit; background: #25D366; opacity: 0; animation: wa-pulse 2.8s ease-out 1.5s infinite; pointer-events: none; }
  @keyframes wa-pulse {
    0% { transform: scale(1); opacity: 0.45; }
    70%, 100% { transform: scale(1.45); opacity: 0; }
  }

  .wa-float:hover, .wa-float:focus-visible, .wa-float:active {
    background: #1EBE5A; padding-right: 1.3rem; transform: translateY(-2px);
    box-shadow: 0 14px 30px -8px rgba(37, 211, 102, 0.6), 0 6px 14px rgba(15, 23, 42, 0.2);
  }
  .wa-float:hover .wa-float-text, .wa-float:focus-visible .wa-float-text, .wa-float:active .wa-float-text { max-width: 8rem; margin-left: 0.6rem; opacity: 1; }
  .wa-float:hover .wa-ring, .wa-float:focus-visible .wa-ring { animation: none; }
  .wa-float:focus-visible { outline: 3px solid #0F172A; outline-offset: 3px; }

  @media (max-width: 640px) {
    .wa-float { height: 3.4rem; padding: 0 0.85rem; }
    .wa-logo { width: 1.7rem; height: 1.7rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-float, .wa-float-text { transition-duration: 1ms; }
    .wa-ring { animation: none; }
  }
</style>
