---
import { siteContact } from "@data/site/site-config";

// Site-wide floating contact rail: WhatsApp first, then email.
// Icon-only until hovered or focused, then the label slides out.
const actions = [
  {
    key: "whatsapp",
    href: siteContact.whatsappHref,
    label: "WhatsApp us",
    aria: "Chat with us on WhatsApp",
    external: true,
  },
  {
    key: "mail",
    href: siteContact.emailHref,
    label: siteContact.email,
    aria: `Email us at ${siteContact.email}`,
    external: false,
  },
];
---

<div class="rail" aria-label="Contact BtechWaleTech">
  {actions.map((a) => (
    <a
      class={`rail-btn rail-${a.key}`}
      href={a.href}
      aria-label={a.aria}
      {...(a.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
    >
      <span class="rail-ico" aria-hidden="true">
        {a.key === "mail" && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" /><path d="m3 7 9 6 9-6" />
          </svg>
        )}
        {a.key === "whatsapp" && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
          </svg>
        )}
      </span>
      <span class="rail-label" aria-hidden="true">{a.label}</span>
    </a>
  ))}
</div>

<style>
  /* Sits under the header (z 39/40) so an open mobile menu covers it. */
  .rail {
    position: fixed;
    right: 0;
    top: 50%;
    z-index: 38;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transform: translateY(-50%);
    padding-right: env(safe-area-inset-right);
  }

  .rail-btn {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.65rem;
    width: 3.65rem;
    height: 3.65rem;
    padding: 0 0.95rem;
    overflow: hidden;
    border: 2.5px solid var(--bw-ink, #121316);
    border-right: 0;
    border-radius: var(--bw-r, 14px) 0 0 var(--bw-r, 14px);
    box-shadow: -5px 5px 0 var(--bw-ink, #121316);
    font-family: var(--font-display, system-ui), system-ui, sans-serif;
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition: width 420ms var(--bw-ease, cubic-bezier(0.16, 1, 0.3, 1)), box-shadow 220ms ease, transform 220ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  .rail-ico {
    display: inline-flex;
    flex: none;
    width: 1.72rem;
    height: 1.72rem;
  }
  .rail-ico svg { width: 100%; height: 100%; }

  .rail-label { opacity: 0; transition: opacity 260ms ease; }

  .rail-whatsapp { background: var(--bw-green, #25D366); color: #FFFFFF; }
  .rail-mail     { background: #FFFFFF; color: var(--bw-ink, #121316); }

  /* A short nudge on a 2s cycle, so the button keeps catching the eye. */
  .rail-whatsapp { animation: rail-nudge 2s var(--bw-ease, ease) 1.5s infinite; will-change: transform; }
  @keyframes rail-nudge {
    0%, 55%, 100% { transform: translateX(0); }
    68%           { transform: translateX(-9px); }
    80%           { transform: translateX(-3px); }
    90%           { transform: translateX(-6px); }
  }

  .rail-btn:hover,
  .rail-btn:focus-visible {
    width: auto;
    min-width: 3.65rem;
    padding-right: 1.25rem;
    box-shadow: -7px 7px 0 var(--bw-ink, #121316);
    transform: translateX(-3px);
    animation: none;
  }
  .rail-btn:hover .rail-label,
  .rail-btn:focus-visible .rail-label { opacity: 1; }

  .rail-btn:focus-visible { outline: 3px solid var(--bw-ink, #121316); outline-offset: 3px; }

  /* Phones keep the same centred right-edge position, just a touch smaller. */
  @media (max-width: 640px) {
    /* Lower than centre on a phone, so it clears the headline and the CTAs. */
    .rail { gap: 0.4rem; top: 68%; }
    .rail-btn { width: 3.25rem; height: 3.25rem; padding: 0 0.8rem; box-shadow: -4px 4px 0 var(--bw-ink, #121316); }
    .rail-ico { width: 1.55rem; height: 1.55rem; }
    /* No hover on touch, and an expanding rail would cover the page. */
    .rail-btn:hover { width: 3.25rem; padding-right: 0.8rem; transform: none; }
    .rail-btn:hover .rail-label { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rail-btn, .rail-label { transition-duration: 1ms; }
    .rail-whatsapp { animation: none; }
  }
</style>
