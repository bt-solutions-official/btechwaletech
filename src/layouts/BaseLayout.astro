---
import "@styles/global.css";
import Header from "@components/navigation/Header.astro";
import Footer from "@components/navigation/Footer.astro";
import WhatsAppFloat from "@components/common/WhatsAppFloat.astro";
import SEOHead from "@components/seo/SEOHead.astro";
import StructuredData from "@components/seo/StructuredData.astro";
import { organizationSchema, websiteSchema } from "@lib/schema/schema";
import type { SeoMeta } from "@app-types/seo";

interface Props {
  meta: SeoMeta;
  schema?: unknown[];
}

const { meta, schema = [] } = Astro.props;
---

<!doctype html>
<html lang={(meta.locale ?? "en_IN").replace("_", "-")}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- One variable family, roman axis only: six static Archivo cuts plus a second
         family was seven font downloads on every page. The variable range is one file,
         and italics are synthesised for the handful of pages with an <em>. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400..900&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400..900&display=swap" rel="stylesheet" />
    </noscript>
    <SEOHead meta={meta} />
    <StructuredData data={[organizationSchema(), websiteSchema(), ...schema]} />
    <!-- Page-specific <head> tags: only the pages that need an extra font or preload pay for it. -->
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
  </body>
</html>
