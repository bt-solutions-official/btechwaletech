---
import BaseLayout from "@layouts/BaseLayout.astro";
import { createPageSeo } from "@lib/seo/seo-config";
import { createBreadcrumbs } from "@lib/breadcrumbs/breadcrumbs";
import { breadcrumbListSchema, faqSchema } from "@lib/schema/schema";
import { canonicalUrl } from "@lib/urls/url-utils";
import { siteBrand, siteContact } from "@data/site/site-config";
import { pricingPlans, usdPrice } from "@data/pricing/plans";
import { usd } from "@data/countries/international";

const path = "/uae/";
const url = canonicalUrl(path);
const updated = "2026-09-21";

// ---------- FAQ (visible list and FAQPage schema share this array) ----------

const faqs = [
  {
    question: "Do you have an office, trade licence or staff in the UAE?",
    answer: "No. BtechWaleTech is a small team of engineers based in India and we work with UAE businesses remotely. We have no office in Dubai or any other emirate, no UAE trade licence and no local staff. You deal directly with the engineers who build your project, over WhatsApp, email and video calls.",
  },
  {
    question: "How much does a website cost for a business in the UAE?",
    answer: `Our starting prices for UAE clients are ${usd("Static")} for a static website of up to 100 pages, ${usd("SEO website")} for a 700+ page SEO website, ${usd("AI automation")} for AI automation, ${usd("Ecommerce")} for an ecommerce store and ${usd("Custom web app")} for a custom web app. Monthly SEO starts from ${usd("Monthly SEO")} and maintenance from ${usd("Maintenance")}. These are starting prices; the final quote depends on your requirements, including whether you need Arabic alongside English.`,
  },
  {
    question: "Can you build a bilingual Arabic and English website with proper RTL?",
    answer: "Yes. The Arabic version gets its own right-to-left layout built with direction-aware CSS, an Arabic typeface with suitable line height, mirrored navigation and icons where mirroring makes sense, and correct handling of phone numbers and English brand names inside Arabic sentences. Each language has its own URL so both can be indexed. The Arabic copy itself is written or reviewed by you or a translator you trust.",
  },
  {
    question: "Do you write the Arabic content?",
    answer: "No. We are not native Arabic writers and we will not pass off machine translation as finished copy. You or your translator supply the Arabic text, and we handle everything technical around it: layout, fonts, forms, metadata, hreflang tags and testing. We can prepare a structured content sheet so your translator knows exactly which strings to write.",
  },
  {
    question: "Which payment gateways can you integrate for a UAE online store?",
    answer: "We integrate the gateway you sign up with, including Stripe, Checkout.com, Telr, PayTabs and Network International, plus Apple Pay and Google Pay where the gateway supports them. Tabby and Tamara can be added for buy now, pay later. Cash on delivery can also be offered with order confirmation. The gateway contract, fees and merchant approval are between your company and the provider.",
  },
  {
    question: "Can you build on Shopify, WooCommerce or a custom platform?",
    answer: "Yes. Shopify suits most small and mid-sized UAE stores that want low maintenance. WooCommerce suits businesses that want content and commerce in one WordPress site. A custom build makes sense for unusual pricing, B2B ordering, or deep integration with an ERP. We recommend one after looking at your catalogue, order volume and team.",
  },
  {
    question: "How do you handle SEO for google.ae and Arabic searches?",
    answer: "We research English and Arabic keywords separately, because UAE customers phrase searches differently in each language. Each language version gets its own titles, descriptions and headings, hreflang tags tell Google which page serves which audience, and pages are planned around emirates and areas you actually serve. Monthly SEO then covers content, technical fixes and Search Console reporting.",
  },
  {
    question: "What is the time difference between India and the UAE?",
    answer: "The UAE is one and a half hours behind India all year, because neither country uses daylight saving time. Our hours of 9am to 9pm IST cover 7.30am to 7.30pm in Dubai, so almost the entire UAE business day overlaps with ours. Questions sent in the morning are normally answered the same day.",
  },
  {
    question: "Do you work on Fridays and weekends?",
    answer: "We reply on WhatsApp seven days a week. Most UAE private companies now follow a Saturday and Sunday weekend with a shorter Friday, while some keep Friday off, and Sharjah government bodies follow a longer weekend. We plan calls and launches around the days your team actually works, and we avoid pushing big changes just before your weekend.",
  },
  {
    question: "Which currency do you invoice in, and how do UAE clients pay?",
    answer: "We quote and invoice in US dollars by default. If you prefer dirhams, we can invoice in AED on request, using the fixed dirham to dollar peg to convert. Payment is by international bank transfer or Wise, split into milestones: a deposit to start, a payment at staging review and the balance at launch.",
  },
  {
    question: "Is UAE VAT added to your invoices?",
    answer: "We invoice from India as a foreign supplier, so we do not charge UAE VAT on our invoices. Whether your company has to account for VAT on imported services under the reverse charge depends on your own VAT registration, so please confirm the treatment with your accountant. For your online store, we set up VAT-inclusive pricing and tax invoice fields as your accountant specifies.",
  },
  {
    question: "Does our website need to comply with the UAE data protection law?",
    answer: "If your website collects personal data, the federal Personal Data Protection Law is relevant, and companies in DIFC or ADGM have their own data protection rules. We build forms that collect only what you need, show a clear notice, record consent and link to a privacy policy. We are engineers, not lawyers, so please take legal advice on your specific obligations.",
  },
  {
    question: "Can you host the website inside the UAE?",
    answer: "Yes, if you need it. Major cloud providers have regions in the UAE, and we can deploy there when your data or sector requires local hosting. For most marketing websites a global CDN is fast enough in the Gulf and cheaper to run. We explain the trade-off and deploy wherever you choose, on accounts in your company's name.",
  },
  {
    question: "Which domain should we use: .ae or .com?",
    answer: "A .ae domain is a strong local signal and is geotargeted to the UAE, which helps if nearly all your customers are there. It is registered through accredited registrars and has its own eligibility rules. If you sell across the Gulf or internationally, a .com with UAE-specific pages often works better. Many businesses register both and redirect one to the other.",
  },
  {
    question: "How long does a UAE website project take?",
    answer: "A static website typically takes one to two weeks, a 700+ page SEO website three to five weeks, AI automation two to four weeks, an ecommerce store four to eight weeks and a custom web app six to twelve weeks. A full Arabic version usually adds about a week for layout, testing and fixes once the translated copy arrives.",
  },
  {
    question: "Who owns the website, code and accounts after launch?",
    answer: "You do. The domain, hosting, analytics, Search Console and payment accounts are set up in your company's name, and at handover you receive the source code and every login. We keep no licence over your build and nothing you cannot change without us.",
  },
  {
    question: "What does the five months of free maintenance cover?",
    answer: `Once your site is hosted and live, the next five months of maintenance are included: content and text updates, bug fixes, security and dependency updates, backups, and uptime and speed checks. After that you can continue from ${usd("Maintenance")} or contact us only when something needs changing.`,
  },
  {
    question: "Can you guarantee first-page rankings in Dubai?",
    answer: "No, and nobody honestly can. Dubai search results for property, travel and services are crowded with portals, ads and established brands. We commit to a technically sound site, pages built around real search demand in English and Arabic, honest reporting from Search Console and steady improvements based on the data.",
  },
  {
    question: "How do we start a project?",
    answer: "Send a WhatsApp message or email describing your business, the emirates you serve, whether you need Arabic, and any sites you like. We reply with questions, then a written scope, timeline and itemised quote, usually within two working days. Work starts only after you approve the scope and pay the first milestone.",
  },
];

// ---------- Page meta ----------

const page = createPageSeo({
  title: "Web Development Company UAE | Dubai Website Design",
  description: `Web development company for UAE businesses: Arabic and English websites, ecommerce, SEO and AI automation. Remote team in India, from ${usd("Static")}.`,
  canonicalPath: path,
  h1: "Web development company for the UAE: Dubai, Abu Dhabi and every emirate",
  intro: `BtechWaleTech is a small team of engineers based in India that builds websites, Android and iOS apps, ecommerce stores, SEO systems, custom software and AI automations for businesses across the UAE. We work remotely, invoice in US dollars or dirhams, and publish our starting prices: websites start from ${usd("Static")}.`,
  breadcrumbs: createBreadcrumbs([
    { label: "Countries", href: "/countries/" },
    { label: "UAE", href: path },
  ]),
  locale: "en_AE",
  alternateLocales: ["ar_AE"],
  ogImage: { url: "/banner_logo.png", alt: "BtechWaleTech, a remote web development and SEO team from India serving businesses across the UAE", width: 1536, height: 1024 },
  keywords: [
    "web development company UAE",
    "website design UAE",
    "web development company Dubai",
    "website design Dubai",
    "website development Abu Dhabi",
    "web design Sharjah",
    "website design Ajman",
    "web developer Ras Al Khaimah",
    "website design Fujairah",
    "web development Al Ain",
    "SEO services UAE",
    "SEO company Dubai",
    "Arabic website design",
    "bilingual Arabic English website",
    "RTL website development",
    "ecommerce website development UAE",
    "Shopify developer Dubai",
    "Tabby Tamara integration",
    "Telr PayTabs integration",
    "custom software development UAE",
    "AI automation Dubai",
    "website maintenance UAE",
    "offshore web development UAE",
    "hire web developer Dubai",
    "تصميم مواقع",
    "تصميم مواقع دبي",
    "شركة تطوير مواقع",
    "برمجة مواقع",
    "تصميم متجر إلكتروني",
    "تحسين محركات البحث",
  ],
});

// ---------- Hero, stats and snapshot ----------

const facts = [
  ["Team", "Engineers based in India, remote delivery"],
  ["Starting price", `Websites from ${usd("Static")}`],
  ["Languages", "English, with Arabic RTL builds"],
  ["Billing", "USD, or AED on request"],
  ["Time gap", "UAE is 1.5 hours behind IST"],
  ["After launch", "5 months of maintenance free"],
];

const pills = ["Arabic and English sites", "Ecommerce with Tabby and Telr", "SEO for google.ae", "Shopify and WooCommerce", "AI automation", "Custom web apps"];

const stats = [
  { value: "3", label: "Engineers you talk to directly" },
  { value: usd("Static"), label: "Websites starting price" },
  { value: "1.5h", label: "Behind India, no daylight saving" },
  { value: "5", label: "Months maintenance free" },
];

const snapshot = [
  { label: "Who we are", value: "Three engineers based in India, working remotely with UAE businesses" },
  { label: "What we build", value: "Websites, ecommerce, SEO, custom software, web apps, AI automation, maintenance" },
  { label: "Languages", value: "English in-house; Arabic RTL layouts with copy from you or your translator" },
  { label: "Gateways we integrate", value: "Stripe, Checkout.com, Telr, PayTabs, Network International, Tabby, Tamara" },
  { label: "Working hours overlap", value: "7.30am to 7.30pm UAE time, replies seven days a week" },
  { label: "Billing", value: "USD by default, AED on request, via bank transfer or Wise" },
  { label: "Office in the UAE", value: "None. Remote delivery from India only" },
];

// ---------- Services bento ----------

const services = [
  { name: "Website design & development", note: "Fast business websites on Astro, Next.js or WordPress, in English, Arabic or both, with WhatsApp and form enquiries routed to your team.", href: "/services/web-development/", size: "lg" },
  { name: "SEO for google.ae", note: "English and Arabic keyword research, hreflang, emirate-level pages, schema and monthly content work.", href: "/services/seo-services/", size: "md" },
  { name: "Ecommerce stores", note: "Shopify, WooCommerce or custom stores with VAT-inclusive pricing, card gateways, BNPL and cash on delivery.", size: "sm" },
  { name: "Bilingual Arabic sites", note: "True right-to-left layouts, Arabic typography and separate indexable URLs per language.", size: "sm" },
  { name: "Custom software", note: "Booking systems, broker portals, dashboards and admin panels built around your workflow.", size: "sm" },
  { name: "AI automation", note: "Lead routing, invoice extraction, WhatsApp flows and assistants trained on your own documents.", size: "sm" },
  { name: "Android & iOS apps", note: `Android and iPhone apps for field teams, customers and partners, on Google Play and the App Store, from ${usd("Android")}.`, size: "sm" },
  { name: "Maintenance & support", note: "Updates, backups, fixes and speed checks, with 5 months free after launch.", size: "sm" },
] as const;

// ---------- Comparison ----------

const comparison = [
  ["Starting price", "Higher, covers a local office, licence and sales team", "Low bids, scope often vague", `From ${usd("Static")}, with an itemised written quote`],
  ["Who does the work", "Often a junior team behind an account manager", "One person, sometimes subcontracted onward", "The three engineers you speak to"],
  ["Arabic and RTL", "Usually offered, quality varies", "Often a mirrored copy of the English layout", "Separate RTL layout, tested in both directions"],
  ["Meeting in person", "Yes, a real advantage", "Rarely", "No. Video calls, WhatsApp and a staging link"],
  ["Working hours", "UAE business hours", "Depends on the individual's time zone", "9am to 9pm IST, which is 7.30am to 7.30pm UAE"],
  ["SEO setup", "Often a separate package", "Frequently skipped", "Titles, schema, hreflang and sitemap in every build"],
  ["Ownership", "Usually yours, check the contract", "Logins sometimes withheld", "Domain, hosting, code and accounts in your name"],
  ["After launch", "Paid retainer", "Often unreachable", "5 months of maintenance included free"],
];

// ---------- Emirates ----------

const emirates = [
  { name: "Dubai", cities: "Dubai city, Jebel Ali, Hatta", market: "Trade, real estate, tourism, retail, logistics and professional services. The most competitive search market in the country.", build: "Listing portals, booking flows, bilingual corporate sites, ecommerce, area-level SEO pages" },
  { name: "Abu Dhabi", cities: "Abu Dhabi city, Al Ain, Al Dhafra towns", market: "Energy, government suppliers, healthcare, education, culture and tourism, with Al Ain as a separate inland market.", build: "Formal bilingual corporate sites, tender-ready company profiles, clinic and school sites" },
  { name: "Sharjah", cities: "Sharjah city, Khor Fakkar, Kalba", market: "Manufacturing, education, family businesses, affordable housing and a strong cultural and publishing scene.", build: "Catalogue sites for manufacturers and traders, school and institute sites, local service pages" },
  { name: "Ajman", cities: "Ajman city, Masfout", market: "Small traders, clinics, property, and a busy free zone serving startups and light industry.", build: "Low-cost static sites, lead-focused landing pages, small online stores" },
  { name: "Ras Al Khaimah", cities: "RAK city, Al Hamra, Al Marjan Island", market: "Hospitality and resorts, ceramics and industry, property, and a large economic zone for international companies.", build: "Hotel and tourism sites, industrial catalogues, investor-facing company sites" },
  { name: "Fujairah", cities: "Fujairah city, Dibba Al Fujairah", market: "Port, shipping, bunkering and oil storage, plus east coast tourism and diving.", build: "Shipping and marine service sites, B2B enquiry systems, tourism booking pages" },
  { name: "Umm Al Quwain", cities: "UAQ city, Falaj Al Mualla", market: "Small businesses, leisure and marine activities, and a free trade zone popular with small companies.", build: "Compact business sites, maps and directions pages, simple booking forms" },
  { name: "Free zones", cities: "DMCC, DIFC, ADGM, Dubai Internet City, SAIF, RAKEZ and others", market: "Trading houses, fintech, consultancies and tech startups serving the region and the world.", build: "International-facing corporate sites, SaaS dashboards, investor pages, compliance-aware forms" },
];

// ---------- Industries ----------

const industries = [
  { name: "Real estate", need: "Searchable listings, off-plan project pages, agent profiles, fast WhatsApp contact", build: "Listing databases with filters, project microsites, CRM-connected lead forms, Arabic and English pages" },
  { name: "Hospitality & tourism", need: "Rich photos that still load fast, clear rates, booking on a phone, several languages", build: "Hotel and tour sites, booking engine integration, offer pages staff can edit, schema for rich results" },
  { name: "Retail & ecommerce", need: "VAT-inclusive prices in AED, trusted checkout, BNPL, cash on delivery, quick delivery info", build: "Shopify, WooCommerce or custom stores with Tabby, Tamara, card gateways and courier integration" },
  { name: "Healthcare & clinics", need: "Doctor profiles, insurance information, appointment requests, careful data handling", build: "Clinic sites with booking forms, minimal data collection, consent notices and bilingual service pages" },
  { name: "Education", need: "Admissions information for expat families, curriculum details, fee enquiries, events", build: "School and training institute sites, enquiry and admissions forms, course catalogues" },
  { name: "Logistics & trade", need: "Quote requests, route and service pages, tracking, document downloads", build: "B2B sites with quote calculators, tracking lookups, product catalogues and spec sheet libraries" },
  { name: "Food & beverage", need: "Menus that update easily, delivery links, reservations, location and hours", build: "Restaurant and cloud kitchen sites, menu CMS, reservation forms, Google Business Profile guidance" },
];

// ---------- Process and timelines ----------

const process = [
  ["Talk", "A WhatsApp chat or video call about your business, the emirates you serve, your languages and your goal. No charge."],
  ["Scope & quote", "A written page plan, keyword list, timeline and itemised USD or AED quote, usually within two working days."],
  ["Design", "Layouts for key pages in English, with the Arabic RTL versions designed alongside rather than after."],
  ["Build & review", "Development on a private staging link you can open any time. Small changes usually land the same day."],
  ["Launch", "Hosting, domain, SSL, Search Console, analytics and sitemap set up, then a scheduled go-live at a quiet hour."],
  ["Support", "Five months of free maintenance, then an optional monthly plan or pay-as-needed changes."],
];

// ---------- Schema ----------

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${url}#service`,
  name: `${siteBrand.name}: web development and IT services for the UAE`,
  description: page.description,
  url,
  image: new URL("/banner_logo.png", siteBrand.domain).toString(),
  email: siteContact.email,
  telephone: siteContact.phone,
  priceRange: `${usd("Maintenance")} - ${usd("Custom web app")}+`,
  currenciesAccepted: "USD, AED",
  paymentAccepted: "Bank transfer, Wise",
  address: { "@type": "PostalAddress", addressCountry: "IN" },
  areaServed: [
    { "@type": "Country", name: "United Arab Emirates" },
    ...["Dubai", "Abu Dhabi", "Sharjah", "Ajman", "Ras Al Khaimah", "Fujairah", "Umm Al Quwain"].map((name) => ({ "@type": "State", name: `${name} emirate` })),
    ...["Dubai", "Abu Dhabi", "Sharjah", "Al Ain", "Ajman", "Ras Al Khaimah", "Fujairah", "Umm Al Quwain", "Khor Fakkan"].map((name) => ({ "@type": "City", name })),
  ],
  knowsLanguage: ["en"],
  parentOrganization: { "@type": "Organization", name: siteBrand.name, url: siteBrand.domain },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Web development and IT services for UAE businesses (starting prices, USD)",
    itemListElement: pricingPlans.map((plan) => {
      const price = Number(usdPrice(plan.price).replace(/[^\d]/g, ""));
      return {
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: plan.name, description: plan.summary, areaServed: "United Arab Emirates" },
        priceSpecification: {
          "@type": "PriceSpecification",
          price,
          minPrice: price,
          priceCurrency: "USD",
          ...(plan.unit ? { unitText: plan.unit } : {}),
        },
      };
    }),
  },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${url}#webpage`,
  url,
  name: page.title,
  description: page.description,
  inLanguage: "en-AE",
  dateModified: updated,
  about: { "@id": `${url}#service` },
  speakable: { "@type": "SpeakableSpecification", cssSelector: ["#quick-answer", "h1"] },
};

const toc = [
  ["who-we-are", "Who we are and how remote delivery works"],
  ["uae-market", "What UAE customers expect online"],
  ["arabic-rtl", "Bilingual Arabic and English websites"],
  ["ecommerce", "Ecommerce and payments in the UAE"],
  ["seo", "SEO for google.ae in two languages"],
  ["software", "Custom software and AI automation"],
  ["emirates", "Emirate by emirate"],
  ["compliance", "Data protection, VAT and rules"],
  ["time-zones", "Time zones and the working week"],
  ["payments", "How UAE clients pay us"],
  ["buying-guide", "Hiring an offshore developer"],
  ["cost", "What a UAE website really costs"],
];

const related = [
  { name: "Web development services", href: "/services/web-development/" },
  { name: "SEO services", href: "/services/seo-services/" },
  { name: "Pricing", href: "/pricing/" },
  { name: "All countries we serve", href: "/countries/" },
  { name: "IT services in Japan", href: "/japan/" },
  { name: "IT services in Saudi Arabia", href: "/saudi-arabia/" },
  { name: "IT services in India", href: "/india/" },
  { name: "IT services in the USA", href: "/usa/" },
  { name: "IT services in the UK", href: "/uk/" },
  { name: "IT services in Canada", href: "/canada/" },
  { name: "IT services in Australia", href: "/australia/" },
];
---

<BaseLayout meta={page} schema={[webPageSchema, serviceSchema, breadcrumbListSchema(page.breadcrumbs), faqSchema(faqs)]}>

  <!-- ===================== HERO ===================== -->
  <section class="hero" aria-labelledby="country-heading">
    <div class="hero-inner">
      <div class="hero-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {page.breadcrumbs.map((b, i) => (
              <li>{i + 1 === page.breadcrumbs.length ? <span aria-current="page">{b.label}</span> : <a href={b.href}>{b.label}</a>}</li>
            ))}
          </ol>
        </nav>
        <p class="eyebrow">United Arab Emirates · All seven emirates</p>
        <h1 id="country-heading">{page.h1}</h1>
        <p class="lede">{page.intro}</p>
        <ul class="facts" aria-label="Quick facts for UAE clients">
          {facts.map(([label, value]) => <li><strong>{label}</strong><span>{value}</span></li>)}
        </ul>
        <div class="hero-actions">
          <a class="btn-primary" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp for a free quote</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-ghost" href={siteContact.emailHref}>{siteContact.email}</a>
        </div>
        <ul class="hero-pills" aria-label="What we build for UAE businesses">
          {pills.map((p) => <li>{p}</li>)}
        </ul>
        <p class="hero-origin">
          <span class="origin-dot" aria-hidden="true"></span>
          Team based in India &middot; Serving the UAE remotely &middot; <span lang="ar" dir="rtl">تصميم مواقع وبرمجة مواقع</span>
        </p>
      </div>

      <aside class="quote-card" aria-label="Starting prices for UAE clients">
        <p class="quote-kicker">UAE starting prices (USD)</p>
        <ul class="quote-rows">
          {pricingPlans.slice(0, 5).map((plan) => (
            <li><span>{plan.name}</span><strong><small>from </small>{usd(plan.name)}</strong></li>
          ))}
        </ul>
        <p class="quote-foot">Starting prices; your quote depends on requirements. AED invoicing on request. 5 months maintenance free after launch.</p>
        <a class="btn-primary btn-block" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
          <span>Get my UAE quote</span><span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </aside>
    </div>
  </section>

  <!-- ===================== STATS ===================== -->
  <section class="stats-section" aria-label="BtechWaleTech for UAE clients in numbers">
    <div class="section-wrap">
      <ul class="stat-band">
        {stats.map((s) => (
          <li><span class="stat-num">{s.value}</span><span class="stat-label">{s.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== QUICK ANSWER + SNAPSHOT ===================== -->
  <section class="answer" aria-labelledby="answer-heading">
    <div class="section-wrap answer-grid">
      <div>
        <p class="eyebrow">The short answer</p>
        <h2 id="answer-heading">Looking for a web development company in the UAE?</h2>
        <p id="quick-answer" class="answer-text">
          BtechWaleTech is a three-engineer team based in India that builds websites, bilingual Arabic and English sites,
          ecommerce stores, SEO systems, custom software and AI automations for businesses in Dubai, Abu Dhabi, Sharjah and
          the other emirates. We work remotely, overlap almost the whole UAE working day, bill in US dollars or dirhams, and
          start from {usd("Static")} for a website.
        </p>
        <p class="answer-more">
          We are not a Dubai agency and do not pretend to be one. There is no showroom on Sheikh Zayed Road and no local
          sales team. What you get instead is direct access to the people writing the code, published starting prices,
          written scopes and a staging link you can open from your phone at any time. For many UAE companies, especially
          small firms, startups and businesses that already work with teams abroad, that trade-off is exactly the point.
        </p>
        <p class="updated">Last updated <time datetime={updated}>21 September 2026</time></p>
      </div>
      <table class="snapshot">
        <caption>Working with us from the UAE, at a glance</caption>
        <tbody>
          {snapshot.map((row) => (
            <tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="services" aria-labelledby="services-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Services for the UAE</p>
        <h2 id="services-heading">Websites, stores, SEO and software for UAE businesses, from one team</h2>
        <p class="section-note">
          Planning, design, development, SEO setup, hosting and deployment are handled end to end, so you are not chasing a
          designer, a developer and an SEO consultant who each blame the other. See the full
          <a href="/services/web-development/">web development</a> and <a href="/services/seo-services/">SEO services</a> pages,
          or jump to <a href="/pricing/">pricing</a>.
        </p>
      </div>
      <div class="bento">
        {services.map((s) => {
          const inner = (
