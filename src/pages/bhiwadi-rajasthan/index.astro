---
import FreelancePage from "@components/freelance/FreelancePage.astro";
import { bhiwadi } from "@data/bhiwadi/place";
import plan from "@data/bhiwadi/pages.json";
import hub, { groups } from "@data/bhiwadi/hub";
import type { FreelanceContent } from "@data/freelance/types";

// Hub for the /bhiwadi-rajasthan/{service}/ pages: hand-written copy from hub.ts plus one table per service group,
// built from the pages that exist, so every new Bhiwadi page is linked from here automatically.
const built = new Map(
  Object.values(import.meta.glob<{ default: FreelanceContent }>("../../data/bhiwadi/content/*.ts", { eager: true }))
    .map(({ default: c }) => [c.path, c]),
);
const tables = groups
  .map(({ key, ...g }) => ({
    ...g,
    columns: ["Page", "What it covers"],
    rows: plan
      .filter((p) => p.group === key)
      .map((p) => built.get(`${bhiwadi.path}${p.slug}/`))
      .filter((c): c is FreelanceContent => Boolean(c))
      .map((c) => [`<a href='${c.path}'>${c.crumb} in Bhiwadi</a>`, c.meta.description]),
  }))
  .filter((t) => t.rows.length);
---

<FreelancePage content={{ ...hub, tables: [...hub.tables, ...tables] }} place={bhiwadi} />
