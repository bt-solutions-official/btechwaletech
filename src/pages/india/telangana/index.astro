---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--telangana");
const links = uniqueLinks([
  { name: "Hyderabad", href: "/india/telangana/hyderabad/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Telangana"
  state="Telangana"
  areaType="State"
  path="/india/telangana/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Telangana", href: "/india/telangana/" }]}
  content={content}
  links={links}
/>
