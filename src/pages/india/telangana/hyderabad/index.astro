---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--telangana--hyderabad");
const links = uniqueLinks([
  { name: "Telangana", href: "/india/telangana/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Hyderabad"
  state="Telangana"
  areaType="City"
  path="/india/telangana/hyderabad/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Telangana", href: "/india/telangana/" }, { label: "Hyderabad", href: "/india/telangana/hyderabad/" }]}
  content={content}
  links={links}
/>
