---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--tamil-nadu--chennai");
const links = uniqueLinks([
  { name: "Tamil Nadu", href: "/india/tamil-nadu/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Chennai"
  state="Tamil Nadu"
  areaType="City"
  path="/india/tamil-nadu/chennai/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Tamil Nadu", href: "/india/tamil-nadu/" }, { label: "Chennai", href: "/india/tamil-nadu/chennai/" }]}
  content={content}
  links={links}
/>
