---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--tamil-nadu");
const links = uniqueLinks([
  { name: "Chennai", href: "/india/tamil-nadu/chennai/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Tamil Nadu"
  state="Tamil Nadu"
  areaType="State"
  path="/india/tamil-nadu/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Tamil Nadu", href: "/india/tamil-nadu/" }]}
  content={content}
  links={links}
/>
