    ...topMetros.map((name) => ({ "@type": "City", name, containedInPlace: india })),
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Website development, SEO and IT services in India",
    itemListElement: pricingPlans.map((plan) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: plan.name, description: plan.summary },
      areaServed: india,
      priceSpecification: {
        "@type": "PriceSpecification",
        minPrice: Number(plan.price.replace(/[^\d]/g, "")),
        priceCurrency: "INR",
        valueAddedTaxIncluded: false,
        ...(plan.unit ? { unitText: plan.unit } : {}),
      },
    })),
  },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${url}#webpage`,
  url,
  name: page.title,
  description: page.description,
  inLanguage: "en-IN",
  about: { "@id": `${url}#service` },
  speakable: { "@type": "SpeakableSpecification", cssSelector: ["#quick-answer", "h1"] },
};

const stateHubListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Website development and IT services by state in India",
  itemListElement: stateRows.map((row, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: `${row.state} website development and IT services`,
    url: canonicalUrl(row.href),
  })),
};
---

<BaseLayout meta={page} schema={[webPageSchema, professionalServiceSchema, breadcrumbListSchema(page.breadcrumbs), faqSchema(faqs), stateHubListSchema]}>

  <!-- ===================== HERO ===================== -->
  <section class="hero" aria-labelledby="india-heading">
    <div class="hero-inner">
      <div class="hero-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {page.breadcrumbs.map((b, i) => (
              <li>{i + 1 === page.breadcrumbs.length ? <span aria-current="page">{b.label}</span> : <a href={b.href}>{b.label}</a>}</li>
            ))}
          </ol>
        </nav>
        <p class="eyebrow">India · All states and union territories</p>
        <h1 id="india-heading">{page.h1}</h1>
        <p class="lede">{page.intro}</p>
        <ul class="facts" aria-label="Quick facts">
          {facts.map(([label, value]) => <li><strong>{label}</strong><span>{value}</span></li>)}
        </ul>
        <div class="hero-actions">
          <a class="btn-primary" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp for a free quote</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-ghost" href={siteContact.phoneHref}>Call {siteContact.phone}</a>
        </div>
        <ul class="hero-pills" aria-label="What we build">
          {pills.map((p) => <li>{p}</li>)}
        </ul>
        <p class="hero-origin">
          <span class="origin-dot" aria-hidden="true"></span>
          Team based in India &middot; Remote delivery nationwide &middot; No branch offices
        </p>
      </div>

      <aside class="quote-card" aria-label="Starting prices in India">
        <p class="quote-kicker">India starting prices</p>
        <ul class="quote-rows">
          {pricingPlans.slice(0, 5).map((plan) => (
            <li><span>{plan.name}</span><strong><small>from </small>{plan.price}{plan.unit ? <small> /mo</small> : null}</strong></li>
          ))}
        </ul>
        <p class="quote-foot">All figures are starting prices before GST; your quote depends on requirements. 5 months maintenance free after launch.</p>
        <a class="btn-primary btn-block" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
          <span>Get my quote on WhatsApp</span><span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </aside>
    </div>
  </section>

  <!-- ===================== STATS ===================== -->
  <section class="stats-section" aria-label="BtechWaleTech in numbers">
    <div class="section-wrap">
      <ul class="stat-band">
        {stats.map((s) => (
          <li><span class="stat-num">{s.value}</span><span class="stat-label">{s.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== QUICK ANSWER + SNAPSHOT ===================== -->
  <section class="answer" aria-labelledby="answer-heading">
    <div class="section-wrap answer-grid">
      <div>
        <p class="eyebrow">The short answer</p>
        <h2 id="answer-heading">Looking for a website development company in India?</h2>
        <p id="quick-answer" class="answer-text">BtechWaleTech is a three-engineer team based in India that builds websites, ecommerce stores, SEO systems, custom software and AI automations for businesses in every state, working remotely. Websites start from ₹10,000, ecommerce from ₹50,000 and custom web apps from ₹60,000. Every price is a starting price, hosting and deployment are included, and the first five months of maintenance after launch are free.</p>
        <p class="answer-more">India is not one market. A coaching institute in Patna, a knitwear exporter in Tiruppur and a homestay in Gangtok need different things from a website, and search competition in Delhi NCR is nothing like competition in Guwahati. This page explains what we build, what it costs, how to choose a developer, and what businesses in each state typically need online.</p>
      </div>
      <table class="snapshot">
        <caption>BtechWaleTech at a glance</caption>
        <tbody>
          {snapshot.map((row) => (
            <tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="services" aria-labelledby="services-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Services across India</p>
        <h2 id="services-heading">Everything your business needs online, from one team</h2>
        <p class="section-note">Planning, design, development, SEO setup, hosting and deployment are handled end to end, so you are not coordinating a designer, a developer and an SEO consultant who each blame the other two.</p>
      </div>
      <div class="bento">
        {services.map((s) => {
          const inner = (
            <div class="card-core">
              <h3>{s.name}</h3>
              <p>{s.note}</p>
              {"href" in s && <span class="card-arrow" aria-hidden="true">&rarr;</span>}
            </div>
          );
          return "href" in s ? <a class={`card card-${s.size}`} href={s.href}>{inner}</a> : <div class={`card card-${s.size}`}>{inner}</div>;
        })}
      </div>
    </div>
  </section>

  <!-- ===================== WHY US ===================== -->
  <section class="advantage" aria-labelledby="why-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Why choose us</p>
        <h2 id="why-heading">Local agency vs freelancer vs BtechWaleTech</h2>
        <p class="section-note">A fair comparison of typical trade-offs. Good agencies and good freelancers exist; this is not about any particular provider.</p>
      </div>
      <div class="comparison-table-wrap">
        <table class="comparison-table">
          <caption class="sr-only">Comparison of a local agency, a low-cost freelancer and BtechWaleTech</caption>
          <thead>
            <tr>
              <th scope="col">What matters</th>
              <th scope="col" class="col-other">Local agency</th>
              <th scope="col" class="col-other hide-sm">Cheap freelancer</th>
              <th scope="col" class="col-us">BtechWaleTech</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map(([aspect, agency, cheap, us]) => (
              <tr>
                <th scope="row" class="td-aspect">{aspect}</th>
                <td class="col-other">{agency}</td>
                <td class="col-other hide-sm">{cheap}</td>
                <td class="td-us"><span class="td-us-inner"><span class="td-check" aria-hidden="true">✓</span>{us}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===================== PRICING ===================== -->
  <section class="pricing" aria-labelledby="pricing-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Pricing</p>
        <h2 id="pricing-heading">Website development cost in India: starting prices</h2>
        <p class="section-note">Every figure below is a starting price in INR, before any applicable GST. The final quote depends on your requirements: pages, content, payments, logins, integrations and deadlines. You get an itemised quote before any work begins.</p>
      </div>
      <div class="comparison-table-wrap">
        <table class="price-table">
          <caption class="sr-only">Starting prices in INR for BtechWaleTech services in India</caption>
          <thead>
            <tr><th scope="col">Service</th><th scope="col">Starting price</th><th scope="col">Typical timeline</th><th scope="col">What is included</th></tr>
          </thead>
          <tbody>
            {pricingPlans.map((plan) => (
              <tr>
                <th scope="row">{plan.name}</th>
                <td class="price"><small>from </small>{plan.price}{plan.unit && <small> {plan.unit}</small>}</td>
                <td>{plan.timeline}</td>
                <td>{plan.includes.join(" · ")}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine">{pricingNote} Prices exclude GST; if you need a GST invoice for input tax credit, share your GSTIN with your enquiry and the quote will state how tax is handled. <a href="/pricing/">See full pricing</a>.</p>
    </div>
  </section>

  <!-- ===================== LONG-FORM GUIDE ===================== -->
  <section class="guide" aria-label="Guide to website development in India">
    <div class="section-wrap guide-grid">
      <nav class="toc" aria-label="On this page">
        <p class="toc-title">On this page</p>
        <ol>
          {guideToc.map((t) => <li><a href={`#${t.id}`}>{t.heading}</a></li>)}
          {regionToc.map((t) => <li><a href={`#${t.id}`}>{t.heading}</a></li>)}
          <li><a href="#states-heading">State-by-state table</a></li>
          <li><a href="#industries-heading">Industries</a></li>
          <li><a href="#faq-heading">FAQs</a></li>
        </ol>
      </nav>
      <div class="prose">
        {guide.map((g) => (
          <article aria-labelledby={g.id}>
            <h2 id={g.id}>{g.heading}</h2>
            {g.paragraphs.map((p) => <p set:html={p} />)}
            {"list" in g && g.list && <ul>{g.list.map((li) => <li set:html={li} />)}</ul>}
            {"after" in g && g.after && g.after.map((p) => <p set:html={p} />)}
          </article>
        ))}

        {regions.map((r) => (
          <article aria-labelledby={`region-${r.id}`}>
            <h2 id={`region-${r.id}`}>{r.name}: what businesses need online</h2>
            <p>{r.intro}</p>
            {r.states.map((s) => (
              <div class="state-block">
                <h3>{s.name}{s.ut && <small class="ut-tag"> Union Territory</small>}</h3>
                <p>{s.text}</p>
                {(s.hub || s.cities.length > 0) && (
                  <p class="state-links">
                    {s.hub && <a class="state-hub" href={s.hub.href}>IT services in {s.name}</a>}
                    {s.cities.map((c) => <a href={c.href}>{c.name}</a>)}
                  </p>
                )}
              </div>
            ))}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== STATE TABLE ===================== -->
  <section class="industries" aria-labelledby="states-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">State by state</p>
        <h2 id="states-heading">Every state and union territory with its own page</h2>
        <p class="section-note">Key cities we have covered, the industries that most often ask for websites there, and a link to the state page.</p>
      </div>
      <div class="comparison-table-wrap">
        <table class="price-table fit-sm">
          <caption class="sr-only">States and union territories with key cities, common industries and page links</caption>
          <thead>
            <tr><th scope="col">State / UT</th><th scope="col">Key cities</th><th scope="col" class="hide-sm">Common industries</th><th scope="col">Page</th></tr>
          </thead>
          <tbody>
            {stateRows.map((row) => (
              <tr>
                <th scope="row">{row.state}{row.ut && <small> (UT)</small>}</th>
                <td>{row.keyCities}</td>
                <td class="hide-sm">{row.industries}</td>
                <td><a class="table-link" href={row.href}>IT services in {row.state}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===================== INDUSTRIES ===================== -->
  <section class="industries" aria-labelledby="industries-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Industries</p>
        <h2 id="industries-heading">What we build for India's main industries</h2>
        <p class="section-note">Concrete website and SEO needs by sector. The <a href="/industries/">industries page</a> goes further.</p>
      </div>
      <div class="comparison-table-wrap">
        <table class="price-table">
          <thead><tr><th scope="col">Industry</th><th scope="col">What buyers look for</th><th scope="col">What we build</th></tr></thead>
          <tbody>
            {industries.map((i) => (
              <tr><th scope="row">{i.name}</th><td>{i.need}</td><td>{i.build}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===================== PROCESS ===================== -->
  <section class="process" aria-labelledby="process-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="process-heading">From first message to a live site</h2>
      </div>
      <ol class="steps steps-six">
        {process.map(([step, detail], i) => (
          <li><span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span><h3>{step}</h3><p>{detail}</p></li>
        ))}
      </ol>
      <div class="comparison-table-wrap timeline-wrap">
        <table class="price-table fit-sm">
          <caption class="sr-only">Typical project timelines</caption>
          <thead><tr><th scope="col">Project</th><th scope="col">Typical timeline</th><th scope="col" class="hide-sm">What it covers</th></tr></thead>
          <tbody>
            {pricingPlans.map((plan) => (
              <tr><th scope="row">{plan.name}</th><td>{plan.timeline}</td><td class="hide-sm">{plan.summary}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine">Timelines assume content and approvals arrive on time. Payments, stock rules and user accounts add testing time to ecommerce and custom builds.</p>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="faq" aria-labelledby="faq-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-heading">Website development in India: questions, answered</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary><span>{f.question}</span><span class="faq-mark" aria-hidden="true">+</span></summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== LOCATIONS ===================== -->
  <section class="locations" aria-labelledby="cities-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Cities we serve</p>
        <h2 id="cities-heading">IT services, websites, SEO &amp; AI automation across Indian cities</h2>
        <p class="section-note">Detailed metro guides first, then every city page we have published. The <a href="/it-services/">IT services directory</a> lists more towns.</p>
      </div>
      <div class="city-cloud metro-cloud">
        {indiaCityGuides.map((c) => <a class="city-chip city-chip-strong" href={c.href}>{c.name}</a>)}
      </div>
      <div class="city-cloud">
        {builtCities.map((c, i) => <a class="city-chip" href={`/${c.slug}/`}>{["IT services in", "Websites & SEO in", "Software & AI automation in", "Web, app & AI services in"][i % 4]} {c.name}</a>)}
      </div>
    </div>
  </section>

  <!-- ===================== CLOSING CTA ===================== -->
  <section class="closing" aria-labelledby="cta-heading">
    <div class="section-wrap">
      <div class="closing-inner">
        <p class="eyebrow">Next step</p>
        <h2 id="cta-heading">Tell us what you want built, wherever you are in India</h2>
        <p class="closing-note">
          Send a few lines about your business on WhatsApp. You get questions first, then a page plan, a timeline and an itemised quote.
          Nothing is billed until you approve it, and five months of maintenance are included after launch.
        </p>
        <div class="hero-actions closing-actions">
          <a class="btn-primary" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp us</span><span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-ghost" href={siteContact.emailHref}>{siteContact.email}</a>
        </div>
        <p class="closing-links">
          <a href="/services/">All services</a> · <a href="/services/web-development/">Web development</a> · <a href="/services/seo-services/">SEO services</a> ·
          <a href="/pricing/">Pricing</a> · <a href="/portfolio/">Portfolio</a> · <a href="/about/">About</a> · <a href="/it-services/">IT services by state</a> ·
          <a href="/countries/">Countries</a> · <a href="/contact/">Contact</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Tokens and section styles mirror src/pages/[city].astro so /india/ matches the city pages. */
  :root {
    --paper: #FDFCFB;
    --surface: #F8F9FA;
    --surface-low: #F3F4F5;
    --midnight: #0F172A;
    --slate: #334155;
    --slate-muted: #64748B;
    --gold: #D4AF37;
    --gold-muted: #C5A059;
    --hairline: rgba(15, 23, 42, 0.10);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --font: 'Hanken Grotesk', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  :global(body) { background: var(--paper); color: var(--midnight); }

  h1, h2, h3 { margin: 0; font-family: var(--font); color: var(--midnight); letter-spacing: -0.02em; font-weight: 700; }
  p { margin: 0; }
  section { scroll-margin-top: 5rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .section-wrap { max-width: 1280px; margin: 0 auto; padding: 0 clamp(1rem, 5vw, 5rem); }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 0.65rem; margin: 0 0 1.25rem;
    color: var(--gold-muted); font-family: var(--font); font-size: 0.75rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
  }
  .eyebrow::before { width: 1.75rem; height: 1px; background: var(--gold-muted); content: ""; flex-shrink: 0; }

  .section-head { max-width: 48rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .section-head h2 { font-size: clamp(1.75rem, 3.5vw, 2.6rem); line-height: 1.15; font-weight: 600; margin-bottom: 1rem; }
  .section-note { color: var(--slate); font-size: 1.05rem; line-height: 1.7; }
  .section-note a, .fine a { color: var(--midnight); text-decoration-color: var(--gold); text-underline-offset: 3px; }

  /* Buttons */
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }
  .btn-primary, .btn-ghost {
    display: inline-flex; align-items: center; gap: 0.6rem; min-height: 3.1rem; padding: 0 1.6rem;
    border-radius: 2px; font-family: var(--font); font-size: 0.9rem; font-weight: 600; text-decoration: none;
    transition: all 250ms var(--ease);
  }
  .btn-primary { background: var(--midnight); color: var(--paper); border: 1px solid var(--midnight); }
  .btn-primary:hover { background: #1E293B; transform: translateY(-1px); }
  .btn-arrow { color: var(--gold); transition: transform 250ms var(--ease); }
  .btn-primary:hover .btn-arrow { transform: translateX(3px); }
  .btn-ghost { color: var(--midnight); border: 1px solid var(--hairline); background: transparent; }
  .btn-ghost:hover { border-color: var(--gold); }
  .btn-block { width: 100%; justify-content: center; }

  /* Hero */
  .hero { padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--hairline); }
  .hero-inner {
    max-width: 1280px; margin: 0 auto; padding: 0 clamp(1rem, 5vw, 5rem);
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr); gap: clamp(2rem, 4vw, 4rem); align-items: center;
  }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1.5rem; padding: 0; list-style: none; font-size: 0.8rem; color: var(--slate-muted); }
  .crumbs li + li::before { content: "/"; margin-right: 0.4rem; color: var(--hairline); }
  .crumbs a { color: var(--slate-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--midnight); }
  h1 {
    font-size: clamp(2.1rem, 4vw, 3.25rem); line-height: 1.12; margin-bottom: 1.25rem;
    max-width: 100%; overflow-wrap: anywhere; text-wrap: balance;
  }
  .lede { color: var(--slate); font-size: clamp(1rem, 1.3vw, 1.1rem); line-height: 1.7; max-width: 38rem; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: 0.6rem; max-width: 46rem; margin: 1.6rem 0 0; padding: 0; list-style: none; }
  .facts li { display: grid; gap: 0.2rem; padding: 0.75rem 0.95rem; border: 1px solid var(--hairline); border-radius: 4px; background: #fff; }
  .facts strong { color: var(--gold-muted); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  .facts span { color: var(--midnight); font-weight: 600; font-size: 0.92rem; line-height: 1.4; }
  .hero-pills { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.75rem 0 0; padding: 1.5rem 0 0; border-top: 1px solid var(--hairline); list-style: none; }
  .hero-pills li { padding: 0.35rem 0.8rem; border: 1px solid var(--hairline); border-radius: 2px; color: var(--slate); font-size: 0.8rem; font-weight: 500; }
  .hero-origin { display: flex; align-items: center; gap: 0.5rem; margin-top: 1.25rem; color: var(--slate-muted); font-size: 0.8rem; font-weight: 500; }
  .origin-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }

  .quote-card {
    padding: clamp(1.5rem, 3vw, 2.25rem); background: var(--midnight); color: #F8F9FA; border-radius: 4px;
    box-shadow: 0 24px 50px -20px rgba(15, 23, 42, 0.45);
  }
  .quote-kicker { color: var(--gold); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 1rem; }
