// ---------- Link sources: only URLs that are actually built ----------

// /{city}/ pages exist only for cities with a content file (same rule [city].astro uses).
const builtCitySlugs = new Set(
  Object.keys(import.meta.glob("../../data/cities/content/*.ts")).map((p) => p.split("/").pop()!.replace(/\.ts$/, "")),
);
const builtCities = (cities as CityListing[]).filter((c) => builtCitySlugs.has(c.slug)).sort((a, b) => a.rank - b.rank);

// Static state hubs under /india/ (src/pages/india/{slug}/index.astro).
const indiaHubSlugs = new Set(Object.keys(import.meta.glob("./*/index.astro")).map((p) => p.split("/")[1]));

interface PlaceLink { name: string; href: string }

function hubFor(state: string): PlaceLink | undefined {
  const region = itServicesRegions.find((r) => r.name === state);
  if (!region) return undefined;
  return { name: state, href: indiaHubSlugs.has(region.slug) ? `/india/${region.slug}/` : regionPath(region) };
}

/** City pages for a state: /{city}/ pages first, else the /it-services/ city pages. */
function cityLinksFor(state: string): PlaceLink[] {
  const built = builtCities.filter((c) => c.state === state).map((c) => ({ name: c.name, href: `/${c.slug}/` }));
  if (built.length) return built;
  const region = itServicesRegions.find((r) => r.name === state);
  return region ? region.cities.map((c) => ({ name: c.name, href: cityPath(region, c) })) : [];
}

