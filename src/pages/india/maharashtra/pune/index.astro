---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--maharashtra--pune");
const links = uniqueLinks([
  { name: "Maharashtra", href: "/india/maharashtra/" },
  { name: "Mumbai", href: "/india/maharashtra/mumbai/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Pune"
  state="Maharashtra"
  areaType="City"
  path="/india/maharashtra/pune/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Maharashtra", href: "/india/maharashtra/" }, { label: "Pune", href: "/india/maharashtra/pune/" }]}
  content={content}
  links={links}
/>
