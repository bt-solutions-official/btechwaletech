---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--maharashtra");
const links = uniqueLinks([
  { name: "Mumbai", href: "/india/maharashtra/mumbai/" },
  { name: "Pune", href: "/india/maharashtra/pune/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Maharashtra"
  state="Maharashtra"
  areaType="State"
  path="/india/maharashtra/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Maharashtra", href: "/india/maharashtra/" }]}
  content={content}
  links={links}
/>
