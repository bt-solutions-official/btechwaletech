---
import LocationLayout from "@layouts/LocationLayout.astro";
import LocationCard from "@components/sections/LocationCard.astro";
import { indiaRegionPage } from "@data/page-seo/static-pages";
import { maharashtraCities } from "@data/countries/india/cities/maharashtra";
const page = indiaRegionPage("maharashtra");
---
<LocationLayout page={page}>{maharashtraCities.map((city) => <LocationCard title={city.name} href={city.path} />)}</LocationLayout>
