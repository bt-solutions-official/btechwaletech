---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--maharashtra--mumbai--web-development");
const links = uniqueLinks([
  { name: "Mumbai", href: "/india/maharashtra/mumbai/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Mumbai"
  state="Maharashtra"
  areaType="City"
  path="/india/maharashtra/mumbai/web-development/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Maharashtra", href: "/india/maharashtra/" }, { label: "Mumbai", href: "/india/maharashtra/mumbai/" }, { label: "Web Development", href: "/india/maharashtra/mumbai/web-development/" }]}
  content={content}
  links={links}
/>
