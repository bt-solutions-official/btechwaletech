---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--maharashtra--mumbai");
const links = uniqueLinks([
  { name: "Maharashtra", href: "/india/maharashtra/" },
  { name: "Mumbai Web Development", href: "/india/maharashtra/mumbai/web-development/" },
  { name: "Pune", href: "/india/maharashtra/pune/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Mumbai"
  state="Maharashtra"
  areaType="City"
  path="/india/maharashtra/mumbai/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Maharashtra", href: "/india/maharashtra/" }, { label: "Mumbai", href: "/india/maharashtra/mumbai/" }]}
  content={content}
  links={links}
/>
