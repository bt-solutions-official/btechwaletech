---
import LocationLayout from "@layouts/LocationLayout.astro";
import LocationCard from "@components/sections/LocationCard.astro";
import { indiaRegionPage } from "@data/page-seo/static-pages";
import { uttarPradeshCities } from "@data/countries/india/cities/uttar-pradesh";
const page = indiaRegionPage("uttar-pradesh");
---
<LocationLayout page={page}>{uttarPradeshCities.map((city) => <LocationCard title={city.name} href={city.path} />)}</LocationLayout>
