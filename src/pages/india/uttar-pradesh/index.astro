---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--uttar-pradesh");
const links = uniqueLinks([
  { name: "Lucknow", href: "/india/uttar-pradesh/lucknow/" },
  { name: "Noida", href: "/india/uttar-pradesh/noida/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Uttar Pradesh"
  state="Uttar Pradesh"
  areaType="State"
  path="/india/uttar-pradesh/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Uttar Pradesh", href: "/india/uttar-pradesh/" }]}
  content={content}
  links={links}
/>
