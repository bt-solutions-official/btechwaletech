---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--uttar-pradesh--lucknow");
const links = uniqueLinks([
  { name: "Uttar Pradesh", href: "/india/uttar-pradesh/" },
  { name: "Noida", href: "/india/uttar-pradesh/noida/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Lucknow"
  state="Uttar Pradesh"
  areaType="City"
  path="/india/uttar-pradesh/lucknow/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Uttar Pradesh", href: "/india/uttar-pradesh/" }, { label: "Lucknow", href: "/india/uttar-pradesh/lucknow/" }]}
  content={content}
  links={links}
/>
