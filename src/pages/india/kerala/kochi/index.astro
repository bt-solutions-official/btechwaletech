---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--kerala--kochi");
const links = uniqueLinks([
  { name: "Kerala", href: "/india/kerala/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Kochi"
  state="Kerala"
  areaType="City"
  path="/india/kerala/kochi/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Kerala", href: "/india/kerala/" }, { label: "Kochi", href: "/india/kerala/kochi/" }]}
  content={content}
  links={links}
/>
