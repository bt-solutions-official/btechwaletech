---
import LocationLayout from "@layouts/LocationLayout.astro";
import LocationCard from "@components/sections/LocationCard.astro";
import { indiaRegionPage } from "@data/page-seo/static-pages";
import { keralaCities } from "@data/countries/india/cities/kerala";
const page = indiaRegionPage("kerala");
---
<LocationLayout page={page}>{keralaCities.map((city) => <LocationCard title={city.name} href={city.path} />)}</LocationLayout>
