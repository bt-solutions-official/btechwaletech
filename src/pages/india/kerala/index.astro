---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--kerala");
const links = uniqueLinks([
  { name: "Kochi", href: "/india/kerala/kochi/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Kerala"
  state="Kerala"
  areaType="State"
  path="/india/kerala/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Kerala", href: "/india/kerala/" }]}
  content={content}
  links={links}
/>
