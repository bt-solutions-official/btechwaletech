---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--rajasthan");
const links = uniqueLinks([
  { name: "Jaipur", href: "/india/rajasthan/jaipur/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Rajasthan"
  state="Rajasthan"
  areaType="State"
  path="/india/rajasthan/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Rajasthan", href: "/india/rajasthan/" }]}
  content={content}
  links={links}
/>
