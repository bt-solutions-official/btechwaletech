---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--rajasthan--jaipur");
const links = uniqueLinks([
  { name: "Rajasthan", href: "/india/rajasthan/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Jaipur"
  state="Rajasthan"
  areaType="City"
  path="/india/rajasthan/jaipur/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Rajasthan", href: "/india/rajasthan/" }, { label: "Jaipur", href: "/india/rajasthan/jaipur/" }]}
  content={content}
  links={links}
/>
