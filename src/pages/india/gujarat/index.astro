---
import LocationLayout from "@layouts/LocationLayout.astro";
import LocationCard from "@components/sections/LocationCard.astro";
import { indiaRegionPage } from "@data/page-seo/static-pages";
import { gujaratCities } from "@data/countries/india/cities/gujarat";
const page = indiaRegionPage("gujarat");
---
<LocationLayout page={page}>{gujaratCities.map((city) => <LocationCard title={city.name} href={city.path} />)}</LocationLayout>
