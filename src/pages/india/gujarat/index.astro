---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--gujarat");
const links = uniqueLinks([
  { name: "Ahmedabad", href: "/india/gujarat/ahmedabad/" },
  { name: "Website development guides for Gujarat", href: "/gujarat/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Gujarat"
  state="Gujarat"
  areaType="State"
  path="/india/gujarat/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Gujarat", href: "/india/gujarat/" }]}
  content={content}
  links={links}
/>
