---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--gujarat--ahmedabad");
const links = uniqueLinks([
  { name: "Gujarat", href: "/india/gujarat/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Ahmedabad"
  state="Gujarat"
  areaType="City"
  path="/india/gujarat/ahmedabad/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Gujarat", href: "/india/gujarat/" }, { label: "Ahmedabad", href: "/india/gujarat/ahmedabad/" }]}
  content={content}
  links={links}
/>
