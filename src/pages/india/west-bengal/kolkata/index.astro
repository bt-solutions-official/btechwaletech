---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--west-bengal--kolkata");
const links = uniqueLinks([
  { name: "West Bengal", href: "/india/west-bengal/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Kolkata"
  state="West Bengal"
  areaType="City"
  path="/india/west-bengal/kolkata/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "West Bengal", href: "/india/west-bengal/" }, { label: "Kolkata", href: "/india/west-bengal/kolkata/" }]}
  content={content}
  links={links}
/>
