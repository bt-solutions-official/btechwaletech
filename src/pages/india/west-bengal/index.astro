---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--west-bengal");
const links = uniqueLinks([
  { name: "Kolkata", href: "/india/west-bengal/kolkata/" },
], cityLinks(content.nearby));
---

<CityPage
  name="West Bengal"
  state="West Bengal"
  areaType="State"
  path="/india/west-bengal/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "West Bengal", href: "/india/west-bengal/" }]}
  content={content}
  links={links}
/>
