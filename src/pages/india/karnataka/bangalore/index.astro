---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--karnataka--bangalore");
const links = uniqueLinks([
  { name: "Karnataka", href: "/india/karnataka/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Bangalore"
  state="Karnataka"
  areaType="City"
  path="/india/karnataka/bangalore/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Karnataka", href: "/india/karnataka/" }, { label: "Bangalore", href: "/india/karnataka/bangalore/" }]}
  content={content}
  links={links}
/>
