---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--karnataka");
const links = uniqueLinks([
  { name: "Bangalore", href: "/india/karnataka/bangalore/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Karnataka"
  state="Karnataka"
  areaType="State"
  path="/india/karnataka/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Karnataka", href: "/india/karnataka/" }]}
  content={content}
  links={links}
/>
