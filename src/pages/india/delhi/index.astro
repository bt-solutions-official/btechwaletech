---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--delhi");
const links = uniqueLinks([

], cityLinks(content.nearby));
---

<CityPage
  name="Delhi"
  state="Delhi"
  areaType="City"
  path="/india/delhi/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Delhi", href: "/india/delhi/" }]}
  content={content}
  links={links}
/>
