---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--haryana");
const links = uniqueLinks([
  { name: "Faridabad", href: "/india/haryana/faridabad/" },
  { name: "Gurgaon", href: "/india/haryana/gurgaon/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Haryana"
  state="Haryana"
  areaType="State"
  path="/india/haryana/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Haryana", href: "/india/haryana/" }]}
  content={content}
  links={links}
/>
