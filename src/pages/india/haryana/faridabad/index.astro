---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--haryana--faridabad");
const links = uniqueLinks([
  { name: "Haryana", href: "/india/haryana/" },
  { name: "Gurgaon", href: "/india/haryana/gurgaon/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Faridabad"
  state="Haryana"
  areaType="City"
  path="/india/haryana/faridabad/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Haryana", href: "/india/haryana/" }, { label: "Faridabad", href: "/india/haryana/faridabad/" }]}
  content={content}
  links={links}
/>
