---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";

const content = locationContent("india--haryana--gurgaon--web-development");
const links = uniqueLinks([
  { name: "Gurgaon", href: "/india/haryana/gurgaon/" },
  { name: "Gurgaon SEO Services", href: "/india/haryana/gurgaon/seo-services/" },
], cityLinks(content.nearby));
---

<CityPage
  name="Gurgaon"
  state="Haryana"
  areaType="City"
  path="/india/haryana/gurgaon/web-development/"
  crumbs={[{ label: "India", href: "/india/" }, { label: "Haryana", href: "/india/haryana/" }, { label: "Gurgaon", href: "/india/haryana/gurgaon/" }, { label: "Web Development", href: "/india/haryana/gurgaon/web-development/" }]}
  content={content}
  links={links}
/>
