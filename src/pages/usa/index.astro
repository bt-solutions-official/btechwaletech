import { siteBrand, siteContact } from "@data/site/site-config";
import { pricingPlans, usdPrice } from "@data/pricing/plans";
import { countryOgImage, usd } from "@data/countries/international";

// Starting prices in USD, always derived from the single pricing source.
const P = {
  site: usd("Static"),
  seoSite: usd("SEO website"),
  shop: usd("Ecommerce"),
  app: usd("Custom web app"),
  ai: usd("AI automation"),
  seo: usd("Monthly SEO"),
  care: usd("Maintenance"),
};
const updated = "2026-09-21";

// ---------- FAQ (visible list and FAQPage schema share this array) ----------

