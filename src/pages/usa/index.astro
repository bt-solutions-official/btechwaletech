  ["North Dakota", "Midwest", "Fargo, Bismarck", "Central (southwest Mountain)"],
  ["Ohio", "Midwest", "Columbus, Cleveland, Cincinnati", "Eastern"],
  ["Oklahoma", "Southwest", "Oklahoma City, Tulsa", "Central"],
  ["Oregon", "West", "Portland, Eugene, Bend", "Pacific"],
  ["Pennsylvania", "Northeast", "Philadelphia, Pittsburgh, Harrisburg", "Eastern"],
  ["Rhode Island", "Northeast", "Providence", "Eastern"],
  ["South Carolina", "Southeast", "Charleston, Columbia, Greenville", "Eastern"],
  ["South Dakota", "Midwest", "Sioux Falls, Rapid City", "Central and Mountain"],
  ["Tennessee", "Southeast", "Nashville, Memphis, Knoxville, Chattanooga", "Central and Eastern"],
  ["Texas", "Southwest", "Houston, Dallas, Austin, San Antonio", "Central (El Paso Mountain)"],
  ["Utah", "West", "Salt Lake City, Provo, Ogden", "Mountain"],
  ["Vermont", "Northeast", "Burlington", "Eastern"],
  ["Virginia", "Southeast", "Virginia Beach, Richmond, Arlington", "Eastern"],
  ["Washington", "West", "Seattle, Spokane, Tacoma, Bellevue", "Pacific"],
  ["West Virginia", "Southeast", "Charleston, Morgantown", "Eastern"],
  ["Wisconsin", "Midwest", "Milwaukee, Madison, Green Bay", "Central"],
  ["Wyoming", "West", "Cheyenne, Casper, Jackson", "Mountain"],
];

// Regions at a glance (cards, not links: we have no US city pages).
const regionCards = [
  { name: "Northeast & Mid-Atlantic", note: "Finance, law, healthcare, universities and biotech from Boston to D.C. Eastern time, best call overlap." },
  { name: "Southeast", note: "Home services, real estate, hospitality and logistics; Spanish pages often needed in Florida." },
  { name: "Midwest", note: "Manufacturers, distributors, insurers and agribusiness moving catalogs off PDFs." },
  { name: "Southwest", note: "Texas home services and energy, Arizona growth, Las Vegas hospitality, bilingual audiences." },
  { name: "West Coast & Mountain West", note: "SaaS MVPs, DTC ecommerce and cloud apps; early-morning Pacific calls." },
  { name: "Alaska & Hawaii", note: "Seasonal tourism and local services; late-afternoon calls on your side." },
];

const siblingLinks = [
  { name: "All countries we serve", href: "/countries/" },
  { name: "IT services in Japan", href: "/japan/" },
  { name: "Canada", href: "/canada/" },
  { name: "United Kingdom", href: "/uk/" },
  { name: "Australia", href: "/australia/" },
  { name: "UAE", href: "/uae/" },
  { name: "India", href: "/india/" },
];

const guideToc = guide.map((g) => ({ id: g.id, heading: g.heading }));
const regionToc = regions.map((r) => ({ id: `region-${r.id}`, heading: r.name }));

// ---------- Structured data ----------

const url = canonicalUrl(page.canonicalPath);
const usa = { "@type": "Country", name: "United States" };
const allStates = stateRows.map(([name]) => name);
const topMetros = [
  "New York City", "Los Angeles", "Chicago", "Houston", "Dallas", "Austin", "San Antonio", "Phoenix", "Philadelphia",
  "San Diego", "San Jose", "San Francisco", "Seattle", "Denver", "Boston", "Washington", "Atlanta", "Miami",
  "Tampa", "Orlando", "Charlotte", "Nashville", "Minneapolis", "Detroit", "Salt Lake City", "Las Vegas", "Portland",
];

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${url}#service`,
  name: `${siteBrand.name}: web development for US businesses`,
  url,
  image: new URL("/banner_logo.png", siteBrand.domain).toString(),
  description: page.description,
  email: siteContact.email,
  telephone: siteContact.phone,
  priceRange: `${P.care} – ${P.app}+`,
  currenciesAccepted: "USD",
  paymentAccepted: "Wise, Bank wire, PayPal",
  address: { "@type": "PostalAddress", addressCountry: "IN" },
  knowsLanguage: ["en"],
  areaServed: [
    usa,
    ...allStates.map((name) => ({ "@type": "State", name, containedInPlace: usa })),
    ...topMetros.map((name) => ({ "@type": "City", name, containedInPlace: usa })),
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Website development, SEO and IT services for US businesses (starting prices)",
    itemListElement: pricingPlans.map((plan) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: plan.name, description: plan.summary },
      areaServed: usa,
      priceSpecification: {
        "@type": "PriceSpecification",
        minPrice: Number(usdPrice(plan.price).replace(/[^\d]/g, "")),
        priceCurrency: "USD",
        ...(plan.unit ? { unitText: plan.unit } : {}),
      },
    })),
  },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${url}#webpage`,
  url,
  name: page.title,
  description: page.description,
  inLanguage: "en-US",
  dateModified: updated,
  about: { "@id": `${url}#service` },
  speakable: { "@type": "SpeakableSpecification", cssSelector: ["#quick-answer", "h1"] },
};
---

<BaseLayout meta={page} schema={[webPageSchema, professionalServiceSchema, breadcrumbListSchema(page.breadcrumbs), faqSchema(faqs)]}>

  <!-- ===================== HERO ===================== -->
  <section class="hero" aria-labelledby="usa-heading">
    <div class="hero-inner">
      <div class="hero-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {page.breadcrumbs.map((b, i) => (
              <li>{i + 1 === page.breadcrumbs.length ? <span aria-current="page">{b.label}</span> : <a href={b.href}>{b.label}</a>}</li>
            ))}
          </ol>
        </nav>
        <p class="eyebrow">United States · All 50 states</p>
        <h1 id="usa-heading">{page.h1}</h1>
        <p class="lede">{page.intro}</p>
        <ul class="facts" aria-label="Quick facts">
          {facts.map(([label, value]) => <li><strong>{label}</strong><span>{value}</span></li>)}
        </ul>
        <div class="hero-actions">
          <a class="btn-primary" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp for a free quote</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-ghost" href={siteContact.emailHref}>{siteContact.email}</a>
        </div>
        <ul class="hero-pills" aria-label="What we build">
          {pills.map((p) => <li>{p}</li>)}
        </ul>
        <p class="hero-origin">
          <span class="origin-dot" aria-hidden="true"></span>
          Team based in India &middot; Remote delivery to the US &middot; No US office
        </p>
      </div>

      <aside class="quote-card" aria-label="Starting prices in USD">
        <p class="quote-kicker">US starting prices</p>
        <ul class="quote-rows">
          {pricingPlans.slice(0, 5).map((plan) => (
            <li><span>{plan.name}</span><strong><small>from </small>{usdPrice(plan.price)}{plan.unit ? <small> /mo</small> : null}</strong></li>
          ))}
        </ul>
        <p class="quote-foot">All figures are starting prices in USD; your quote depends on requirements. 5 months maintenance free after launch.</p>
        <a class="btn-primary btn-block" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
          <span>Get my quote on WhatsApp</span><span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </aside>
    </div>
  </section>

  <!-- ===================== STATS ===================== -->
  <section class="stats-section" aria-label="BtechWaleTech for US businesses in numbers">
    <div class="section-wrap">
      <ul class="stat-band">
        {stats.map((s) => (
          <li><span class="stat-num">{s.value}</span><span class="stat-label">{s.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== QUICK ANSWER + SNAPSHOT ===================== -->
  <section class="answer" aria-labelledby="answer-heading">
    <div class="section-wrap answer-grid">
      <div>
        <p class="eyebrow">The short answer</p>
        <h2 id="answer-heading">Looking to hire web developers for a US business?</h2>
        <p id="quick-answer" class="answer-text">BtechWaleTech is a three-engineer team based in India that builds websites, ecommerce stores, SEO systems, custom software and AI automations for US businesses, working remotely. Websites start from {P.site}, ecommerce from {P.shop} and custom web apps from {P.app}. Every price is a starting price in USD, calls happen in your morning, and the first five months of maintenance after launch are free.</p>
        <p class="answer-more">The US is not one market. A roofing company in Dallas, a law firm in Manhattan and a SaaS founder in San Francisco need very different things from a website, and they sit up to six time zones apart. This page covers what we build, what it costs, how the time difference works, what US compliance topics we build around, and what businesses in each region typically need.</p>
        <p class="updated">Last updated <time datetime={updated}>September 21, 2026</time></p>
      </div>
      <table class="snapshot">
        <caption>BtechWaleTech for US clients at a glance</caption>
        <tbody>
          {snapshot.map((row) => (
            <tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="services" aria-labelledby="services-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Services for US businesses</p>
        <h2 id="services-heading">Everything your US business needs online, from one team</h2>
        <p class="section-note">Planning, design, development, SEO setup, hosting and deployment are handled end to end, so you are not coordinating a designer, a developer and an SEO consultant who each blame the other two.</p>
      </div>
      <div class="bento">
        {services.map((s) => {
          const inner = (
            <div class="card-core">
              <h3>{s.name}</h3>
              <p>{s.note}</p>
              {"href" in s && <span class="card-arrow" aria-hidden="true">&rarr;</span>}
            </div>
          );
          return "href" in s ? <a class={`card card-${s.size}`} href={s.href}>{inner}</a> : <div class={`card card-${s.size}`}>{inner}</div>;
        })}
      </div>
    </div>
  </section>

  <!-- ===================== WHY US ===================== -->
  <section class="advantage" aria-labelledby="why-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Why choose us</p>
        <h2 id="why-heading">US agency vs freelancer vs BtechWaleTech</h2>
        <p class="section-note">A fair comparison of typical trade-offs, not a judgment on any particular firm. Good agencies and good freelancers exist; this is about how the models usually work.</p>
      </div>
      <div class="comparison-table-wrap">
        <table class="comparison-table">
          <caption class="sr-only">Comparison of a local US agency, a freelancer and BtechWaleTech</caption>
          <thead>
            <tr>
              <th scope="col">What matters</th>
              <th scope="col" class="col-other">Local US agency</th>
              <th scope="col" class="col-other hide-sm">Freelancer</th>
              <th scope="col" class="col-us">BtechWaleTech</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map(([aspect, agency, freelancer, us]) => (
              <tr>
                <th scope="row" class="td-aspect">{aspect}</th>
                <td class="col-other">{agency}</td>
                <td class="col-other hide-sm">{freelancer}</td>
                <td class="td-us"><span class="td-us-inner"><span class="td-check" aria-hidden="true">✓</span>{us}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine">If you need in-person workshops, a US contracting entity or a large team on call around the clock, a local agency is the better choice, and we will say so.</p>
    </div>
  </section>

  <!-- ===================== PRICING ===================== -->
  <section class="pricing" aria-labelledby="pricing-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Pricing</p>
        <h2 id="pricing-heading">Web development cost for US businesses: starting prices in USD</h2>
        <p class="section-note">Every figure below is a starting price. The final quote depends on your requirements: pages, content, payments, logins, integrations, languages and deadlines. You get an itemized quote before any work begins.</p>
      </div>
      <div class="comparison-table-wrap">
        <table class="price-table">
          <caption class="sr-only">Starting prices in USD for BtechWaleTech services</caption>
          <thead>
            <tr><th scope="col">Service</th><th scope="col">Starts from</th><th scope="col">Typical timeline</th><th scope="col">What is included</th></tr>
          </thead>
          <tbody>
            {pricingPlans.map((plan) => (
              <tr>
                <th scope="row">{plan.name}</th>
                <td class="price"><small>from </small>{usdPrice(plan.price)}{plan.unit && <small> {plan.unit}</small>}</td>
                <td>{plan.timeline}</td>
                <td>{plan.includes.join(" · ")}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine">All prices are starting points, not fixed quotes; the final cost depends on requirements. Invoiced in USD and paid by Wise, wire or PayPal; invoicing in another currency through Wise or wire is available on request. <a href="/pricing/">See full pricing</a>.</p>
    </div>
  </section>

  <!-- ===================== LONG-FORM GUIDE ===================== -->
  <section class="guide" aria-label="Guide to hiring web developers for a US business">
    <div class="section-wrap guide-grid">
      <nav class="toc" aria-label="On this page">
        <p class="toc-title">On this page</p>
        <ol>
          {guideToc.map((t) => <li><a href={`#${t.id}`}>{t.heading}</a></li>)}
          {regionToc.map((t) => <li><a href={`#${t.id}`}>{t.heading}</a></li>)}
          <li><a href="#states-heading">State-by-state table</a></li>
          <li><a href="#zones-heading">Time-zone table</a></li>
          <li><a href="#industries-heading">Industries</a></li>
          <li><a href="#process-heading">Process and timelines</a></li>
          <li><a href="#faq-heading">FAQs</a></li>
        </ol>
      </nav>
      <div class="prose">
        {guide.map((g) => (
          <article aria-labelledby={g.id}>
            <h2 id={g.id}>{g.heading}</h2>
            {g.paragraphs.map((p) => <p set:html={p} />)}
            {"list" in g && g.list && <ul>{g.list.map((li) => <li set:html={li} />)}</ul>}
            {"after" in g && g.after && g.after.map((p) => <p set:html={p} />)}
          </article>
        ))}

        {regions.map((r) => (
          <article aria-labelledby={`region-${r.id}`}>
            <h2 id={`region-${r.id}`}>{r.name}: what businesses need online</h2>
            <p>{r.intro}</p>
            {r.states.map((s) => (
              <div class="state-block">
                <h3>{s.name}</h3>
                <p>{s.text}</p>
              </div>
            ))}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== REGIONS AT A GLANCE ===================== -->
  <section class="locations" aria-labelledby="areas-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Areas we serve</p>
        <h2 id="areas-heading">IT services, websites, SEO and AI automation across the US</h2>
        <p class="section-note">Every region is served remotely from India. There are no US offices behind these cards, just the same team and process wherever you are.</p>
      </div>
      <ul class="area-grid">
        {regionCards.map((c) => <li><h3>{c.name}</h3><p>{c.note}</p></li>)}
      </ul>
    </div>
  </section>

  <!-- ===================== STATE TABLE ===================== -->
  <section class="industries" aria-labelledby="states-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">State by state</p>
        <h2 id="states-heading">All 50 states and D.C.: main metros and time zones</h2>
        <p class="section-note">Where each state sits in our regional grouping, its main metro areas and its time zone, which decides your call window with us.</p>
      </div>
      <div class="comparison-table-wrap">
        <table class="price-table fit-sm">
          <caption class="sr-only">US states with region, main metros and time zone</caption>
          <thead>
            <tr><th scope="col">State</th><th scope="col" class="hide-sm">Region</th><th scope="col">Main metros</th><th scope="col">Time zone</th></tr>
          </thead>
          <tbody>
            {stateRows.map(([state, region, metros, tz]) => (
              <tr><th scope="row">{state}</th><td class="hide-sm">{region}</td><td>{metros}</td><td>{tz}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===================== TIME ZONES ===================== -->
  <section class="pricing" aria-labelledby="zones-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Time zones</p>
        <h2 id="zones-heading">Call windows for every US time zone</h2>
        <p class="section-note">India does not change its clocks, so the gap moves by an hour when the US switches between daylight and standard time in March and November. The IST column assumes US daylight time.</p>
      </div>
      <div class="comparison-table-wrap">
        <table class="price-table fit-sm">
          <caption class="sr-only">Time difference and call windows between US time zones and India</caption>
          <thead><tr><th scope="col">US time zone</th><th scope="col" class="hide-sm">India is ahead by</th><th scope="col">Call window (your time)</th><th scope="col">Same window in India</th></tr></thead>
          <tbody>
            {zones.map((z) => (
              <tr><th scope="row">{z.zone}</th><td class="hide-sm">{z.gap}</td><td>{z.window}</td><td>{z.ist}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===================== INDUSTRIES ===================== -->
  <section class="industries" aria-labelledby="industries-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Industries</p>
        <h2 id="industries-heading">What we build for US industries</h2>
        <p class="section-note">Concrete website and SEO needs by sector. The <a href="/industries/">industries page</a> goes further.</p>
      </div>
      <div class="comparison-table-wrap">
        <table class="price-table">
          <thead><tr><th scope="col">Industry</th><th scope="col">What buyers look for</th><th scope="col">What we build</th></tr></thead>
          <tbody>
            {industries.map((i) => (
              <tr><th scope="row">{i.name}</th><td>{i.need}</td><td>{i.build}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===================== PROCESS ===================== -->
  <section class="process" aria-labelledby="process-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="process-heading">From first message to a live site</h2>
      </div>
      <ol class="steps steps-six">
        {process.map(([step, detail], i) => (
          <li><span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span><h3>{step}</h3><p>{detail}</p></li>
        ))}
      </ol>
      <div class="comparison-table-wrap timeline-wrap">
        <table class="price-table fit-sm">
          <caption class="sr-only">Typical project timelines</caption>
          <thead><tr><th scope="col">Project</th><th scope="col">Typical timeline</th><th scope="col" class="hide-sm">What it covers</th></tr></thead>
          <tbody>
            {pricingPlans.map((plan) => (
              <tr><th scope="row">{plan.name}</th><td>{plan.timeline}</td><td class="hide-sm">{plan.summary}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine">Timelines assume content and approvals arrive on time. Payments, sales tax rules, user accounts and accessibility audits add testing time to ecommerce and custom builds.</p>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="faq" aria-labelledby="faq-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-heading">Hiring web developers for a US business: questions, answered</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary><span>{f.question}</span><span class="faq-mark" aria-hidden="true">+</span></summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== RELATED ===================== -->
  <section class="locations" aria-labelledby="related-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Other markets</p>
        <h2 id="related-heading">IT services, websites, SEO and AI automation in other countries</h2>
      </div>
      <div class="city-cloud">
        {siblingLinks.map((c) => <a class="city-chip" href={c.href}>{c.name}</a>)}
      </div>
    </div>
  </section>

  <!-- ===================== CLOSING CTA ===================== -->
  <section class="closing" aria-labelledby="cta-heading">
    <div class="section-wrap">
      <div class="closing-inner">
        <p class="eyebrow">Next step</p>
        <h2 id="cta-heading">Tell us what you want built, wherever you are in the US</h2>
        <p class="closing-note">
          Send a few lines about your business on WhatsApp or email. You get questions first, then a page plan, a timeline and an itemized quote in USD.
          Nothing is billed until you approve it, and five months of maintenance are included after launch.
        </p>
        <div class="hero-actions closing-actions">
          <a class="btn-primary" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp us</span><span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-ghost" href={siteContact.emailHref}>{siteContact.email}</a>
        </div>
        <p class="closing-links">
          <a href="/services/">All services</a> · <a href="/services/web-development/">Web development</a> · <a href="/services/seo-services/">SEO services</a> ·
          <a href="/pricing/">Pricing</a> · <a href="/portfolio/">Portfolio</a> · <a href="/about/">About</a> · <a href="/countries/">Countries</a> ·
          <a href="/india/">India</a> · <a href="/contact/">Contact</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Tokens and section styles mirror src/pages/[city].astro so country pages match the city pages. */
  :root {
    --paper: #FDFCFB;
    --surface: #F8F9FA;
    --surface-low: #F3F4F5;
    --midnight: #0F172A;
    --slate: #334155;
    --slate-muted: #64748B;
    --gold: #D4AF37;
    --gold-muted: #C5A059;
    --hairline: rgba(15, 23, 42, 0.10);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --font: 'Hanken Grotesk', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  :global(body) { background: var(--paper); color: var(--midnight); }

  h1, h2, h3 { margin: 0; font-family: var(--font); color: var(--midnight); letter-spacing: -0.02em; font-weight: 700; }
  p { margin: 0; }
  section { scroll-margin-top: 5rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

  .section-wrap { max-width: 1280px; margin: 0 auto; padding: 0 clamp(1rem, 5vw, 5rem); }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 0.65rem; margin: 0 0 1.25rem;
    color: var(--gold-muted); font-family: var(--font); font-size: 0.75rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
  }
  .eyebrow::before { width: 1.75rem; height: 1px; background: var(--gold-muted); content: ""; flex-shrink: 0; }

