---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/common/Breadcrumbs.astro";
import "@styles/it-services.css";
import { createPageSeo } from "@lib/seo/seo-config";
import { createBreadcrumbs } from "@lib/breadcrumbs/breadcrumbs";
import { breadcrumbListSchema, faqSchema, serviceSchema } from "@lib/schema/schema";
import { siteContact } from "@data/site/site-config";

const faqs = [
  {
    question: "How quickly do you reply to an enquiry?",
    answer: "We read every email ourselves, so replies usually land within one working day, and often the same evening. If you write on a Sunday or during a festival week, allow an extra day. A phone call gets a faster answer for simple questions like availability or a rough price band, but anything involving scope is better sent in writing.",
  },
  {
    question: "Will you sign an NDA before we discuss the project?",
    answer: "Yes. Send your own NDA and we will read it, sign it, and return it, usually within a day. If you do not have one, tell us and we will keep the details confidential anyway. We never publish client work, screenshots, or names without written permission, and we do not reuse your content or data on any other project.",
  },
  {
    question: "Do you work fully remote, or do you need to meet in person?",
    answer: "We work fully remote. Everything runs over email, phone, WhatsApp, and video calls, with written notes after each conversation so nothing depends on memory. That is how we serve clients across India and abroad without adding travel cost to your quote. We do not maintain offices, and we never claim a local presence we do not have.",
  },
  {
    question: "Can we start with something small before committing to a big build?",
    answer: "That is usually the sensible route. A static website from ₹5,000 or a small automation lets you see how we write, how we communicate, and how we handle revisions. If it goes well, the same code and hosting can grow into a larger site or app. Nothing about a small first project locks you into a bigger one later.",
  },
  {
    question: "Who owns the website, code, and accounts when the work is done?",
    answer: "You do. Domain, hosting, repository, analytics, and any third-party accounts are registered in your name or handed over to you at launch. We do not hold your domain hostage, and we do not charge a release fee. If you ever move to another developer, everything they need is already in your accounts, documented and accessible.",
  },
  {
    question: "What information should I have ready before contacting you?",
    answer: "A one-line description of what the site or tool should do, a rough page or feature list, your target launch month, and a budget band you are comfortable with. Your existing website URL helps a lot if you have one. None of this needs polish. A messy list in an email is far more useful than waiting until you have a perfect brief.",
  },
  {
    question: "Do you charge for the first conversation or the estimate?",
    answer: "No. The discovery call, the written scope note, and the itemised estimate are free. We only invoice once you approve the scope and the project starts. If our estimate does not suit your budget, you are welcome to keep the scope note and take it elsewhere. We would rather be honest early than pad a number to win work.",
  },
  {
    question: "What is included after the site goes live?",
    answer: "Five months of maintenance come free with every hosted project: content updates, bug fixes, security patches, backups, and uptime and speed checks. After that, ongoing maintenance starts from ₹2,000 per month. Monthly SEO, if you want it, starts from ₹5,000 per month and is quoted separately so you can stop or continue as you like.",
  },
];

const page = createPageSeo({
  title: "Contact Our Freelance Web Development Team In India",
  description: "Contact BtechWaleTech by email or phone to hire freelance web developers in India. End-to-end builds, honest estimates, and 5 months free maintenance after launch.",
  canonicalPath: "/contact/",
  h1: "Get In Touch With The BtechWaleTech Team",
  intro: "Three freelance engineers, one inbox, and no sales layer in between. Tell us what you want built, roughly when you need it live, and what you can spend. You will get a straight reply from the person who would actually do the work.",
  breadcrumbs: createBreadcrumbs([{ label: "Contact", href: "/contact/" }]),
  keywords: [
    "contact BtechWaleTech",
    "hire freelance web developer India",
    "freelance web developer contact",
    "freelance IT team India",
    "website development enquiry",
    "get a website quote India",
    "freelance developer email",
    "hire Astro developer India",
    "freelance AI automation developer",
    "website cost estimate India",
    "SEO website enquiry",
    "ecommerce website quote India",
    "custom web app enquiry",
    "remote web development India",
    "freelance developers Delhi NCR",
    "freelance developers Bangalore",
    "freelance developers Mumbai",
    "hire developer for small business",
    "startup website developer India",
    "website maintenance enquiry",
    "free maintenance web development",
    "web development consultation India",
    "talk to a web developer",
    "project scope and estimate",
    "NDA freelance developer India",
    "international web development India",
  ],
});
---

<BaseLayout meta={page} schema={[breadcrumbListSchema(page.breadcrumbs), faqSchema(faqs), serviceSchema(page.title, page.description, page.canonicalPath)]}>
  <div class="it-location">
    <div class="it-wrap">
      <div class="it-breadcrumb"><Breadcrumbs items={page.breadcrumbs} /></div>

      <section class="it-hero">
        <p class="it-eyebrow">Contact</p>
        <h1>{page.h1}</h1>
        <p class="it-hero-copy">{page.intro}</p>
        <div class="it-contact-block">
          <p class="it-contact-lead">Contact us and share your project idea</p>
          <div class="it-contact-links">
            <a href={siteContact.emailHref} data-icon="✉">{siteContact.email}</a>
            <a href={siteContact.phoneHref} data-icon="☏">{siteContact.phone}</a>
          </div>
        </div>
      </section>

      <section class="it-section" aria-labelledby="reach-heading">
        <div class="it-text-block">
          <article>
            <h2 id="reach-heading">How To Reach BtechWaleTech</h2>
            <p>There are two ways in, and both land with the same three people. Email is best for anything with detail attached: a page list, a screenshot of a competitor site, a spreadsheet of products, a half-written brief. Write to <a href={siteContact.emailHref}>{siteContact.email}</a> and you will have a written trail from the very first message, which matters later when we are agreeing scope. Phone or WhatsApp on <a href={siteContact.phoneHref}>{siteContact.phone}</a> suits quick questions: are you free in September, do you build in WordPress or Astro, is ₹15,000 realistic for what I described. Call during Indian business hours where you can, and if we are heads-down in a build we will call back the same day.</p>
            <p>We do not run a call centre and there is no account manager who takes your brief and passes it along. The person who reads your email is the person who will estimate the job and, in most cases, write the code. That keeps the conversation short and the answers accurate. It also means we occasionally say no. If your project needs a team of ten, a native mobile app, or a technology none of us has shipped, we will tell you plainly rather than learn on your budget.</p>
          </article>
        </div>
      </section>

      <section class="it-section" aria-labelledby="enquiry-heading">
        <div class="it-text-block">
          <article>
            <h2 id="enquiry-heading">What To Include So The Reply Is Actually Useful</h2>
            <p>Most enquiries we receive say some version of "I need a website, how much." The honest answer to that is a shrug and a range so wide it helps nobody. Five extra lines in your first email turn that shrug into a real number. You do not need a formal brief or a document. Bullet points in the body of an email are perfect, and you can be vague about the parts you have not decided yet, as long as you say which parts those are.</p>
            <ul class="it-list">
              <li><strong>The goal.</strong> What should the site or tool do for the business: bring enquiries, sell products, replace a manual process, look credible to investors.</li>
              <li><strong>A page or feature list.</strong> Even a rough one. "Home, about, six service pages, blog, contact" tells us far more than "a small website."</li>
              <li><strong>Timeline.</strong> The month you want it live, and whether that date is fixed by something real like an exhibition, a funding round, or a season.</li>
              <li><strong>Budget range.</strong> A band is fine. It is not a negotiation tactic; it decides which approach we even propose.</li>
              <li><strong>Existing site URL.</strong> If you have one, send it. We will look at its speed, structure, and content before replying.</li>
              <li><strong>Who will maintain it.</strong> Whether someone on your side will edit content, or you want us handling everything.</li>
            </ul>
          </article>
          <article>
            <h3>Why We Ask About Budget First</h3>
            <p>A thirty-page SEO site from ₹10,000 and a custom web app from ₹40,000 are different jobs with different architectures, not the same job at two prices. If we guess your budget wrong, we spend a week designing something you were never going to buy, and you spend a week reading a proposal that was irrelevant from line one. Telling us "around ₹30,000, maybe ₹40,000 if it is worth it" is genuinely helpful. We will then tell you what fits inside that, what does not, and what could wait until phase two. Final cost always depends on scope, so the range is a starting point for a conversation rather than a quote.</p>
            <p>If your budget is below what the work realistically takes, we will say so and suggest a smaller first step instead of quietly cutting corners. A well-built five-page site beats a rushed thirty-page one every time, and the five-page version can grow later without being thrown away. Our <a href="/pricing/">pricing page</a> lists the starting figures openly so you can sanity-check your number before you even write to us.</p>
          </article>
        </div>
      </section>

      <section class="it-section" aria-labelledby="after-heading">
        <div class="it-text-block">
          <article>
            <h2 id="after-heading">What Happens After You Send The Enquiry</h2>
            <p>First, a reply. Usually within one working day, sometimes the same evening, and it will be a real reply rather than an automated acknowledgement. If your message had enough detail, that first email already contains a rough price band and an honest note about whether the timeline is achievable. If something is unclear, we ask two or three specific questions instead of sending a generic questionnaire.</p>
            <p>Second, a discovery conversation. Twenty to forty minutes on a call, sometimes less. We want to understand the business behind the website: who buys from you, what they ask before buying, what your competitors rank for, and what has failed before. This is where most of the useful decisions get made, and it is where clients often realise the thing they asked for is not quite the thing they need.</p>
          </article>
          <article>
            <h3>Scope Note, Then An Itemised Estimate</h3>
            <p>Third, we send a written scope note. Plain language, usually one to two pages: what we will build, what technology, what content you provide versus what we write, what is explicitly out of scope, and how many revision rounds are included. Reading it should feel boring, because everything in it was already discussed. Its job is to make sure two people who had a nice conversation actually agreed on the same thing.</p>
            <p>Fourth, the estimate, itemised line by line rather than one lump figure. Design, development, content and SEO setup, hosting and deployment, and any third-party costs like a domain or a payment gateway are listed separately so you can see what each part costs and cut anything you do not want. Payment is normally staged against milestones. Nothing is invoiced until you approve the scope, and the scope note plus estimate cost you nothing even if you decide not to proceed.</p>
          </article>
        </div>
      </section>

      <section class="it-section" aria-labelledby="quote-heading">
        <div class="it-text-block">
          <article>
            <h2 id="quote-heading">What We Can Quote On, And What It Starts From</h2>
            <p>We take projects end to end: planning, design, development, SEO setup, hosting, and deployment. One team owns the whole chain, so there is nobody to blame when the designer's file does not match the developer's build or the site goes live without a sitemap. After hosting goes live, five months of maintenance are included free, covering content updates, bug fixes, security updates, backups, and uptime and speed checks. After those five months, maintenance is from ₹2,000 per month if you want to keep us on.</p>
            <p>Starting prices: a static website from ₹5,000; a thirty-page SEO website taken from design to deployment from ₹10,000; AI automation from ₹15,000; ecommerce from ₹25,000; a custom web application from ₹40,000; monthly SEO from ₹5,000 per month; and maintenance from ₹2,000 per month. Every one of those is a starting point, and the final cost depends on scope, page count, integrations, and how much content we write rather than you supplying it. If you want detail on a specific line, the <a href="/services/web-development/">web development</a> and <a href="/services/seo-services/">SEO services</a> pages go deeper than a price list can.</p>
          </article>
        </div>
      </section>

      <section class="it-section" aria-labelledby="who-heading">
        <div class="it-text-block">
          <article>
            <h2 id="who-heading">Who You Will Be Talking To</h2>
            <p>BtechWaleTech is three freelance engineers who work together rather than an agency with a roster. Ankur Kumar handles full stack development: the front end you see, the back end behind it, databases, integrations, and deployment. Santosh Sharma covers AI and machine learning, AWS infrastructure, and data science, which is where the automation and model work sits. Vedansh Shrivastava runs project management alongside data science, AI, and automation, so scheduling, scope, and your weekly update come from one consistent place.</p>
            <p>Practically, that means your enquiry reaches the person best placed to answer it within a day, and you keep talking to that person. There is no handover from a salesperson to a delivery team, because there is no salesperson. You can read a fuller account of how the three of us work on the <a href="/about/">about page</a>, and see the kinds of problems we take on across the <a href="/services/">services</a> and <a href="/industries/">industries</a> pages.</p>
          </article>
        </div>
      </section>

      <section class="it-section" aria-labelledby="coverage-heading">
        <div class="it-text-block">
          <article>
            <h2 id="coverage-heading">Where We Work: Across India And Internationally</h2>
            <p>We work with businesses across India, and delivery is remote-friendly by design. Clients in Delhi, Gurugram, Noida, Mumbai, Pune, Bengaluru, Hyderabad, Chennai, Jaipur, Ahmedabad, Kolkata, Lucknow, Indore, Patna, and Kochi all get the same process, the same response times, and the same prices, because none of it depends on somebody driving to a meeting. We do not have offices or branches anywhere and we will never tell you otherwise; what we have is a working rhythm that suits distributed work.</p>
            <p>Internationally, we take projects from clients in the United States, the United Arab Emirates, and Australia. Time zones are handled with overlapping working hours and written updates, so you wake up to progress rather than chasing it. Payments, invoicing currency, and documentation are agreed before the project starts. For country-specific detail, see the <a href="/india/">India</a>, <a href="/usa/">USA</a>, <a href="/uae/">UAE</a>, and <a href="/australia/">Australia</a> pages.</p>
          </article>
        </div>
      </section>

      <section class="it-section" aria-labelledby="honest-heading">
        <div class="it-text-block">
          <article>
            <h2 id="honest-heading">How We Keep The Conversation Honest</h2>
            <p>We do not use urgency tactics. There is no discount that expires on Friday, no limited slot that is limited only until you hesitate, and no follow-up sequence that pesters you for a month. If we are genuinely booked until a certain month, we will say the month. If a deadline you have set is not achievable at the quality we would want to put our names to, we will say that too, and offer either a later date or a reduced first phase.</p>
            <p>We also do not invent proof. You will not find fabricated client logos, review counts, awards, or years-in-business claims anywhere on this site, because a freelance group that has been honest about its size is more useful to you than one that has not. What we can show you during a conversation is real work, real code, and a clear explanation of decisions. The <a href="/portfolio/">portfolio</a> and <a href="/case-studies/">case studies</a> pages carry what we are able to publish, and anything under NDA stays under NDA.</p>
          </article>
        </div>
      </section>

      <section class="it-section" aria-labelledby="related-heading">
        <div class="it-text-block">
          <article>
            <h2 id="related-heading">Related Pages</h2>
            <p>If you want to read a little more before writing to us, these pages cover pricing, scope, coverage, and the policies that govern how we work together.</p>
            <ul class="it-list">
              <li><a href="/pricing/">Pricing and starting figures for every service</a></li>
              <li><a href="/services/">All services we offer end to end</a></li>
              <li><a href="/services/web-development/">Web development services</a></li>
              <li><a href="/services/seo-services/">SEO services and monthly retainers</a></li>
              <li><a href="/it-services/">IT services across Indian states and cities</a></li>
              <li><a href="/india/delhi/">Web development for businesses in Delhi</a></li>
              <li><a href="/india/haryana/gurgaon/">Web development in Gurgaon</a></li>
              <li><a href="/india/maharashtra/mumbai/">Web development in Mumbai</a></li>
              <li><a href="/india/karnataka/bangalore/">Web development in Bangalore</a></li>
              <li><a href="/blog/">Notes and guides on the blog</a></li>
              <li><a href="/terms/">Terms of service</a></li>
              <li><a href="/refund-policy/">Refund policy</a></li>
            </ul>
          </article>
        </div>
      </section>

      <section class="it-section" aria-labelledby="faq-heading">
        <div class="it-section-head">
          <h2 id="faq-heading">Contact FAQs</h2>
          <p>The questions people ask most often before sending that first email.</p>
        </div>
        <div class="it-faq">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="it-section">
        <div class="it-cta">
          <h2>Send Us The Rough Version Of Your Idea</h2>
          <p>It does not need to be tidy. Tell us the goal, roughly what pages or features you imagine, when you want it live, and what you can spend. You will get a real reply, a free scope note, and an itemised estimate, with five months of maintenance included free once the site goes live.</p>
          <div class="it-contact-links it-contact-links-invert">
            <a href={siteContact.emailHref} data-icon="✉">{siteContact.email}</a>
            <a href={siteContact.phoneHref} data-icon="☏">{siteContact.phone}</a>
          </div>
          <div class="it-trust-links">
            <a href="/about/">About</a><a href="/pricing/">Pricing</a><a href="/services/">Services</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
