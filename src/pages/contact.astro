---
import BaseLayout from "@layouts/BaseLayout.astro";
import { staticPage } from "@data/page-seo/static-pages";
import { siteContact } from "@data/site/site-config";

const page = staticPage("/contact/", "Contact Btechwale");
---

<BaseLayout meta={page}>
  <main class="contact-page">
    <section class="contact-shell" aria-labelledby="contact-heading">
      <p class="contact-eyebrow">Project enquiries</p>
      <h1 id="contact-heading">{page.h1}</h1>
      <p>
        Contact BtechWaleTech for websites, software development, SEO, AI automation, ecommerce, data analysis,
        deployment, and maintenance work.
      </p>
      <div class="contact-actions" aria-label="Contact options">
        <a href={siteContact.emailHref}>{siteContact.email}</a>
        <a href={siteContact.phoneHref}>{siteContact.phone}</a>
      </div>
      <p class="contact-note">
        Please share your project type, business goal, preferred timeline, location, and any existing website or app link.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .contact-page {
    min-height: 58vh;
    padding: clamp(5rem, 10vw, 8rem) clamp(1rem, 5vw, 3rem);
    background: #f8f5ef;
  }

  .contact-shell {
    max-width: 760px;
    margin: 0 auto;
  }

  .contact-eyebrow {
    margin: 0 0 0.8rem;
    color: #0f9b86;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-shell h1 {
    margin: 0 0 1rem;
    color: #142330;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 0.96;
  }

  .contact-shell p {
    max-width: 640px;
    color: #52616b;
    font-size: clamp(1rem, 2vw, 1.18rem);
    line-height: 1.8;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.8rem 0;
  }

  .contact-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    padding: 0 1rem;
    border: 1px solid rgba(20, 35, 48, 0.12);
    border-radius: 999px;
    color: #142330;
    background: #ffffff;
    font-weight: 750;
    text-decoration: none;
  }

  .contact-actions a:hover,
  .contact-actions a:focus-visible {
    border-color: rgba(15, 155, 134, 0.35);
    color: #0f9b86;
  }

  .contact-note {
    font-size: 0.95rem;
  }
</style>
