    "アプリ開発 費用",
    "スマホアプリ 制作",
    "Flutter 開発",
  ],
});

const schema = japanServiceSchema({
  path,
  title: page.title,
  description: page.description,
  serviceName: "Android and iOS app development for businesses in Japan",
  serviceType: "Mobile app development",
  plans: ["Android", "Custom web app", "Maintenance"],
});

