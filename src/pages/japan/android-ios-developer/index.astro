  canonicalPath: path,
  h1: "Android and iOS app developer in Japan, serving Tokyo, Osaka, Nagoya and all 47 prefectures",
  intro: "BtechWaleTech is three engineers in India building Android and iOS apps for businesses in Japan: point card and member apps, booking apps for salons, clinics and restaurants, ecommerce and B2B ordering apps, and offline apps for field staff. We write one Flutter or React Native codebase for iPhone and Android, add the admin panel and API, and publish under your company's store accounts. We work remotely in English, with no account manager between you and the developers.",
  breadcrumbs: createBreadcrumbs([
    { label: "Countries", href: "/countries/" },
    { label: "Japan", href: "/japan/" },
    { label: "Android & iOS developer", href: path },
  ]),
  locale: "en_JP",
  ogImage: countryOgImage("BtechWaleTech, a remote Android and iOS app development team in India serving businesses in Japan"),
  keywords: [
    "app developer Japan",
    "Android app developer Japan",
    "iOS developer Tokyo",
    "iPhone app development Japan",
    "mobile app development team Japan",
    "hire app developer Japan",
    "app development cost Japan",
    "Flutter developer Japan",
