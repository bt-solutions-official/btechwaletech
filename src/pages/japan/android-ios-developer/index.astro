const quotePlans = ["Android", "Custom web app", "AI automation", "Maintenance"];
const quoteFoot = `USD starting prices; yen shown at ¥${JPY_PER_USD} to the dollar as a guide. Store fees, hosting and payment fees are paid by you directly. 5 months maintenance free after launch.`;

const stats = [
  { value: "1", label: "Codebase for iPhone and Android" },
