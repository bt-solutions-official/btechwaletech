// ---------- Pricing ----------

const pricingHeading = "App, web app and maintenance prices for Japan in USD and yen";
const pricingIntro = `All our starting prices in US dollars, with approximate yen at ¥${JPY_PER_USD} per dollar. For app projects the Android and iOS app plan is the main one; the custom web app, AI automation and maintenance plans cover heavier back ends, AI features and support after launch. Your written quote fixes the final amount in USD or JPY.`;
const pricingFine = `These are entry prices for a clearly defined first release, and your written quote replaces them. Yen figures use ¥${JPY_PER_USD} to the US dollar as a guide. Apple and Google developer fees, cloud hosting, push and SMS services, LINE plans, API usage and payment fees are billed to you directly by those providers. No Japanese consumption tax is added to our invoices.`;

