  { value: usd("Monthly SEO"), label: `Monthly SEO starting price, about ${jpy("Monthly SEO")}` },
  { value: "700+", label: `Pages in an SEO website, from ${usd("SEO website")}` },
  { value: "3.5 h", label: "Time difference to Japan, fixed all year" },
