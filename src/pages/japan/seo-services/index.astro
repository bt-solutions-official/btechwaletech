// ---------- Services bento ----------

const servicesHeading = "SEO services for Japanese search, from audit to monthly reporting";
const services: { name: string; note: string; href?: string; size: "lg" | "md" | "sm" }[] = [
  { name: "Technical SEO for Japanese sites", note: "Crawling, indexing, canonicals, redirects, structured data, Core Web Vitals with Japanese fonts and JavaScript rendering, fixed in the code rather than listed in a report.", href: "/services/seo-services/", size: "lg" },
