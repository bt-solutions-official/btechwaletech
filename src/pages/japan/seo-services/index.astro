    "SEO website renewal Japan",
    "AI Overviews Japan",
    "SEO Osaka",
    "SEO Nagoya",
    "SEO Yokohama",
    "SEO Fukuoka",
    "SEO Sapporo",
    "SEO Kyoto",
    "SEO Kobe",
    "SEO Sendai",
    "offshore SEO India Japan",
    "SEO対策 格安",
    "SEO対策 外注",
    "SEOコンサルティング",
    "MEO対策",
  ],
});

const schema = japanServiceSchema({
  path,
  title: page.title,
  description: page.description,
  serviceName: "SEO services for businesses in Japan",
  serviceType: "Search engine optimisation",
  plans: ["Monthly SEO", "SEO website", "Static"],
});

