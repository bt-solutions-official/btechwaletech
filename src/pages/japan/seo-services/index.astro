---
import JapanServicePage from "@components/japan/JapanServicePage.astro";
import type { Article } from "@components/japan/JapanServicePage.astro";
import { createPageSeo } from "@lib/seo/seo-config";
import { createBreadcrumbs } from "@lib/breadcrumbs/breadcrumbs";
import { usd, countryOgImage } from "@data/countries/international";
import { JPY_PER_USD, jpy, both, ja, japanRegions, japanServiceSchema } from "@data/countries/japan";

const path = "/japan/seo-services/";

// ---------- FAQ (visible list and FAQPage schema share this array; plain text only) ----------

const faqs = [
  {
    question: "How much do SEO services cost in Japan?",
    answer: `Japanese 2026 price guides put SEO consulting at ¥100,000 to ¥1,000,000 a month, with ¥200,000 to ¥300,000 the most common band, and small and mid-sized businesses typically paying ¥100,000 to ¥300,000 a month. Content-led programmes run ¥600,000 to ¥2,000,000 a month, and articles cost ¥30,000 to ¥100,000 each. Our monthly SEO starts from ${both("Monthly SEO")}, and a 700+ page SEO website starts from ${both("SEO website")}. These are starting prices; the written quote depends on the size of your site and the work agreed.`,
  },
  {
    question: "Why is your monthly SEO so much cheaper than a Japanese SEO company?",
    answer: "The difference is overhead, not effort. A monthly fee from a Japanese SEO firm has to fund a city-centre office, consultants on Japanese pay scales, a sales process and frequently outside writers, and the fee rises with each of those. Our fee funds three remote engineers in India and nothing else. You do give something up: communication is in English, nobody visits your office, and Japanese articles need a native writer you hire separately. For many businesses the technical and structural work is the part that was missing anyway.",
  },
  {
    question: "Can you guarantee a first-page ranking on Google in Japan?",
    answer: "No, and we would be wary of anyone who does. Ranking guarantees, often advertised in Japan as jouihyouji hoshou, usually rest on low-competition keywords that bring few customers, or on link tactics that can damage your domain. Google decides rankings and no outside company controls them. What we commit to instead is transparency: a written monthly scope, a log of every change we make, and Search Console data showing what happened to impressions, clicks and enquiries after each change.",
  },
  {
    question: "Do you write Japanese SEO articles?",
    answer: "No. Our team does not write natural Japanese, so we do not write Japanese articles and never publish machine translation as finished copy. We do the parts that need search and engineering skills: keyword research across kanji, kana and English, search intent analysis, page outlines, briefs, internal linking, title length checks, structured data and publishing. A native Japanese writer, a staff member or a translator you choose writes and approves the text. Many businesses already have someone who can write; if you do not, we can describe what to look for in a freelance writer.",
  },
  {
    question: "Does SEO for Google also work for Yahoo! JAPAN?",
    answer: `Largely yes, because the web results on Yahoo! JAPAN are powered by Google's search technology. A page that is indexed and ranks well on Google usually does well on Yahoo! JAPAN too, although the page around the results is Yahoo's own. We also verify sites in Bing Webmaster Tools, since Edge on Windows sends searches to Bing by default and some AI assistants draw on Bing's index. Monthly SEO from ${both("Monthly SEO")} covers all three, with reports built mainly on Google Search Console data.`,
  },
  {
    question: "What is MEO, and do you offer MEO services in Japan?",
    answer: "MEO, map engine optimisation, is the Japanese name for local search optimisation on Google Maps. We offer it as part of monthly SEO: guidance on Google Business Profile categories, services, opening hours including holidays, photos and posts, a simple process for asking customers for reviews and replying to them, consistent name, address and phone details across your site and portals, and location pages with structured data. The profile must be owned by your company at your real address; we never create listings in our own account.",
  },
  {
    question: "How long does SEO take to work in Japan?",
    answer: "Technical fixes can show effects within weeks once Google recrawls the affected pages, and new pages are often indexed within days to a few weeks. Meaningful growth in traffic and enquiries usually takes several months, and competitive Tokyo keywords in fields such as real estate, beauty, medical care or finance can take longer. Local MEO for a single location often moves faster than nationwide rankings. We set expectations in the first month from your own Search Console data rather than promising a date.",
  },
  {
    question: "Do you offer pay-for-performance SEO (seika houshuu gata)?",
    answer: `No. Pay-for-performance SEO in Japan usually charges a fee for each day or month a chosen keyword sits inside a ranking band such as the top ten. It sounds safe, but it gives the vendor a reason to pick keywords that are easy to rank and bring few customers, and some vendors use risky links to hit targets quickly. We charge a flat monthly fee from ${both("Monthly SEO")} for a written scope, and we judge success by enquiries and sales rather than one keyword.`,
  },
  {
    question: "Do you build backlinks?",
    answer: "We do not buy links, sell links, run private blog networks or swap links in bulk, because Google's spam policies treat those as link schemes and the penalty lands on your domain, not ours. We earn links in ways that stay safe: making sure partners, suppliers, industry associations and local chambers of commerce link to you correctly, creating data or guides that others want to cite, reclaiming broken links that already point to your site, and keeping business listings consistent. Honest link building is slower, and we say so.",
  },
  {
    question: "Can you do SEO for an English website aimed at foreigners in Japan or inbound tourists?",
    answer: "Yes, and this is where an English-first team fits well. For residents we research English queries such as international schools, English-speaking clinics, apartments for foreigners or visa services, by city and ward. For inbound tourism we build language versions for English, Simplified Chinese, Traditional Chinese and Korean, with hreflang, separate URLs and keyword research per market. JNTO recorded a record 42.68 million international visitors in 2025, led by South Korea, mainland China and Taiwan, so these versions can reach a large audience.",
  },
  {
    question: "How do hreflang tags work for Japanese, Chinese and Korean pages?",
    answer: "Each language version gets its own URL, for example /ja/, /en/, /zh-hans/, /zh-hant/ and /ko/, and every version lists all of its equivalents with hreflang codes such as ja, en, zh-Hans, zh-Hant and ko, plus an x-default page. The tags must be reciprocal and point to canonical URLs, or search engines ignore them. We avoid redirecting visitors automatically by IP address, because it can stop crawlers from reaching the other versions. Chinese and Korean text should come from native translators working from their own keyword research.",
  },
  {
    question: "What access do you need to start SEO work?",
    answer: "Usually Google Search Console, Google Analytics 4, Bing Webmaster Tools, manager access to your Google Business Profile, and access to your CMS or code repository if we are fixing things ourselves. Every account stays in your company's name; you add us as users and can remove us at any time. We ask for the least access that lets us do the agreed work, and we avoid access to customer personal data unless a task truly needs it, in which case we agree data-handling terms first.",
  },
  {
    question: "Do analytics and SEO tags raise privacy issues in Japan?",
    answer: "They can. Since June 2023, the Telecommunications Business Act has required services within its scope to notify users, or publish details, when tags or SDKs such as analytics and advertising scripts pass user information to third parties; a site that only promotes a company's own business is often outside that scope. The APPI covers personal data in forms and CRMs, and access from India counts as provision to a third party in a foreign country. We keep tags lean and documented; your adviser confirms what applies.",
  },
  {
    question: "Can you protect our rankings during a website renewal?",
    answer: "Yes, and it is one of the most valuable things SEO work can do. Before a renewal we crawl the current site, export pages with clicks and links from Search Console, and build a one-to-one redirect map from every old URL to its new equivalent. We keep content that ranks, test the new site on a blocked staging server, check titles, canonicals and structured data before launch, then watch indexing and traffic closely for the first weeks. Missing redirects are the usual culprit when traffic falls after a renewal, and they are entirely avoidable.",
  },
  {
    question: "What is a programmatic SEO website, and is it safe?",
    answer: `It is a large site generated from structured data, such as property pages by station and area, services by city, or products by material and size. It is safe when every page gives the searcher something unique and useful, such as real listings, prices, access information or local details, and risky when thousands of pages differ only by a place name. Google's spam policies target scaled content produced mainly to manipulate rankings. Our SEO website plan starts from ${both("SEO website")} for 700+ pages built from your data.`,
  },
  {
    question: "Do you optimise for AI Overviews and ChatGPT-style assistants?",
    answer: "We optimise for them in the ways anyone honestly can: clear pages that answer questions directly, sound headings and structure, structured data, named authors and supervisors, fast pages that crawlers can read without running JavaScript, and deliberate robots.txt choices about AI crawlers. Google has shown AI Overviews in Japanese search since August 2024 and added Japanese to AI Mode in September 2025, and chat assistants draw on web content, so pages that are easy to quote are more likely to be cited. Nobody can guarantee a mention in an AI answer, and we do not claim to.",
  },
  {
    question: "Can you invoice in yen, and do you add consumption tax?",
    answer: `We price in US dollars and can invoice in Japanese yen on request, with the yen amount fixed in the written quote and payment by Wise or international bank wire. Monthly SEO starts from ${both("Monthly SEO")}. Because we hold no registration under Japan's qualified invoice system, our invoices carry no Japanese consumption tax and cannot serve as qualified invoices. How your company treats a cross-border service for consumption tax or withholding is a question for your tax accountant, the zeirishi.`,
  },
  {
    question: "What are your working hours in Japan time?",
    answer: "Our day runs from 9 am to 9 pm India time, which is 12:30 pm to 12:30 am in Japan. The gap is a fixed three and a half hours all year, since neither country moves its clocks. WhatsApp messages are answered every day within those hours, and if you need an earlier slot, a video call at about 10 am JST can be booked ahead. SEO suits this rhythm: questions you send in the morning usually come back with answers, fixes or draft briefs by the evening.",
  },
  {
    question: "Can you work with WordPress, Shopify, STUDIO or our current Japanese host?",
    answer: "Yes in most cases. WordPress is widely used on Japanese business sites, and we can fix themes, plugins, redirects and speed there, whether the site runs on a Japanese host such as Xserver or Sakura Internet or on a cloud server. On Shopify we work within the theme and app ecosystem. On hosted builders such as STUDIO, Wix or Jimdo we do what the platform allows and tell you plainly when its limits are holding your SEO back. If a rebuild makes sense, we quote it separately.",
  },
  {
    question: "Can you do SEO for a business with branches across several prefectures?",
    answer: "Yes. Multi-location SEO in Japan needs one Google Business Profile per real location, each verified by your company, and one useful page per branch on your website with its own address, directions from the nearest station, parking, hours, staff and services. We avoid doorway pages that repeat the same text with a different city name. Branch pages link up to prefecture and service pages so search engines understand the structure, and the monthly report shows search performance for each branch separately.",
  },
  {
    question: "How do we get started with SEO?",
    answer: "Start with four things: your site address, the services you most want to sell, the areas you cover and two or three competitors you keep an eye on. WhatsApp or email them to us in English. After studying your site and the current search results, we come back with observations and questions, then a written scope with the monthly price and timeline in USD or JPY. No invoice is issued before you sign off on that scope. Read access to Search Console at this stage makes the first review far more specific.",
  },
];

// ---------- Page meta ----------

const page = createPageSeo({
  title: "SEO Services Japan | Affordable Japanese SEO & MEO",
  description: `SEO services in Japan: technical SEO, Japanese keywords, MEO and hreflang by a remote team in India. Monthly SEO from ${usd("Monthly SEO")} (about ${jpy("Monthly SEO")}).`,
  canonicalPath: path,
  h1: "SEO services in Japan: Japanese SEO and MEO for Tokyo, Osaka and all 47 prefectures",
  intro: "BtechWaleTech is a three-engineer team in India that does SEO for businesses in Japan: technical audits and fixes, Japanese keyword research, site structure, MEO for Google Business Profile, programmatic sites of 700+ pages and multilingual SEO for inbound visitors. We work remotely in English, native writers handle your Japanese copy, and monthly SEO starts far below typical Japanese consulting fees. We never guarantee rankings; we show you exactly what we changed and what it did.",
  breadcrumbs: createBreadcrumbs([
    { label: "Countries", href: "/countries/" },
    { label: "Japan", href: "/japan/" },
    { label: "SEO services", href: path },
  ]),
  locale: "en_JP",
  ogImage: countryOgImage("BtechWaleTech, a remote SEO team in India serving businesses across Japan"),
  keywords: [
    "SEO services Japan",
    "SEO company Japan",
    "SEO agency Tokyo",
    "SEO consultant Japan",
    "Japanese SEO",
    "affordable SEO Japan",
    "local SEO Japan",
    "MEO Japan",
    "Google Business Profile Japan",
    "international SEO Japan",
    "SEO for inbound tourism",
    "multilingual SEO Japan",
    "hreflang Japanese Chinese Korean",
    "technical SEO Japan",
    "Japanese keyword research",
    "Yahoo! JAPAN SEO",
    "ecommerce SEO Japan",
