const pills = ["Technical SEO", "Japanese keyword research", "MEO and Business Profile", "700+ page SEO websites", "hreflang for ja, en, zh, ko", "AI search visibility"];
const heroOrigin = "Three engineers in India · Remote SEO for Japan · No office or staff in Japan";
const quoteKicker = "SEO starting prices";
