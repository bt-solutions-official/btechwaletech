const answerHeading = "Looking for affordable SEO services for a business in Japan?";
const quickAnswer = `BtechWaleTech is a three-engineer team in India offering SEO for businesses in Japan: technical SEO, Japanese keyword research, page structure, MEO, programmatic sites and hreflang for inbound markets. Monthly SEO starts from ${both("Monthly SEO")}, against the ¥100,000 to ¥300,000 a month that Japanese price guides quote for small and mid-sized businesses. We work in English, a native writer handles the Japanese text, and we never guarantee rankings.`;
const answerMore = "SEO rarely needs daily meetings. Most of the work is audits, fixes, keyword plans and content briefs, which run well asynchronously, and our hours of 12:30 pm to 12:30 am JST overlap your whole afternoon for calls and quick questions.";
const snapshotCaption = "SEO for Japan at a glance";
const snapshot = [
  { label: "Who does the work", value: "Three engineers in India: technical SEO and cloud, full stack development, delivery and data" },
  { label: "Search engines", value: "Google and Yahoo! JAPAN, which uses Google's search technology, plus Bing" },
  { label: "What we cover", value: "Technical SEO, keyword research, structure, MEO, programmatic sites, hreflang, AI search" },
