  canonicalPath: path,
  h1: "Website developer for Japan: corporate, recruitment and bilingual sites for all 47 prefectures",
  intro: `Need a website developer for a business in Japan without Tokyo agency prices? BtechWaleTech's three engineers in India design and build corporate sites, recruitment sites, landing pages, Shopify storefronts and bilingual Japanese and English sites, and renews old WordPress, Wix or STUDIO sites without throwing away search traffic. We work remotely in English, your Japanese text comes from your own team or translator, and websites start from ${both("Static")}.`,
  breadcrumbs: createBreadcrumbs([
    { label: "Countries", href: "/countries/" },
    { label: "Japan", href: "/japan/" },
    { label: "Website developer", href: path },
  ]),
  locale: "en_JP",
  ogImage: countryOgImage("BtechWaleTech, a remote website development team in India building websites for businesses in Japan"),
