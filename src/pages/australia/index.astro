// ---------- Process ----------

const process = [
  ["Talk", "A short video call in your afternoon or a WhatsApp chat about your business, customers and budget. No charge."],
  ["Scope & quote", "Pages, features, integrations, timeline and an itemised quote in USD or AUD, agreed in writing."],
  ["Design", "Sitemap and wireframes first, then visual design for key pages, reviewed on your own phone."],
  ["Build on staging", "The site is built on a private staging link you can open any time, with written progress updates."],
  ["Test & SEO", "Titles, schema, redirects, speed, forms, GST display and payments checked end to end before launch."],
  ["Launch & support", "Domain connected, Search Console set up, logins handed over, then 5 months of free maintenance."],
