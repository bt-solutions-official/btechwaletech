  .quote-card .btn-primary { background: var(--gold); color: var(--midnight); border-color: var(--gold); }
  .quote-card .btn-primary .btn-arrow { color: var(--midnight); }

  /* Stats */
  .stats-section { padding: clamp(2.5rem, 5vw, 4rem) 0; background: var(--midnight); }
