// ---------- Services bento ----------

const services = [
  { name: "Website design & development", note: "Fast, mobile-first sites on Astro, Next.js or WordPress, written in Australian English, with enquiries routed to email, SMS or your CRM.", href: "/services/web-development/", size: "lg" },
  { name: "SEO & local SEO", note: "Technical SEO, content and suburb-level local search for google.com.au, plus hreflang for en-AU and en-NZ pages.", href: "/services/seo-services/", size: "md" },
