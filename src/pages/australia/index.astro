  { name: "Allied health, dental and clinics", need: "Practitioners, fees and billing, Medicare or health fund details, parking and quick online booking", build: "Practitioner pages, booking links to Cliniko or HotDoc, AHPRA-aware copy without testimonials, accessible layouts" },
  { name: "NDIS providers", need: "Plain-language service descriptions, service areas, registration status and an easy way to make contact", build: "Accessible, easy-read friendly pages, careful enquiry forms, content structure your team can update" },
  { name: "Professional services", need: "Credentials, practice areas, fixed-fee options and answers to the questions clients ask first", build: "Restrained, fast sites with team profiles, practice pages, articles and secure document request forms" },
  { name: "Retail and online brands", need: "Clear product detail, GST-inclusive prices, delivery times, returns and Afterpay or Zip at checkout", build: "Shopify or WooCommerce stores, Australia Post, Sendle or Shippit shipping rules, product schema, Xero sync" },
  { name: "Hospitality and tourism", need: "Real photos, menus as text, seasonal hours, bookings that work first time on a phone", build: "Venue and tour sites, booking engine links, events pages, fast image handling, Google Business Profile guidance" },
  { name: "Education and training", need: "Course details, intakes, fees, CRICOS or RTO codes where applicable and a short enrolment path", build: "Course pages, enquiry and enrolment flows, international student content, CRM integration" },
  { name: "Mining services, construction and B2B", need: "Capabilities, safety and quality accreditations, project case notes and a named contact", build: "Capability sites, downloadable capability statements, tender-ready pages, RFQ forms that accept drawings" },
  { name: "Wineries and food producers", need: "Cellar door hours, wine club sign-up, online orders and shipping rules that respect state restrictions", build: "Direct-to-consumer stores, club memberships, age confirmation, events and tasting bookings" },
