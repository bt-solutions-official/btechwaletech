  { label: "Checkout options we set up", value: "Stripe, Shopify Payments, PayPal, Square, Afterpay and Zip, in your merchant name" },
  { label: "Language", value: "Australian English: enquiry, optimise, colour, DD/MM/YYYY dates, +61 numbers" },
  { label: "Starting prices", value: `From ${usd("Static")} for a website; every figure is a starting price in USD` },
  { label: "After launch", value: `5 months of free maintenance, then from ${usd("Maintenance")} or pay as needed` },
