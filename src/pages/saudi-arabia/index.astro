            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===================== PROCESS ===================== -->
  <section class="process" aria-labelledby="process-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="process-heading">From the first message to a live Saudi website</h2>
      </div>
      <ol class="steps steps-six">
        {process.map(([step, detail], i) => (
          <li><span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span><h3>{step}</h3><p>{detail}</p></li>
        ))}
      </ol>
      <div class="comparison-table-wrap timeline-wrap">
        <table class="price-table fit-sm">
          <caption class="sr-only">Typical project timelines</caption>
          <thead><tr><th scope="col">Project</th><th scope="col">Typical timeline</th><th scope="col" class="hide-sm">What it covers</th></tr></thead>
          <tbody>
            {pricingPlans.map((plan) => (
              <tr><th scope="row">{plan.name}</th><td>{plan.timeline}</td><td class="hide-sm">{plan.summary}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine">
        Timelines assume Arabic copy, product data and approvals arrive when planned. Arabic-first designs need extra RTL testing
        time, and approvals from gateways, BNPL providers and e-invoicing vendors run on their schedules, so we start them in week one.
      </p>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="faq" aria-labelledby="faq-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-heading">Questions from Saudi businesses, answered</h2>
