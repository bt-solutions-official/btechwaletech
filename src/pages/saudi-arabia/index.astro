---
import BaseLayout from "@layouts/BaseLayout.astro";
import { countryPageLinks } from "@data/keywords/page-links";
import { createPageSeo } from "@lib/seo/seo-config";
import { createBreadcrumbs } from "@lib/breadcrumbs/breadcrumbs";
import { breadcrumbListSchema, faqSchema } from "@lib/schema/schema";
import { canonicalUrl } from "@lib/urls/url-utils";
import { siteBrand, siteContact } from "@data/site/site-config";
import { pricingPlans, usdPrice } from "@data/pricing/plans";
import { usd } from "@data/countries/international";

const path = "/saudi-arabia/";
const url = canonicalUrl(path);
const updated = "2026-09-21";

// ---------- FAQ (visible list and FAQPage schema share this array) ----------

const faqs = [
  {
    question: "Are you based in Saudi Arabia or do you have an office in Riyadh?",
    answer: "No. We are a small team of engineers based in India and we serve clients in Saudi Arabia remotely. We have no office, commercial registration, MISA licence or employees in the Kingdom. You work directly with the three engineers who build your project, over WhatsApp, email and video calls.",
  },
  {
    question: "What does a website cost for a Saudi business?",
    answer: `Starting prices for Saudi clients are ${usd("Static")} for a static website of up to 100 pages, ${usd("SEO website")} for a 299+ page SEO website, ${usd("AI automation")} for AI automation, ${usd("Ecommerce")} for an ecommerce store and ${usd("Custom web app")} for a custom web app. Monthly SEO starts from ${usd("Monthly SEO")} and maintenance from ${usd("Maintenance")}. The final quote depends on your requirements, such as an Arabic-first design, integrations and content.`,
  },
  {
    question: "Can the website be Arabic-first, with English as the second language?",
    answer: "Yes, and for most consumer-facing Saudi sites we recommend it. We design the Arabic right-to-left layout as the primary version, then adapt it for English, rather than translating an English site at the end. Both languages get their own URLs, metadata and hreflang tags so each can rank on its own.",
  },
  {
    question: "Who writes the Arabic text on the site?",
    answer: "You, your team or a translator you trust. Nobody on our team is a native Arabic copywriter, and we do not present machine translation as final copy. We give you a structured sheet of every string that needs Arabic, from headings to error messages, and we handle the layout, fonts, forms and search setup around it.",
  },
  {
    question: "Do you integrate mada, Apple Pay and STC Pay?",
    answer: "Yes, through the payment gateway you contract with. Gateways such as HyperPay, Moyasar, PayTabs, Checkout.com and Tap support mada cards, and most support Apple Pay; STC Pay availability depends on the provider. We connect the gateway, test the full checkout including refunds, and make sure card data never touches your own server. Merchant approval and fees are between your company and the provider.",
  },
  {
    question: "Can you add Tabby or Tamara instalments to our store?",
    answer: "Yes. Both are widely used buy now, pay later options in Saudi Arabia. Once your company is approved by the provider, we add the checkout option and the instalment messaging on product pages according to their guidelines, and we test how returns and partial refunds flow back to the customer.",
  },
  {
    question: "Should we use Salla, Zid, Shopify or a custom store?",
    answer: "Salla and Zid are Saudi platforms with Arabic dashboards, local payment and shipping options built in, and they suit many small and mid-sized stores. Shopify suits brands that sell across several countries or want its app ecosystem. A custom build suits B2B ordering, unusual pricing or deep ERP integration. We recommend one after looking at your catalogue, team and growth plans.",
  },
  {
    question: "How do you approach SEO on google.com.sa?",
    answer: "We research Arabic and English keywords separately, including the Saudi dialect phrasing people actually type, then map them to pages. Each language version has its own titles, headings and hreflang tags. For local businesses we plan city and district pages only where you really serve customers, and help with your Google Business Profile. Monthly SEO covers content, technical fixes and reporting.",
  },
  {
    question: "What is the time difference between India and Saudi Arabia?",
    answer: "Saudi Arabia is two and a half hours behind India all year, since neither country changes its clocks. Our hours of 9am to 9pm IST run from 6.30am to 6.30pm in Riyadh, so we cover the Saudi morning and afternoon fully, and WhatsApp messages sent in the Saudi evening are seen and answered promptly.",
  },
  {
    question: "Do you work on Sundays, the start of the Saudi working week?",
    answer: "Yes. The Saudi weekend is Friday and Saturday, so Sunday is a normal working day for you. We reply on WhatsApp seven days a week and schedule calls on Sunday to Thursday to match your team. We avoid launching large changes on a Thursday afternoon, just before your weekend.",
  },
  {
    question: "Which currency do you invoice in, and how do Saudi clients pay?",
    answer: "We quote and invoice in US dollars by default, and we can invoice in Saudi riyals on request, converted at the riyal's fixed peg to the dollar. Payment is by international bank transfer or Wise, in milestones: a deposit to start, a payment at staging approval and the balance at launch.",
  },
  {
    question: "Is VAT or withholding tax involved when a Saudi company pays you?",
    answer: "We invoice from India and do not charge Saudi VAT. Saudi companies paying foreign suppliers may need to self-account for VAT and may have withholding tax obligations on payments for services. Rules depend on your situation, so please confirm the treatment with your tax adviser before the first payment. We are engineers, not tax advisers.",
  },
  {
    question: "Does our online store need ZATCA e-invoicing?",
    answer: "Businesses registered for VAT in Saudi Arabia fall under ZATCA's e-invoicing requirements, which have been rolled out in phases. Your store or order system may need to connect to a compliant e-invoicing solution that issues invoices in the required format. We integrate with the solution your accountant chooses. Confirm your own phase and deadlines with your adviser.",
  },
  {
    question: "Does the Saudi Personal Data Protection Law affect our website?",
    answer: "If your site collects names, phone numbers, emails or other personal data, the PDPL overseen by SDAIA is relevant, including rules on consent, privacy notices and transferring data outside the Kingdom. We build forms that collect only what you need, show a clear Arabic and English notice, and link to your privacy policy. Please take legal advice on your specific obligations.",
  },
  {
    question: "Can the site be hosted inside Saudi Arabia?",
    answer: "Yes, when your sector, data or clients require it. Several major cloud providers operate data centre regions in the Kingdom, and we can deploy there on accounts in your company's name. For most marketing sites a global CDN with points of presence in the Gulf is fast and cheaper. We explain the trade-off and deploy where you decide.",
  },
  {
    question: "Can forms handle the Saudi National Address and Hijri dates?",
    answer: "Yes. Checkout and registration forms can use the National Address structure, with building number, street, district, city, postal code and additional number, which helps couriers deliver first time. Where your customers expect it, dates can be shown in both the Gregorian and Hijri calendars, and mobile number fields validate the +966 format.",
  },
  {
    question: "How long does a project for a Saudi client take?",
    answer: "A static website usually takes one to two weeks, a 299+ page SEO website three to five weeks, AI automation two to four weeks, an ecommerce store four to eight weeks and a custom web app six to twelve weeks. An Arabic-first design adds time for RTL testing, and gateway approvals can take longer than the build, so we start them early.",
  },
  {
    question: "Who owns the website and accounts when the project ends?",
    answer: `You do. Domain, hosting, analytics, Search Console, store and gateway accounts are set up in your company's name, and at handover you receive the source code and every login. After launch you get five months of maintenance free, then an optional plan from ${usd("Maintenance")} a month.`,
  },
  {
    question: "How do we start?",
    answer: "Send a WhatsApp message or email about your business, the cities or regions you serve, your preferred languages and any sites you admire. We reply with questions, then a written scope, timeline and itemised quote, usually within two working days. Nothing starts until you approve the scope.",
  },
];

// ---------- Page meta ----------

const page = createPageSeo({
  title: "Web Development Team Saudi Arabia | Riyadh & Jeddah",
  description: `Web development for Saudi businesses: Arabic-first websites, Salla, Zid and Shopify stores with mada, and SEO. Remote team in India, from ${usd("Static")}.`,
  canonicalPath: path,
  h1: "Web development team for Saudi Arabia: Riyadh, Jeddah, Dammam and beyond",
  intro: `BtechWaleTech is a small team of engineers based in India that builds Arabic-first websites, Android and iOS apps, online stores, SEO systems, custom software and AI automations for businesses across the Kingdom. We work remotely, bill in US dollars or riyals, and publish our starting prices: websites start from ${usd("Static")}.`,
  breadcrumbs: createBreadcrumbs([
    { label: "Countries", href: "/countries/" },
    { label: "Saudi Arabia", href: path },
  ]),
  locale: "en_SA",
  alternateLocales: ["ar_SA"],
  ogImage: { url: "/banner_logo.png", alt: "BtechWaleTech, a remote web development and SEO team from India serving businesses in Saudi Arabia", width: 1536, height: 1024 },
  keywords: [
    "web development team Saudi Arabia",
    "website design Saudi Arabia",
    "web development team KSA",
    "web development team Riyadh",
    "website design Riyadh",
    "website design Jeddah",
    "web development Dammam",
    "website design Khobar",
    "website development Makkah",
    "website design Madinah",
    "web developer Eastern Province",
    "SEO services Saudi Arabia",
    "SEO team Riyadh",
    "Arabic website design",
    "RTL website development",
    "ecommerce website development Saudi Arabia",
    "Salla store design",
    "Zid store setup",
    "Shopify developer Saudi Arabia",
    "mada payment gateway integration",
    "HyperPay Moyasar integration",
    "Tabby Tamara integration",
    "custom software development Saudi Arabia",
    "AI automation Riyadh",
    "offshore web development Saudi Arabia",
    "تصميم مواقع",
    "تصميم مواقع الرياض",
    "شركة تصميم مواقع في السعودية",
    "برمجة مواقع",
    "تصميم متجر إلكتروني",
    "تحسين محركات البحث",
  ],
});

// ---------- Hero, stats and snapshot ----------

const facts = [
  ["Team", "Engineers based in India, remote delivery"],
  ["Starting price", `Websites from ${usd("Static")}`],
  ["Languages", "Arabic-first RTL builds, English in-house"],
  ["Billing", "USD, or SAR on request"],
  ["Time gap", "KSA is 2.5 hours behind IST"],
  ["After launch", "5 months of maintenance free"],
];

const pills = ["Arabic-first RTL sites", "Salla, Zid and Shopify", "mada, Apple Pay, STC Pay", "SEO for google.com.sa", "AI automation", "Custom web apps"];

const stats = [
  { value: "3", label: "Engineers you deal with directly" },
  { value: usd("Static"), label: "Websites starting price" },
  { value: "2.5h", label: "Behind India, all year round" },
  { value: "5", label: "Months maintenance included free" },
];

const snapshot = [
  { label: "Who we are", value: "Three engineers based in India, serving Saudi businesses remotely" },
  { label: "What we build", value: "Websites, online stores, SEO, custom software, web apps, AI automation, maintenance" },
  { label: "Language approach", value: "Arabic-first RTL layouts; Arabic copy from you or your translator" },
  { label: "Payments we integrate", value: "mada, Visa, Mastercard, Apple Pay, STC Pay, Tabby, Tamara via your gateway" },
  { label: "Store platforms", value: "Salla, Zid, Shopify, WooCommerce or a custom build" },
  { label: "Working hours overlap", value: "6.30am to 6.30pm Riyadh time, Sunday to Thursday calls" },
  { label: "Office in Saudi Arabia", value: "None. Remote delivery from India only" },
];

// ---------- Services bento ----------

const services = [
  { name: "Website design & development", note: "Arabic-first business websites on Astro, Next.js or WordPress, with an English version, WhatsApp contact and fast mobile pages.", href: "/services/web-development/", size: "lg" },
  { name: "SEO for google.com.sa", note: "Saudi Arabic keyword research, hreflang, city pages where you really operate, schema and monthly content.", href: "/services/seo-services/", size: "md" },
  { name: "Online stores", note: "Salla, Zid, Shopify or custom stores with mada, Apple Pay, BNPL, cash on delivery and local couriers.", size: "sm" },
  { name: "Arabic RTL engineering", note: "Right-to-left layouts, Arabic typography, Hijri dates and National Address forms done properly.", size: "sm" },
  { name: "Custom software", note: "Contractor portals, booking systems, fleet dashboards and admin panels for your team.", size: "sm" },
  { name: "AI automation", note: "Arabic and English document extraction, lead routing, WhatsApp flows and internal assistants.", size: "sm" },
  { name: "Android & iOS apps", note: `Arabic and English Android and iPhone apps for staff and customers, on Google Play and the App Store, from ${usd("Android")}.`, size: "sm" },
  { name: "Maintenance & support", note: "Updates, backups, fixes and speed checks, with 5 months free after launch.", size: "sm" },
] as const;

// ---------- Comparison ----------

const comparison = [
  ["Starting price", "Higher, reflects local offices, licences and sales staff", "Cheap bids, scope and quality uncertain", `From ${usd("Static")}, with an itemised written quote`],
  ["Arabic quality", "Strong in-house Arabic writing is common", "Mixed; RTL often an afterthought", "Arabic-first RTL engineering; copy from your translator"],
  ["Local presence", "Face-to-face meetings in the Kingdom", "Usually none", "None. Video calls, WhatsApp and a staging link"],
  ["Who builds it", "Varies, often a team behind a manager", "One person, sometimes subcontracting", "The three engineers you talk to"],
  ["Sunday availability", "Yes", "Depends on the person", "Yes; replies seven days a week"],
  ["Payment integrations", "Usually experienced", "Often Stripe-only habits", "mada, Apple Pay, STC Pay, Tabby, Tamara via your gateway"],
  ["Ownership", "Usually yours, check the contract", "Logins sometimes kept back", "Every account in your company's name"],
  ["After launch", "Paid support contract", "Often unreachable", "5 months of maintenance included free"],
];

// ---------- Regions ----------

const regions = [
  { name: "Riyadh region", cities: "Riyadh, Al Kharj, Diriyah", market: "Capital, headquarters of government bodies and large companies, fast-growing tech and events sector.", build: "Corporate bilingual sites, B2G supplier profiles, SaaS dashboards, event and venue pages" },
  { name: "Makkah region", cities: "Jeddah, Makkah, Taif, Rabigh", market: "Jeddah's port, trade and retail; Umrah and Hajj hospitality and transport around Makkah; Taif's tourism and agriculture.", build: "Ecommerce, hotel and Umrah service sites, multilingual booking flows, trading catalogues" },
  { name: "Eastern Province", cities: "Dammam, Khobar, Dhahran, Jubail, Al Ahsa", market: "Energy, petrochemicals, industrial contractors and suppliers, plus retail and dining in Khobar.", build: "B2B contractor sites, capability statements, tender-ready profiles, restaurant and retail sites" },
  { name: "Madinah region", cities: "Madinah, Yanbu, AlUla", market: "Pilgrim hospitality, Yanbu's industrial city, and AlUla's heritage tourism.", build: "Hotel and tour sites, visitor information pages, industrial supplier catalogues" },
  { name: "Qassim", cities: "Buraydah, Unaizah, Ar Rass", market: "Agriculture, dates and food trade, family businesses and regional retail.", build: "Product catalogues, wholesale enquiry systems, small online stores" },
  { name: "Asir", cities: "Abha, Khamis Mushait", market: "Mountain tourism, summer visitors, local services and a growing hospitality sector.", build: "Tourism and chalet booking sites, local service pages, seasonal offer pages" },
  { name: "Tabuk and NEOM", cities: "Tabuk, Duba, NEOM area", market: "Giga-project suppliers, construction, logistics and new tourism destinations on the Red Sea.", build: "Supplier and subcontractor sites, recruitment pages, project-facing company profiles" },
  { name: "Other regions", cities: "Hail, Jazan, Najran, Al Bahah, Al Jawf, Northern Borders", market: "Regional trade, agriculture, local services and government-linked projects.", build: "Lean static sites, Google Business Profile guidance, simple ordering and booking" },
];

// ---------- Industries ----------

const industries = [
  { name: "Real estate", need: "Arabic listings with district filters, off-plan project pages, financing information, instant WhatsApp contact", build: "Listing platforms, developer project sites, CRM-linked lead forms, Arabic and English district pages" },
  { name: "Hospitality & tourism", need: "Umrah, leisure and event visitors, seasonal rates, several languages, booking on a phone", build: "Hotel and tour operator sites, booking engine links, multilingual pages, event landing pages" },
  { name: "Retail & ecommerce", need: "mada and Apple Pay, BNPL, clear delivery times by city, easy returns in Arabic", build: "Salla, Zid, Shopify or custom stores with gateways, courier integration and e-invoicing hooks" },
  { name: "Healthcare", need: "Doctor profiles, insurance acceptance, appointment requests, privacy-conscious forms", build: "Clinic and medical centre sites, booking forms with minimal data, bilingual service pages" },
  { name: "Education & training", need: "Admissions details, programme pages, fee enquiries, parent and student information", build: "School, training centre and course sites, enquiry and registration forms, course catalogues" },
  { name: "Logistics & industry", need: "Service scope, certifications, quote requests, tracking and document downloads", build: "B2B sites with quote forms, tracking lookups, capability statements and tender documents" },
  { name: "Food & beverage", need: "Menus in Arabic and English, delivery app links, branch locations, late opening hours", build: "Café and restaurant sites, branch pages, menu CMS, ordering links and Google Business Profile setup" },
];

// ---------- Process ----------

const process = [
  ["Conversation", "A WhatsApp chat or video call on a Sunday to Thursday slot about your business, regions, languages and goals. Free."],
  ["Scope & quote", "A written page plan, Arabic and English keyword list, timeline and itemised quote in USD or SAR, usually within two working days."],
  ["Arabic-first design", "Key page layouts designed right-to-left first, then adapted for English, reviewed by you before development."],
  ["Build on staging", "Development on a private staging link, with gateway, courier and form testing in both languages."],
  ["Go live", "Hosting, domain, SSL, Search Console, analytics and sitemap set up, and launch timed early in your working week."],
  ["Aftercare", "Five months of maintenance free, then an optional monthly plan or changes only when you need them."],
];

// ---------- Schema ----------

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${url}#service`,
  name: `${siteBrand.name}: web development and IT services for Saudi Arabia`,
  description: page.description,
  url,
  image: new URL("/banner_logo.png", siteBrand.domain).toString(),
  email: siteContact.email,
  telephone: siteContact.phone,
  priceRange: `${usd("Maintenance")} - ${usd("Custom web app")}+`,
  currenciesAccepted: "USD, SAR",
  paymentAccepted: "Bank transfer, Wise",
  address: { "@type": "PostalAddress", addressCountry: "IN" },
  areaServed: [
    { "@type": "Country", name: "Saudi Arabia" },
    ...["Riyadh Province", "Makkah Province", "Eastern Province", "Madinah Province", "Qassim Province", "Asir Province", "Tabuk Province"].map((name) => ({ "@type": "State", name })),
    ...["Riyadh", "Jeddah", "Mecca", "Medina", "Dammam", "Khobar", "Dhahran", "Jubail", "Taif", "Buraydah", "Abha", "Tabuk", "Yanbu", "Al Ahsa"].map((name) => ({ "@type": "City", name })),
  ],
  knowsLanguage: ["en"],
  parentOrganization: { "@type": "Organization", name: siteBrand.name, url: siteBrand.domain },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Web development and IT services for Saudi businesses (starting prices, USD)",
    itemListElement: pricingPlans.map((plan) => {
      const price = Number(usdPrice(plan.price).replace(/[^\d]/g, ""));
      return {
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: plan.name, description: plan.summary, areaServed: "Saudi Arabia" },
        priceSpecification: {
          "@type": "PriceSpecification",
          price,
          minPrice: price,
          priceCurrency: "USD",
          ...(plan.unit ? { unitText: plan.unit } : {}),
        },
      };
    }),
  },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${url}#webpage`,
  url,
  name: page.title,
  description: page.description,
  inLanguage: "en-SA",
  dateModified: updated,
  about: { "@id": `${url}#service` },
  speakable: { "@type": "SpeakableSpecification", cssSelector: ["#quick-answer", "h1"] },
};

const toc = [
  ["who-we-are", "Who we are and how we deliver remotely"],
  ["ksa-market", "The Saudi market online"],
  ["arabic-first", "Arabic-first websites and RTL"],
  ["ecommerce", "Online stores and payments"],
  ["seo", "SEO for google.com.sa"],
  ["software", "Custom software and AI automation"],
  ["regions", "Region by region"],
  ["visitors", "Sites for pilgrims and visitors"],
  ["compliance", "PDPL, VAT and ZATCA"],
  ["time-zones", "Time zones and the Saudi week"],
  ["payments", "How Saudi clients pay us"],
  ["buying-guide", "Hiring an offshore developer"],
  ["cost", "What drives the cost"],
];

const related = [
  { name: "Web development services", href: "/services/web-development/" },
  { name: "SEO services", href: "/services/seo-services/" },
  { name: "Pricing", href: "/pricing/" },
  { name: "All countries we serve", href: "/countries/" },
  { name: "IT services in Japan", href: "/japan/" },
  { name: "IT services in the UAE", href: "/uae/" },
  { name: "IT services in India", href: "/india/" },
  { name: "IT services in the USA", href: "/usa/" },
  { name: "IT services in the UK", href: "/uk/" },
  { name: "IT services in Canada", href: "/canada/" },
  { name: "IT services in Australia", href: "/australia/" },
];
const servicePages = countryPageLinks("saudi-arabia");
---

<BaseLayout meta={page} schema={[webPageSchema, serviceSchema, breadcrumbListSchema(page.breadcrumbs), faqSchema(faqs)]}>

  <!-- ===================== HERO ===================== -->
  <section class="hero" aria-labelledby="country-heading">
    <div class="hero-inner">
      <div class="hero-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {page.breadcrumbs.map((b, i) => (
              <li>{i + 1 === page.breadcrumbs.length ? <span aria-current="page">{b.label}</span> : <a href={b.href}>{b.label}</a>}</li>
            ))}
          </ol>
        </nav>
        <p class="eyebrow">Saudi Arabia · All 13 regions</p>
        <h1 id="country-heading">{page.h1}</h1>
        <p class="lede">{page.intro}</p>
        <ul class="facts" aria-label="Quick facts for Saudi clients">
          {facts.map(([label, value]) => <li><strong>{label}</strong><span>{value}</span></li>)}
        </ul>
        <div class="hero-actions">
          <a class="btn-primary" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp for a free quote</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-ghost" href={siteContact.emailHref}>{siteContact.email}</a>
        </div>
        <ul class="hero-pills" aria-label="What we build for Saudi businesses">
          {pills.map((p) => <li>{p}</li>)}
        </ul>
        <p class="hero-origin">
          <span class="origin-dot" aria-hidden="true"></span>
          Team based in India &middot; Serving the Kingdom remotely &middot; <span lang="ar" dir="rtl">تصميم مواقع ومتاجر إلكترونية</span>
        </p>
      </div>

      <aside class="quote-card" aria-label="Starting prices for Saudi clients">
        <p class="quote-kicker">Saudi starting prices (USD)</p>
        <ul class="quote-rows">
          {pricingPlans.slice(0, 5).map((plan) => (
            <li><span>{plan.name}</span><strong><small>from </small>{usd(plan.name)}</strong></li>
          ))}
        </ul>
        <p class="quote-foot">Starting prices; the final quote depends on your requirements. SAR invoicing on request. 5 months maintenance free after launch.</p>
        <a class="btn-primary btn-block" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
          <span>Get my Saudi quote</span><span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </aside>
    </div>
  </section>

  <!-- ===================== STATS ===================== -->
  <section class="stats-section" aria-label="BtechWaleTech for Saudi clients in numbers">
    <div class="section-wrap">
      <ul class="stat-band">
        {stats.map((s) => (
          <li><span class="stat-num">{s.value}</span><span class="stat-label">{s.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== QUICK ANSWER + SNAPSHOT ===================== -->
  <section class="answer" aria-labelledby="answer-heading">
    <div class="section-wrap answer-grid">
      <div>
        <p class="eyebrow">The short answer</p>
        <h2 id="answer-heading">Need a web development team for a Saudi business?</h2>
        <p id="quick-answer" class="answer-text">
          BtechWaleTech is a three-engineer team based in India that builds Arabic-first websites, Salla, Zid, Shopify and
          custom online stores, SEO systems, custom software and AI automations for companies in Riyadh, Jeddah, Dammam,
          Khobar, Makkah, Madinah and the rest of the Kingdom. We work remotely, answer seven days a week, bill in US dollars
          or riyals, and start from {usd("Static")} for a website.
        </p>
        <p class="answer-more">
          We are three freelance engineers in India with no commercial registration in the Kingdom, and we will never suggest otherwise.
          Our offer is simpler: the engineers who write your code are the people you talk to, prices are published as
          starting figures, every scope is written down, and you can watch the site take shape on a staging link. That suits
          founders, small and mid-sized companies and teams already used to working with suppliers abroad.
        </p>
        <p class="updated">Last updated <time datetime={updated}>21 September 2026</time></p>
      </div>
      <table class="snapshot">
        <caption>Working with us from Saudi Arabia, at a glance</caption>
        <tbody>
          {snapshot.map((row) => (
            <tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="services" aria-labelledby="services-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Services for Saudi Arabia</p>
        <h2 id="services-heading">Arabic-first websites, stores, SEO and software, handled by one small team</h2>
        <p class="section-note">
          We cover planning, design, development, SEO setup, hosting and deployment, so there is one team responsible from
