    answer: "Yes. We build apps in English, Hindi, Arabic with right-to-left layouts, French, German and Indian regional languages. Text is kept separate from code so new languages can be added later without rebuilding screens.",
  },
  {
    question: "Can you add AI features like a chatbot to my app?",
    answer: "Yes. We add AI assistants, smart search, summaries, document reading and recommendations using OpenAI, Claude or Gemini APIs, with the API keys kept on the server rather than inside the app. AI features are priced as part of the app scope or as a separate automation project.",
  },
  {
    question: "What happens after the 5 months of free maintenance?",
    answer: "You can continue on a maintenance plan from ₹8,000 / US$120 a month that covers OS updates, store compliance, bug fixes, backups and monitoring, or you can stop and keep the app as it is. You own the code and accounts, so nothing expires when the free period ends.",
  },
  {
    question: "How do international clients pay?",
    answer: "International projects are quoted in USD, or your local currency on request, and paid by bank wire, Wise or PayPal in milestones: a deposit to start, a payment when the first working build is on your phone, and the balance before store release. Clients in India pay in INR by UPI or bank transfer.",
  },
  {
    question: "Will you sign an NDA before I share my app idea?",
    answer: "Yes. We are happy to sign a mutual NDA before you share details, and the development agreement states that the code, designs and intellectual property belong to you once the project is paid for.",
  },
];

const links = [
  { name: "Website development", href: "/services/web-development/" },
  { name: "SEO services", href: "/services/seo-services/" },
  { name: "All services", href: "/services/" },
  { name: "Pricing", href: "/pricing/" },
  { name: "IT services in India", href: "/it-services/" },
  { name: "Apps & IT services in Mumbai", href: "/it-services/maharashtra/mumbai/" },
  { name: "Apps & IT services in Hyderabad", href: "/it-services/telangana/hyderabad/" },
  { name: "Apps & IT services in Delhi", href: "/india/delhi/" },
  { name: "Apps & IT services in Bengaluru", href: "/india/karnataka/bangalore/" },
  { name: "Apps & IT services in Gurugram", href: "/india/haryana/gurgaon/" },
  { name: "Apps & IT services in Pune", href: "/india/maharashtra/pune/" },
  { name: "Apps & IT services in Chennai", href: "/india/tamil-nadu/chennai/" },
  { name: "Apps & IT services in USA", href: "/usa/" },
  { name: "Apps & IT services in UK", href: "/uk/" },
  { name: "Apps & IT services in Canada", href: "/canada/" },
  { name: "Apps & IT services in Australia", href: "/australia/" },
  { name: "Apps & IT services in UAE", href: "/uae/" },
  { name: "Apps & IT services in Singapore", href: "/singapore/" },
  { name: "Apps & IT services in Germany", href: "/germany/" },
  { name: "Apps & IT services in Saudi Arabia", href: "/saudi-arabia/" },
  { name: "Apps & IT services in New Zealand", href: "/new-zealand/" },
  { name: "Apps & IT services in Netherlands", href: "/netherlands/" },
];

const toc = sections.map((s) => ({ id: s.id, heading: s.heading }));
const areaServed = ["United States", "United Kingdom", "Canada", "Australia", "New Zealand", "United Arab Emirates", "Saudi Arabia", "Singapore", "Germany", "Netherlands", "India"]
  .map((name) => ({ "@type": "Country", name }));
const inr = (price: string) => Number(price.replace(/[^\d]/g, ""));

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${url}#service`,
  name: "Android & iOS app development",
  serviceType: "Mobile application development",
  description: page.description,
  url,
  areaServed,
  availableChannel: { "@type": "ServiceChannel", serviceUrl: url, servicePhone: siteContact.phone, availableLanguage: ["English", "Hindi"] },
  provider: {
    "@type": "Organization",
    name: siteBrand.name,
    url: siteBrand.domain,
    email: siteContact.email,
    telephone: siteContact.phone,
    logo: new URL("/banner_logo.png", siteBrand.domain).toString(),
  },
  offers: [
    { "@type": "Offer", name: "Android & iOS app (India)", price: inr(appPlan.price), priceCurrency: "INR", url, eligibleRegion: { "@type": "Country", name: "India" } },
    { "@type": "Offer", name: "Android & iOS app (international)", price: inr(usdPrice(appPlan.price)), priceCurrency: "USD", url },
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Mobile app development services",
    itemListElement: services.map((s) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name: s.name, description: s.note } })),
  },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${url}#webpage`,
  url,
  name: page.title,
  description: page.description,
  inLanguage: "en",
  dateModified: updated,
  about: { "@id": `${url}#service` },
  mainEntity: { "@id": `${url}#service` },
  speakable: { "@type": "SpeakableSpecification", cssSelector: ["#quick-answer", "h1"] },
};
---

<BaseLayout meta={page} schema={[webPageSchema, serviceSchema, breadcrumbListSchema(page.breadcrumbs), faqSchema(faqs)]}>

  <!-- ===================== HERO ===================== -->
  <section class="hero" aria-labelledby="app-heading">
    <div class="hero-inner">
      <div class="hero-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {page.breadcrumbs.map((b, i) => (
              <li>{i + 1 === page.breadcrumbs.length ? <span aria-current="page">{b.label}</span> : <a href={b.href}>{b.label}</a>}</li>
            ))}
          </ol>
        </nav>
        <p class="eyebrow">Mobile app development · Worldwide</p>
        <h1 id="app-heading">{page.h1}</h1>
        <p class="lede">
          We design, build and publish Android and iOS apps in Flutter and React Native for startups and businesses in the USA, UK,
          Canada, Australia, the UAE, Europe and India. One codebase, both app stores, a web admin panel, and code that is 100% yours.
        </p>
        <ul class="facts" aria-label="Quick facts about our app development">
          {facts.map(([label, value]) => <li><strong>{label}</strong><span>{value}</span></li>)}
        </ul>
        <div class="hero-actions">
          <a class="btn-primary" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp for a free app quote</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-ghost" href={siteContact.phoneHref}>Call {siteContact.phone}</a>
        </div>
        <ul class="hero-pills" aria-label="Apps we build">
          {pills.map((p) => <li>{p}</li>)}
        </ul>
        <p class="hero-origin">
          <span class="origin-dot" aria-hidden="true"></span>
          Built in India &middot; Apps live for users worldwide &middot; Replies 7 days a week
        </p>
      </div>

      <aside class="quote-card" aria-label="App development starting prices">
        <p class="quote-kicker">Starting prices</p>
        <ul class="quote-rows">
          {relatedPlans.map((plan) => (
            <li><span>{plan.name}</span><strong><small>from </small>{usdPrice(plan.price)}<small> / {plan.price}</small>{plan.unit ? <small> /mo</small> : null}</strong></li>
          ))}
        </ul>
        <p class="quote-foot">Publishing to Google Play and the App Store included. 5 months maintenance free. Itemised quote in 2 working days.</p>
        <a class="btn-primary btn-block" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
          <span>Get my app quote</span><span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </aside>
    </div>
  </section>

  <!-- ===================== STATS ===================== -->
  <section class="stats-section" aria-label="App development in numbers">
    <div class="section-wrap">
      <ul class="stat-band">
        {stats.map((s) => (
          <li><span class="stat-num">{s.value}</span><span class="stat-label">{s.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== QUICK ANSWER + SNAPSHOT ===================== -->
  <section class="answer" aria-labelledby="answer-heading">
    <div class="section-wrap answer-grid">
      <div>
        <p class="eyebrow">The short answer</p>
        <h2 id="answer-heading">Looking for an Android and iOS app developer?</h2>
        <p id="quick-answer" class="answer-text">
          BtechWaleTech is an India-based team that builds Android and iOS apps in Flutter and React Native for businesses worldwide.
          Apps start from {usdPrice(appPlan.price)} internationally or {appPlan.price} in India, take about {appPlan.timeline}, include
          an admin panel and publishing to Google Play and the App Store, and come with 5 months of free maintenance.
        </p>
        <p class="updated">Last updated <time datetime={updated}>{new Date(updated).toLocaleDateString("en-IN", { day: "numeric", month: "long", year: "numeric" })}</time></p>
      </div>
      <table class="snapshot">
        <caption>The mobile market at a glance</caption>
        <tbody>
          {snapshot.map(([label, value]) => (
            <tr><th scope="row">{label}</th><td>{value}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="services" aria-labelledby="services-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">App services</p>
        <h2 id="services-heading">Everything your app needs, from first screen to store release</h2>
      </div>
      <div class="bento">
        {services.map((s) => (
          <div class={`card card-${s.size}`}>
            <div class="card-core"><h3>{s.name}</h3><p>{s.note}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== WHY US ===================== -->
  <section class="advantage" aria-labelledby="why-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Why choose us</p>
        <h2 id="why-heading">Why businesses hire us over an app agency</h2>
        <p class="section-note">You get agency-grade engineering without paying for sales teams and offices, and you talk to the people writing your app.</p>
      </div>
      <div class="comparison-table-wrap">
        <table class="comparison-table">
          <thead>
            <tr>
              <th scope="col">What matters</th>
              <th scope="col" class="col-other">Typical app agency</th>
              <th scope="col" class="col-other">Cheap freelancer</th>
              <th scope="col" class="col-us">BtechWaleTech</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map(([aspect, agency, cheap, us]) => (
              <tr>
                <th scope="row" class="td-aspect">{aspect}</th>
                <td class="col-other">{agency}</td>
                <td class="col-other">{cheap}</td>
                <td class="td-us"><span class="td-us-inner"><span class="td-check" aria-hidden="true">✓</span>{us}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===================== PRICING ===================== -->
  <section class="pricing" aria-labelledby="pricing-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Pricing</p>
        <h2 id="pricing-heading">App development prices in USD and INR</h2>
        <p class="section-note">Starting prices for apps and the services that usually go with them. International clients pay in USD, clients in India in INR.</p>
      </div>
      <div class="comparison-table-wrap">
        <table class="price-table">
          <thead>
            <tr><th scope="col">Service</th><th scope="col">International</th><th scope="col">India</th><th scope="col">Typical timeline</th><th scope="col">What is included</th></tr>
          </thead>
          <tbody>
            {relatedPlans.map((plan) => (
              <tr>
                <th scope="row">{plan.name}</th>
                <td class="price">{usdPrice(plan.price)}{plan.unit && <small> {plan.unit}</small>}</td>
                <td class="price">{plan.price}{plan.unit && <small> {plan.unit}</small>}</td>
                <td>{plan.timeline}</td>
                <td>{plan.includes.join(" · ")}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine">{pricingNote} Apple Developer (US$99/year) and Google Play (US$25 once) fees are paid by you, under your own accounts.</p>
    </div>
  </section>

  <!-- ===================== TECH STACK ===================== -->
  <section class="industries" aria-labelledby="stack-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Technology</p>
        <h2 id="stack-heading">Flutter, React Native, native or PWA: compared</h2>
      </div>
      <div class="comparison-table-wrap">
        <table class="price-table">
          <thead><tr><th scope="col">Approach</th><th scope="col">How it works</th><th scope="col">Best for</th></tr></thead>
          <tbody>
            {stackTable.map(([name, how, best]) => (
              <tr><th scope="row">{name}</th><td>{how}</td><td>{best}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===================== LONG-FORM GUIDE ===================== -->
  <section class="guide" aria-label="Android and iOS app development guide">
    <div class="section-wrap guide-grid">
      <nav class="toc" aria-label="On this page">
        <p class="toc-title">On this page</p>
        <ol>
          {toc.map((t) => <li><a href={`#${t.id}`}>{t.heading}</a></li>)}
          <li><a href="#areas-heading">Countries we serve</a></li>
          <li><a href="#industries-heading">Industries</a></li>
          <li><a href="#faq-heading">FAQs</a></li>
        </ol>
      </nav>
      <div class="prose">
        {sections.map((s) => (
          <article aria-labelledby={s.id}>
            <h2 id={s.id}>{s.heading}</h2>
            {s.paragraphs.map((p) => <p set:html={p} />)}
            {s.list && <ul>{s.list.map((li) => <li set:html={li} />)}</ul>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== MARKETS ===================== -->
  <section class="locations" aria-labelledby="areas-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Countries we serve</p>
        <h2 id="areas-heading">App development for clients around the world</h2>
      </div>
      <ul class="area-grid">
        {markets.map((m) => (
          <li><h3><a href={m.href}>{m.name}</a></h3><p>{m.note}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== INDUSTRIES ===================== -->
  <section class="industries" aria-labelledby="industries-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Industries</p>
        <h2 id="industries-heading">Apps we build by industry</h2>
      </div>
      <div class="comparison-table-wrap">
        <table class="price-table">
          <thead><tr><th scope="col">Industry</th><th scope="col">What users look for</th><th scope="col">What we build</th></tr></thead>
          <tbody>
            {industries.map(([name, need, build]) => (
              <tr><th scope="row">{name}</th><td>{need}</td><td>{build}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===================== PROCESS ===================== -->
  <section class="process" aria-labelledby="process-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="process-heading">From idea to an app in both stores</h2>
      </div>
      <ol class="steps">
        {process.map(([step, detail], i) => (
          <li><span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span><h3>{step}</h3><p>{detail}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="faq" aria-labelledby="faq-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-heading">Android and iOS app development questions, answered</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary><span>{f.question}</span><span class="faq-mark" aria-hidden="true">+</span></summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== RELATED ===================== -->
  <section class="locations" aria-labelledby="nearby-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Related</p>
        <h2 id="nearby-heading">More services and locations</h2>
      </div>
      <div class="city-cloud">
        {links.map((c) => <a class="city-chip" href={c.href}>{c.name}</a>)}
      </div>
    </div>
  </section>

  <!-- ===================== CLOSING CTA ===================== -->
  <section class="closing" aria-labelledby="cta-heading">
    <div class="section-wrap">
      <div class="closing-inner">
        <p class="eyebrow">Next step</p>
        <h2 id="cta-heading">Tell us about your app idea</h2>
        <p class="closing-note">
          Send a few lines about your users and what the app should do. You get a screen list, a timeline and an itemised quote,
          usually within two working days. Nothing is billed until you approve it.
        </p>
        <div class="hero-actions closing-actions">
          <a class="btn-primary" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp us</span><span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-ghost" href={siteContact.emailHref}>{siteContact.email}</a>
        </div>
        <p class="closing-links"><a href="/services/">All services</a> · <a href="/pricing/">Pricing</a> · <a href="/portfolio/">Portfolio</a> · <a href="/countries/">Countries</a></p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Copied from src/components/city/CityPage.astro; keep the two in sync. */
  :root {
    --paper: #FDFCFB;
    --surface: #F8F9FA;
    --surface-low: #F3F4F5;
    --midnight: #0F172A;
    --slate: #334155;
    --slate-muted: #64748B;
    --gold: #D4AF37;
    --gold-muted: #C5A059;
    --hairline: rgba(15, 23, 42, 0.10);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --font: 'Hanken Grotesk', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  :global(body) { background: var(--paper); color: var(--midnight); }

  h1, h2, h3 { margin: 0; font-family: var(--font); color: var(--midnight); letter-spacing: -0.02em; font-weight: 700; }
  p { margin: 0; }
  section { scroll-margin-top: 5rem; }

  .section-wrap { max-width: 1280px; margin: 0 auto; padding: 0 clamp(1rem, 5vw, 5rem); }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 0.65rem; margin: 0 0 1.25rem;
    color: var(--gold-muted); font-family: var(--font); font-size: 0.75rem; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
  }
  .eyebrow::before { width: 1.75rem; height: 1px; background: var(--gold-muted); content: ""; flex-shrink: 0; }

  .section-head { max-width: 48rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .section-head h2 { font-size: clamp(1.75rem, 3.5vw, 2.6rem); line-height: 1.15; font-weight: 600; margin-bottom: 1rem; }
  .section-note { color: var(--slate); font-size: 1.05rem; line-height: 1.7; }

  /* Buttons */
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }
  .btn-primary, .btn-ghost {
    display: inline-flex; align-items: center; gap: 0.6rem; min-height: 3.1rem; padding: 0 1.6rem;
    border-radius: 2px; font-family: var(--font); font-size: 0.9rem; font-weight: 600; text-decoration: none;
    transition: all 250ms var(--ease);
  }
  .btn-primary { background: var(--midnight); color: var(--paper); border: 1px solid var(--midnight); }
  .btn-primary:hover { background: #1E293B; transform: translateY(-1px); }
  .btn-arrow { color: var(--gold); transition: transform 250ms var(--ease); }
  .btn-primary:hover .btn-arrow { transform: translateX(3px); }
  .btn-ghost { color: var(--midnight); border: 1px solid var(--hairline); background: transparent; }
  .btn-ghost:hover { border-color: var(--gold); }
  .btn-block { width: 100%; justify-content: center; }

  /* Hero */
  .hero { padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--hairline); }
  .hero-inner {
    max-width: 1280px; margin: 0 auto; padding: 0 clamp(1rem, 5vw, 5rem);
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr); gap: clamp(2rem, 4vw, 4rem); align-items: center;
  }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0 0 1.5rem; padding: 0; list-style: none; font-size: 0.8rem; color: var(--slate-muted); }
  .crumbs li + li::before { content: "/"; margin-right: 0.4rem; color: var(--hairline); }
  .crumbs a { color: var(--slate-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--midnight); }
  h1 { font-size: clamp(2.1rem, 4vw, 3.25rem); line-height: 1.12; margin-bottom: 1.25rem; }
  .lede { color: var(--slate); font-size: clamp(1rem, 1.3vw, 1.1rem); line-height: 1.7; max-width: 38rem; }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: 0.6rem; max-width: 46rem; margin: 1.6rem 0 0; padding: 0; list-style: none; }
  .facts li { display: grid; gap: 0.2rem; padding: 0.75rem 0.95rem; border: 1px solid var(--hairline); border-radius: 4px; background: #fff; }
  .facts strong { color: var(--gold-muted); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
  .facts span { color: var(--midnight); font-weight: 600; font-size: 0.92rem; line-height: 1.4; }
  .hero-pills { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.75rem 0 0; padding: 1.5rem 0 0; border-top: 1px solid var(--hairline); list-style: none; }
  .hero-pills li { padding: 0.35rem 0.8rem; border: 1px solid var(--hairline); border-radius: 2px; color: var(--slate); font-size: 0.8rem; font-weight: 500; }
  .hero-origin { display: flex; align-items: center; gap: 0.5rem; margin-top: 1.25rem; color: var(--slate-muted); font-size: 0.8rem; font-weight: 500; }
  .origin-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); flex-shrink: 0; }

  .quote-card {
    padding: clamp(1.5rem, 3vw, 2.25rem); background: var(--midnight); color: #F8F9FA; border-radius: 4px;
    box-shadow: 0 24px 50px -20px rgba(15, 23, 42, 0.45);
  }
  .quote-kicker { color: var(--gold); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 1rem; }
