---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";
import { itServicesRegions, regionPath } from "@data/it-services/locations";

const content = locationContent("it-services");
const links = uniqueLinks(itServicesRegions.map((r) => ({ name: r.name, href: regionPath(r) })), cityLinks(content.nearby));
---

<CityPage
  name="India"
  state="India"
  areaType="Country"
  path="/it-services/"
  crumbs={[{ label: "IT Services", href: "/it-services/" }]}
  content={content}
  links={links}
/>
