---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";
import { cityPath, itServicesRegions, regionPath, type ItServicesRegion } from "@data/it-services/locations";

export function getStaticPaths() {
  return itServicesRegions.map((region) => ({ params: { region: region.slug }, props: { region } }));
}

interface Props {
  region: ItServicesRegion;
}

const { region } = Astro.props;
const content = locationContent(`it-services--${region.slug}`);
const links = uniqueLinks(region.cities.map((c) => ({ name: c.name, href: cityPath(region, c) })), cityLinks(content.nearby));
---

<CityPage
  name={region.name}
  state={region.name}
  areaType="State"
  path={regionPath(region)}
  crumbs={[{ label: "IT Services", href: "/it-services/" }, { label: region.name, href: regionPath(region) }]}
  content={content}
  links={links}
/>
