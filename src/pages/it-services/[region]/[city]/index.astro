---
import CityPage from "@components/city/CityPage.astro";
import { cityLinks, locationContent, uniqueLinks } from "@data/locations";
import { cityPath, getNearbyCities, itServicesRegions, regionPath, type ItServicesCity, type ItServicesRegion } from "@data/it-services/locations";

export function getStaticPaths() {
  return itServicesRegions.flatMap((region) =>
    region.cities.map((city) => ({ params: { region: region.slug, city: city.slug }, props: { region, city } }))
  );
}

interface Props {
  region: ItServicesRegion;
  city: ItServicesCity;
}

const { region, city } = Astro.props;
const content = locationContent(`it-services--${region.slug}--${city.slug}`);
const links = uniqueLinks(
  getNearbyCities(region, city).map((c) => ({ name: c.name, href: cityPath(region, c) })),
  [{ name: region.name, href: regionPath(region) }],
  cityLinks(content.nearby),
);
---

<CityPage
  name={city.name}
  state={region.name}
  path={cityPath(region, city)}
  crumbs={[
    { label: "IT Services", href: "/it-services/" },
    { label: region.name, href: regionPath(region) },
    { label: city.name, href: cityPath(region, city) },
  ]}
  content={content}
  links={links}
/>
