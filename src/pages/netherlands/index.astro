const tocItems = [
  ...guide.map((g) => ({ id: g.id, heading: g.heading })),
  { id: "region-table-heading", heading: "Dutch regions at a glance" },
  { id: "industries-heading", heading: "Industries" },
  { id: "process-heading", heading: "Process and timelines" },
  { id: "faq-heading", heading: "FAQs" },
];

const related = [
  { name: "All countries we serve", href: "/countries/" },
  { name: "IT services in Japan", href: "/japan/" },
  { name: "India", href: "/india/" },
  { name: "United Kingdom", href: "/uk/" },
  { name: "United States", href: "/usa/" },
  { name: "Canada", href: "/canada/" },
  { name: "Australia & New Zealand", href: "/australia/" },
  { name: "UAE & Middle East", href: "/uae/" },
];

// ---------- Structured data ----------

const nl = { "@type": "Country", name: "Netherlands" };
const provinces = ["North Holland", "South Holland", "Utrecht", "North Brabant", "Gelderland", "Overijssel", "Limburg", "Groningen", "Friesland", "Drenthe", "Flevoland", "Zeeland"];
const nlCities = ["Amsterdam", "Rotterdam", "The Hague", "Utrecht", "Eindhoven", "Groningen", "Tilburg", "Almere", "Breda", "Nijmegen", "Arnhem", "Haarlem", "Enschede", "Apeldoorn", "Amersfoort", "Zwolle", "Leiden", "Delft", "Maastricht", "Leeuwarden"];

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${url}#service`,
  name: `${siteBrand.name}: web development for businesses in the Netherlands`,
  url,
  image: new URL("/banner_logo.png", siteBrand.domain).toString(),
  description: page.description,
  email: siteContact.email,
  telephone: siteContact.phone,
  priceRange: `${usd("Maintenance")} – ${usd("Custom web app")}+`,
  currenciesAccepted: "USD, EUR",
  paymentAccepted: "Bank transfer, SEPA transfer via Wise",
  address: { "@type": "PostalAddress", addressCountry: "IN" },
  knowsLanguage: ["en"],
  areaServed: [
    nl,
    ...provinces.map((name) => ({ "@type": "State", name, containedInPlace: nl })),
    ...nlCities.map((name) => ({ "@type": "City", name, containedInPlace: nl })),
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Website development, SEO and IT services for Dutch businesses (starting prices)",
    itemListElement: pricingPlans.map((plan) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: plan.name, description: plan.summary },
      areaServed: nl,
      priceSpecification: {
        "@type": "PriceSpecification",
        minPrice: Number(usdPrice(plan.price).replace(/[^\d]/g, "")),
        priceCurrency: "USD",
        ...(plan.unit ? { unitText: plan.unit } : {}),
      },
    })),
  },
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${url}#webpage`,
  url,
  name: page.title,
  description: page.description,
  inLanguage: "en",
  about: { "@id": `${url}#service` },
  speakable: { "@type": "SpeakableSpecification", cssSelector: ["#quick-answer", "h1"] },
};
const servicePages = countryPageLinks("netherlands");
---

<BaseLayout meta={page} schema={[webPageSchema, professionalServiceSchema, breadcrumbListSchema(page.breadcrumbs), faqSchema(faqs)]}>

  <!-- ===================== HERO ===================== -->
  <section class="hero" aria-labelledby="country-heading">
    <div class="hero-inner">
      <div class="hero-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            {page.breadcrumbs.map((b, i) => (
              <li>{i + 1 === page.breadcrumbs.length ? <span aria-current="page">{b.label}</span> : <a href={b.href}>{b.label}</a>}</li>
            ))}
          </ol>
        </nav>
        <p class="eyebrow">Netherlands · Remote from India</p>
        <h1 id="country-heading">{page.h1}</h1>
        <p class="lede">{page.intro}</p>
        <ul class="facts" aria-label="Quick facts for Dutch clients">
          {facts.map(([label, value]) => <li><strong>{label}</strong><span>{value}</span></li>)}
        </ul>
        <div class="hero-actions">
          <a class="btn-primary" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp for a free quote</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-ghost" href={siteContact.emailHref}>{siteContact.email}</a>
        </div>
        <ul class="hero-pills" aria-label="What we build for Dutch businesses">
          {pills.map((p) => <li>{p}</li>)}
        </ul>
        <p class="hero-origin">
          <span class="origin-dot" aria-hidden="true"></span>
          Team based in India &middot; Remote delivery to the Netherlands &middot; No Dutch office
        </p>
      </div>

      <aside class="quote-card" aria-label="Starting prices for Dutch clients">
        <p class="quote-kicker">Netherlands starting prices (USD)</p>
        <ul class="quote-rows">
          {pricingPlans.slice(0, 5).map((plan) => (
            <li><span>{plan.name}</span><strong><small>from </small>{usd(plan.name)}</strong></li>
          ))}
        </ul>
        <p class="quote-foot">Starting prices; the final quote depends on your requirements. EUR invoices on request via Wise (SEPA) or wire. 5 months maintenance free after launch.</p>
        <a class="btn-primary btn-block" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
          <span>Get my quote</span><span class="btn-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </aside>
    </div>
  </section>

  <!-- ===================== STATS ===================== -->
  <section class="stats-section" aria-label="BtechWaleTech for Dutch clients in numbers">
    <div class="section-wrap">
      <ul class="stat-band">
        {stats.map((s) => (
          <li><span class="stat-num">{s.value}</span><span class="stat-label">{s.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== QUICK ANSWER + SNAPSHOT ===================== -->
  <section class="answer" aria-labelledby="answer-heading">
    <div class="section-wrap answer-grid">
      <div>
        <p class="eyebrow">The short answer</p>
        <h2 id="answer-heading">Looking for web developers for your Dutch business?</h2>
        <p id="quick-answer" class="answer-text">BtechWaleTech is a three-engineer team based in India that builds websites, webshops with iDEAL, SEO systems, custom software and AI automation for businesses in the Netherlands, working remotely. Websites start from {usd("Static")}, webshops from {usd("Ecommerce")} and custom web apps from {usd("Custom web app")}. Every price is a starting price, invoices can be in EUR, our day overlaps almost all of the Dutch office day, and the first five months of maintenance are free.</p>
