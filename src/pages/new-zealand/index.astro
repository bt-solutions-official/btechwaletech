// ---------- Hero, stats and snapshot ----------

const facts = [
  ["Team", "Engineers based in India, remote delivery"],
  ["Starting price", `Websites from ${usd("Static")}`],
  ["Call window", "Your afternoon, our early morning"],
  ["Invoicing", "USD, or NZD on request via Wise or wire"],
  ["After launch", "5 months of maintenance free"],
  ["Coverage", "All 16 regions, North and South Island"],
];

const pills = ["Business websites", "Shopify & WooCommerce", "SEO for google.co.nz", "Windcave & Afterpay checkout", "Te reo Māori support", "Xero automation"];

const stats = [
  { value: "3", label: "Engineers you talk to directly" },
  { value: usd("Static"), label: "Websites starting price" },
  { value: "5", label: "Months maintenance free" },
  { value: "16", label: "Regions served remotely" },
];

const snapshot = [
  { label: "Who we are", value: "Three engineers based in India: full stack, AI and cloud, and project delivery" },
  { label: "How we work", value: "Mostly asynchronous, with calls in your afternoon and a private staging link" },
  { label: "What we build", value: "Websites, ecommerce, SEO, custom software, web apps, AI automation, maintenance" },
  { label: "Checkout options we set up", value: "Windcave, Stripe, Shopify Payments, PayPal, Afterpay and POLi where available" },
  { label: "Language", value: "New Zealand English, with macrons and te reo Māori content supported" },
  { label: "Starting prices", value: `From ${usd("Static")} for a website; every figure is a starting price in USD` },
  { label: "After launch", value: `5 months of free maintenance, then from ${usd("Maintenance")} or as needed` },
];

// ---------- Services bento ----------

const services = [
  { name: "Website design & development", note: "Quick, mobile-first sites on Astro, Next.js or WordPress, in New Zealand English, with enquiries delivered to your inbox, phone or CRM.", href: "/services/web-development/", size: "lg" },
  { name: "SEO & local SEO", note: "Technical SEO, content and town-level local search for google.co.nz, with en-NZ and en-AU hreflang for trans-Tasman sites.", href: "/services/seo-services/", size: "md" },
  { name: "Online stores", note: "Shopify, WooCommerce or custom builds with Windcave, Stripe or Afterpay, GST-inclusive NZD pricing and NZ Post or courier rates.", size: "sm" },
  { name: "Custom software", note: "Booking systems, portals, quoting tools and dashboards for teams that have outgrown spreadsheets.", size: "sm" },
  { name: "Android & iOS apps", note: `Android and iPhone apps for staff in the field or for customers, on Google Play and the App Store, from ${usd("Android")}.`, size: "sm" },
  { name: "AI automation", note: "Enquiries, jobs, bookings and invoices flowing between your website, Xero, Tradify or Timely.", size: "sm" },
  { name: "Bilingual content", note: "Te reo Māori and English pages with correct macrons, language tags and navigation.", size: "sm" },
  { name: "Maintenance & support", note: "Updates, fixes, backups and speed checks, with the first 5 months after launch included.", size: "sm" },
] as const;

// ---------- Comparison ----------

const comparison = [
  ["Starting price", "Highest, covering NZ salaries, premises and account management", "Lowest headline price, very uneven quality", `From ${usd("Static")} for a website, itemised in writing`],
  ["Who builds it", "A team, often behind a project manager", "One person, sometimes subcontracting", "The three engineers on your calls"],
  ["Live contact", "Your whole working day", "Unpredictable", "Your afternoon, plus written async updates"],
  ["Scope in writing", "Usually, after a paid discovery", "Often just a job post", "Always, before the first payment"],
  ["SEO basics", "Frequently an add-on", "Often left out", "Titles, schema, sitemap and Search Console included"],
  ["After launch", "Retainer or hourly from day one", "Contact often lapses", "5 months of maintenance included"],
  ["Ownership", "Varies by contract", "Check the terms carefully", "Code, domain, hosting and logins in your name"],
  ["Face-to-face", "Yes, if nearby", "No", "No: remote only, stated upfront"],
];

// ---------- Process ----------

const process = [
  ["Talk", "A video call in your afternoon or a WhatsApp conversation about your business, customers and budget. Free."],
  ["Scope & quote", "Page list, features, integrations, timeline and an itemised quote in USD or NZD, agreed in writing."],
  ["Design", "Sitemap and wireframes, then visual designs for the key pages, checked on your own phone."],
  ["Build on staging", "A private staging link you can open any time, with a written note whenever it changes."],
  ["Test & SEO", "Titles, schema, redirects, macrons, speed, forms, GST display and payments tested before launch."],
  ["Launch & support", "Domain pointed, Search Console verified, logins handed over, then 5 months of free maintenance."],
];

// ---------- Industries table ----------

const industries = [
  { name: "Trades and construction", need: "Proof of work, licensing such as LBP status where relevant, areas covered and a quick way to request a quote", build: "Fast sites with click-to-call, project galleries, quote forms feeding Tradify or ServiceM8, review request flows" },
  { name: "Tourism and hospitality", need: "Seasonal availability, honest inclusions, real photos and booking that works for overseas visitors", build: "Tour and accommodation sites, booking engine links, multi-currency display, content timed for the season" },
  { name: "Agriculture and agritech", need: "Product specifications, dealer or rep contacts, compliance details and technical documentation", build: "Catalogue sites, dealer locators, product data sheets, B2B enquiry and ordering portals" },
  { name: "Food, wine and producers", need: "Where the product comes from, how to buy it, shipping rules and age checks for alcohol", build: "Direct-to-consumer stores, wine clubs, R18 age confirmation, courier and rural delivery rules" },
  { name: "Health, wellness and beauty", need: "Practitioner details, services and prices, and online booking without phone tag", build: "Clinic and salon sites, booking links to Timely or practice software, accessible layouts, careful health claims" },
  { name: "Professional services", need: "Credentials, specialist areas, clear fees where possible and answers to first questions", build: "Clean, quick sites with team profiles, insights articles and secure document upload" },
  { name: "Education and training", need: "Programme details, intakes, fees, entry requirements and a clear path to enrol", build: "Course pages, enquiry and enrolment flows, international student information, CRM integration" },
  { name: "Retail and online brands", need: "Product detail, GST-inclusive NZD prices, delivery times including rural, and returns", build: "Shopify or WooCommerce stores, Afterpay, NZ Post and courier integration, Xero sync" },
  { name: "Community and not-for-profit", need: "Plain explanations, event listings, volunteer sign-ups and a simple way to donate", build: "Accessible sites, donation pages, event calendars, bilingual te reo Māori and English content" },
];

// ---------- Long-form guide (paragraph strings may contain inline HTML) ----------

interface GuideTable { caption: string; head: string[]; rows: string[][]; hideSm?: number[] }
interface GuideSection { id: string; heading: string; paragraphs: string[]; list?: string[]; after?: string[]; table?: GuideTable }

const guide: GuideSection[] = [
  {
    id: "who-we-are",
    heading: "A remote engineering team for New Zealand businesses",
    paragraphs: [
      "We are three engineers working from India. Ankur Kumar builds the websites and applications as our full stack developer. Santosh Sharma covers AI and machine learning, AWS and cloud deployment, data science and technical SEO. Vedansh Shrivastava looks after project management, data science, AI and automation. That is the whole team. When you talk to us, you are talking to the people who will write your code, set up your hosting and fix the bug you report next month.",
      "Everything we do for New Zealand clients is done remotely. We do not have an office in Auckland, a registered New Zealand company or a local phone number, and we are not going to imply otherwise with a virtual address. If your procurement policy requires a New Zealand entity, on-site workshops or staff with local security vetting, we are the wrong choice and we will tell you so early.",
      "Where we fit well is with small and growing businesses, sole traders, charitable trusts, startups and internal teams who need solid engineering at a price that makes sense for a New Zealand-sized market. A local agency may be priced for businesses with larger budgets; a cheap marketplace freelancer may disappear after the final payment. We sit between those: a small, accountable team with a documented process and published starting prices.",
      "Working with us looks like this. We agree a written scope before any money changes hands. Early in the project you get a private staging link where the real website takes shape, and you can check it on your phone at the cafe or on the desktop in the office. Every change we make is summarised in writing. Calls are short and happen in your afternoon, and the bulk of the collaboration runs through written comments, which suits the time difference and leaves you with a clear record of every decision.",
      "The time difference is the main thing to understand before hiring us. New Zealand is 6.5 to 7.5 hours ahead of India, which is the biggest gap of any market we serve in the Asia-Pacific. It is manageable, and in some ways useful, but it does mean we rely on asynchronous work more than we would with an Australian or Singaporean client. The time-zone section below sets out exactly how it works.",
    ],
  },
  {
    id: "services-detail",
    heading: "What we build for New Zealand businesses",
    paragraphs: [
      "<strong>Websites.</strong> Business websites, landing pages and content-led sites on Astro or Next.js, or on WordPress when your team wants to edit pages without a developer. For most service businesses we suggest a static site because it is quick on rural broadband and mobile networks, inexpensive to host, and has very little attack surface. The static plan covers up to 100 pages, responsive design, enquiry forms, hosting, SSL and deployment. Copy is set in New Zealand English: organisation, colour, enquiry and programme, prices in NZD with GST included for consumers, dates in day-month-year order and phone numbers in the +64 format. Details are on the <a href=\"/services/web-development/\">web development service page</a>.",
      "<strong>Large SEO websites.</strong> A 700+ page site makes sense for a small number of New Zealand businesses: a national service with genuine regional detail, a directory or listings site, or a large product range. The plan includes keyword and page planning, schema, a sitemap and internal linking, from design through to deployment. In a country with fewer towns and less search volume than larger markets, we are careful not to produce hundreds of near-identical pages that nobody searches for. Scale only helps when each page answers a real query.",
      "<strong>Online stores.</strong> Shopify, WooCommerce or custom ecommerce with the payment providers New Zealand shoppers expect, GST-inclusive NZD pricing, shipping rules that account for rural delivery and the Cook Strait, and orders synced to Xero. The ecommerce section below goes deeper.",
      "<strong>SEO for google.co.nz.</strong> Monthly SEO covers technical fixes, on-page work, content and local search. For businesses serving a town or region we focus on service pages, Google Business Profile guidance and the directories New Zealanders use. Stores that ship nationwide get the attention on category and product pages instead. More on the <a href=\"/services/seo-services/\">SEO services page</a>.",
      "<strong>Custom software and web apps.</strong> Booking systems for tour operators, quoting tools for manufacturers, portals for clients to upload documents to an accountant, dashboards that pull data from several systems, and internal tools for teams that have outgrown spreadsheets. When a business asks for a mobile app, we often suggest a progressive web app instead: it installs from the browser, works on iPhone and Android, and updates without app store review or fees.",
      "<strong>AI automation.</strong> Practical automations that remove admin: an enquiry from the website becomes a job in Tradify with an acknowledgement text to the customer; a paid order creates an invoice in Xero; a booking in Timely triggers a reminder and a follow-up review request; an AI assistant drafts replies to common questions or sorts incoming emails, with a person checking anything important. We map the process first and automate second.",
      "<strong>Maintenance.</strong> Once hosting goes live, five months of maintenance are included: content edits, bug fixes, security updates, backups, uptime and speed monitoring and basic SEO health checks. After that, maintenance starts from " + usd("Maintenance") + ", or you can simply contact us when something needs doing. Full starting prices are on the <a href=\"/pricing/\">pricing page</a>.",
    ],
  },
  {
    id: "ecommerce-nz",
    heading: "Ecommerce in New Zealand: Windcave, POLi, Stripe, Afterpay and delivery",
    paragraphs: [
      "New Zealand online shoppers are used to buying from large Australian and international stores, so a local store has to match their checkout experience while offering something they cannot get elsewhere: local stock, faster delivery, New Zealand-made products or better service. A clumsy checkout undoes all of that.",
      "<strong>Choosing a platform.</strong> Shopify is the usual recommendation for small and mid-sized stores because it is managed, reliable and easy for staff to run, and it has apps for New Zealand couriers and accounting. WooCommerce suits businesses already invested in WordPress or wanting to avoid platform subscription fees. A custom build suits B2B ordering with account pricing, unusual product configuration, or a catalogue that platforms handle poorly. We explain the trade-offs for your case and recommend one.",
      "<strong>Windcave.</strong> Windcave, the New Zealand payment company formerly known as Payment Express, is widely used by New Zealand merchants, especially those that also take in-person payments on its terminals. It integrates with WooCommerce, many other platforms and custom builds, and supports hosted payment pages that keep card data off your website. If you already use Windcave in store, keeping online payments with them often simplifies reconciliation.",
      "<strong>Stripe, Shopify Payments and PayPal.</strong> Stripe and Shopify Payments are straightforward to set up for card payments, Apple Pay and Google Pay, which matter because much New Zealand shopping happens on phones. PayPal is still expected by some buyers, particularly overseas customers. Compare current fees, payout timing and dispute handling before choosing; every merchant account is opened and verified in your name.",
      "<strong>POLi and bank payments.</strong> Some New Zealand shoppers prefer paying directly from their bank account rather than by card. Account-to-account options such as POLi have been used for this, but provider coverage and platform support change over time, so we check what is currently available for your bank mix and platform before recommending it. For B2B orders, a plain bank transfer with the order held until payment is confirmed still works well.",
      "<strong>Afterpay.</strong> Buy now pay later is common in fashion, beauty, homeware and electronics, and Afterpay operates in New Zealand with plugins for the main platforms. Afterpay reviews your merchant application and sets the fees, which are usually higher than card fees, so weigh the likely lift in conversion against your margins. We add the checkout option and the product-page messaging, and test purchases and refunds end to end.",
      "<strong>Shipping and rural delivery.</strong> Shipping in New Zealand has its own quirks: rural delivery addresses and surcharges, inter-island freight, and customers on Waiheke, Stewart Island or the Chatham Islands. We configure rates by zone and address type, connect NZ Post and CourierPost, NZ Couriers, Aramex or an aggregator where you use one, and show realistic delivery times. Address autocomplete based on New Zealand address data reduces failed deliveries caused by typos.",
      "<strong>GST and Xero.</strong> GST in New Zealand is 15 per cent, and consumer prices are normally shown inclusive of it. GST-registered businesses need correct taxable supply information on their invoices, and we configure the store to your accountant's instructions. Most New Zealand small businesses use Xero, so we connect orders, fees and refunds so they flow into your books instead of being keyed in by hand. Your accountant confirms the tax settings; we implement them.",
      "<strong>Consumer protection.</strong> The Consumer Guarantees Act and the Fair Trading Act apply online as they do in a shop. Returns pages cannot suggest customers have fewer rights than the law gives them, and claims about products must be accurate and able to be backed up. We build honest, clear checkout and policy templates, and you confirm the wording with your adviser.",
    ],
  },
  {
    id: "seo-nz",
    heading: "SEO for google.co.nz: local search, towns and hreflang",
    paragraphs: [
      "New Zealand is a small search market compared with Australia or the United States, and that changes the strategy. Search volumes for many service terms are modest, the same national chains and Australian retailers compete for product searches, and in many towns a well-built site with a properly maintained Google Business Profile can reach the top of local results sooner than it would in a bigger city. The opportunity is real, but it rewards precision rather than volume.",
      "<strong>Technical groundwork.</strong> Every site we launch has clean URLs, a single H1 per page, unique titles and descriptions, canonical tags, an XML sitemap submitted to Search Console, structured data for your business type and images compressed in modern formats. We test on throttled mobile connections, because rural broadband and mobile coverage outside the main centres still vary a lot, and a page that loads slowly in Taupō or on the West Coast loses the customer before they read anything.",
      "<strong>Google Business Profile and local directories.</strong> For a business serving local customers, the Google Business Profile is often the most valuable listing it has. We guide you through choosing the right category, setting service areas if you travel to customers, adding services, hours and photos, and linking to the best page on your site. The profile must be verified and owned by you. We also check that your name, address and phone number are consistent on your website, your profile, Finda, Yellow, NoCowboys, Builderscrack, industry associations and social profiles.",
      "<strong>Towns, suburbs and service areas.</strong> A tradie in Christchurch might cover Rolleston, Rangiora and Lincoln; an Auckland business might serve the North Shore but not South Auckland. Pages for the areas you genuinely serve can help, provided each one has something specific to say. Thin pages with only the town name changed are a liability. We usually start with a handful of the most valuable areas and expand only when there is real content.",
      "<strong>Macrons and Māori place names.</strong> Many New Zealand places have Māori names written with macrons, such as Taupō, Whangārei, Ōtautahi and Kaikōura, and people search both with and without them. We use the correct spelling on the page, make sure URLs and internal search handle both forms, and write naturally so the page reads well to people and search engines alike.",
      "<strong>.nz, .co.nz and country signals.</strong> Google no longer lets you choose a target country in Search Console, so it reads other signals: a .nz or .co.nz domain, New Zealand addresses and phone numbers where you have them, NZD prices and content clearly written for New Zealanders. A .co.nz or .nz domain is a strong local signal; a .com works too, but then the content and hreflang have to do more of the work.",
      "<strong>hreflang for en-NZ and en-AU.</strong> Many New Zealand businesses also sell to Australia. Serving both countries from one set of pages leads to confused customers: wrong currency, wrong GST, wrong delivery times. We build separate en-NZ and en-AU versions, either in folders or on .co.nz and .com.au domains, with hreflang tags linking them and an x-default for everyone else, so google.co.nz shows the New Zealand pages and google.com.au shows the Australian ones.",
      "<strong>Reporting.</strong> Monthly SEO starts from " + usd("Monthly SEO") + " and comes with a straightforward monthly summary from Search Console: impressions, clicks, growing queries, what we changed and what comes next. We never promise rankings; anyone who guarantees a first-page position on google.co.nz is selling something they cannot control.",
    ],
  },
  {
    id: "te-reo-maori",
    heading: "Te reo Māori, macrons and bilingual websites",
    paragraphs: [
      "Te reo Māori is an official language of New Zealand, and more businesses, iwi organisations, schools, councils and community groups now use it on their websites, from greetings and headings to fully bilingual content. Doing it well is partly a technical job and partly a matter of respect, and we take care with both.",
      "On the technical side, macrons must display correctly in every font and on every device, which means choosing typefaces that include the characters and testing them, not assuming. Text in te reo Māori should be marked with the language code mi so screen readers pronounce it properly and search engines understand which language the content is in. Fully bilingual sites need a sensible structure, usually separate URLs for each language with a clear switcher and matching navigation, rather than a toggle that swaps text in the browser where search engines cannot see it.",
      "On the content side, we do not machine-translate te reo Māori and we do not invent translations. Wording should come from you, from a fluent speaker in your organisation, or from a translator you trust, and where content relates to a particular iwi or hapū, from the people it belongs to. Our job is to make sure that text is presented correctly, loads quickly and works for everyone who reads it.",
      "The same care applies to other languages. Auckland in particular is home to large Pacific and Asian communities, and some businesses benefit from pages in Samoan, Tongan, Chinese, Hindi or Korean. We build the multilingual structure and language tags; you or your translator supply and check the words.",
