  breadcrumbs: createBreadcrumbs([
    { label: "Countries", href: "/countries/" },
    { label: "New Zealand", href: "/new-zealand/" },
  ]),
  locale: "en_NZ",
  alternateLocales: ["en_AU"],
  ogImage: { url: "/banner_logo.png", alt: "BtechWaleTech, a remote web development and SEO team serving businesses across New Zealand", width: 1536, height: 1024 },
  keywords: [
    "web development company NZ",
    "web development company New Zealand",
    "web developers NZ",
    "website design NZ",
    "website design New Zealand",
    "SEO services NZ",
    "local SEO New Zealand",
    "ecommerce website development NZ",
    "Shopify developer NZ",
