---
import BaseLayout from "@layouts/BaseLayout.astro";
import { createPageSeo } from "@lib/seo/seo-config";
import { createBreadcrumbs } from "@lib/breadcrumbs/breadcrumbs";
import { breadcrumbListSchema, faqSchema } from "@lib/schema/schema";
import { canonicalUrl } from "@lib/urls/url-utils";
import { siteBrand, siteContact } from "@data/site/site-config";
import { pricingPlans, pricingNote, usdPrice } from "@data/pricing/plans";
import { usd } from "@data/countries/international";

// ---------- FAQ (visible list and FAQPage schema share this array) ----------

const faqs = [
  {
    question: "Are you a New Zealand web design company?",
    answer: "No. BtechWaleTech is a small team of engineers based in India that works remotely with New Zealand businesses. We have no office, staff or address in New Zealand, and no NZBN. What you get instead is direct contact with the engineers who build your site, written scopes and starting prices well below typical local agency rates.",
  },
  {
    question: "What does a website cost for a New Zealand business?",
    answer: `A static website of up to 100 pages starts from ${usd("Static")}, a 700+ page SEO website from ${usd("SEO website")}, AI automation from ${usd("AI automation")}, an ecommerce store from ${usd("Ecommerce")} and a custom web app from ${usd("Custom web app")}. Ongoing SEO is from ${usd("Monthly SEO")} and ongoing maintenance from ${usd("Maintenance")}. All are starting prices in US dollars, and the final quote depends on your requirements.`,
  },
  {
    question: "Can you invoice in New Zealand dollars?",
    answer: "Yes, if you ask. The default is US dollars, and on request we issue the invoice in NZD using the exchange rate on the day we quote. Paying through Wise lets you send an ordinary domestic transfer from your NZ bank account; an international wire from your bank also works. Payments are split into milestones.",
  },
  {
    question: "Is New Zealand GST included in your prices?",
    answer: "No. Our starting prices are in US dollars and do not include New Zealand GST. We supply from overseas, so ask your accountant how an imported service should be treated in your GST return. We are happy to include your business name, NZBN or other details on the invoice.",
  },
  {
    question: "New Zealand is 6.5 to 7.5 hours ahead of India. How do meetings work?",
    answer: "Honestly, the live overlap is short, so we plan around it. Calls usually happen in your mid-to-late afternoon, which is our morning, and we can start from 7am IST by arrangement so a call lands around 1:30pm in winter or 2:30pm in summer. Most of the work runs asynchronously: you send feedback during your day and wake up to the changes and a written update.",
  },
  {
    question: "Do you work with businesses outside Auckland?",
    answer: "Yes. We work with businesses in every region, remotely: Auckland, Wellington, Canterbury and Christchurch, Waikato and Hamilton, Bay of Plenty and Tauranga, Otago, Dunedin and Queenstown, and everywhere else from Northland to Southland. Regional businesses get the same process and starting prices.",
  },
  {
    question: "Can you set up Windcave, POLi, Stripe or Afterpay on our online store?",
    answer: "Yes. We integrate the payment providers you choose, such as Windcave, Stripe, Shopify Payments or PayPal for cards, Afterpay for buy now pay later, and account-to-account bank payment options such as POLi where the provider currently supports your platform and bank. Merchant accounts are opened in your business name.",
  },
  {
    question: "Can you help us rank on google.co.nz?",
    answer: "We work on what we can control: technical SEO, site structure, page speed, content written for New Zealand searches, LocalBusiness schema, internal links and hreflang if you have separate New Zealand and Australian pages. We guide you through your Google Business Profile, which you verify yourself. Nobody can guarantee rankings, and we report honestly on what moved.",
  },
  {
    question: "Does the Privacy Act 2020 apply to small businesses?",
    answer: "Generally yes. Unlike Australia's law, New Zealand's Privacy Act 2020 has no small business exemption, so a sole trader collecting names and emails through a website form is covered. We build forms that collect only what you need, with clear notices and secure storage. We are engineers, not lawyers, so please get privacy wording checked by an adviser.",
  },
  {
    question: "What do we need for email marketing sign-ups?",
    answer: "The Unsolicited Electronic Messages Act 2007 requires consent before sending commercial emails or texts, accurate sender details and a working unsubscribe. We build sign-up forms with unticked consent boxes and plain wording, and connect them to email tools that handle unsubscribes automatically. Your adviser should confirm the details for your situation.",
  },
  {
    question: "Can our website include te reo Māori?",
    answer: "Yes. We support macrons properly in content, URLs and search, mark te reo Māori text with the correct language code so screen readers and search engines handle it well, and can build bilingual pages. The text itself should come from you or a fluent speaker or translator you trust; we do not machine-translate te reo Māori.",
  },
  {
    question: "Can you register our .nz or .co.nz domain?",
    answer: "You register it in your own name through a New Zealand or international registrar and give us DNS access, or we guide you through it. Registering .nz names does not require a New Zealand business, but the registrant should always be you. We then connect hosting, SSL and email records and document the setup.",
  },
  {
    question: "Where will our website be hosted?",
    answer: "Static sites usually run on a global CDN with edge locations close to New Zealand, so pages load quickly in Auckland and Invercargill alike. Apps with a database can run in an Australian or New Zealand cloud region where data location or latency matters. Hosting accounts are always opened in your name.",
  },
  {
    question: "We sell to Australia too. Can the website handle both countries?",
    answer: "Yes. We can build separate New Zealand and Australian versions with their own prices in NZD and AUD, GST treatment, delivery rules and spelling, linked with hreflang tags for en-NZ and en-AU so each country's Google shows the right version. Australian consumer law and privacy rules differ from New Zealand's, so your adviser should check both.",
  },
  {
    question: "Can you connect our website to Xero, Tradify or Timely?",
    answer: `Usually. Xero, Tradify, Timely, ServiceM8 and similar tools have APIs or automation connectors, so enquiries, bookings, jobs and invoices can move between your website and the software you use without retyping. We map the workflow before quoting. AI automation starts from ${usd("AI automation")}.`,
  },
  {
    question: "Who owns the website when it is finished?",
    answer: "You do. The code, content, design files, hosting account, domain and every admin login are handed over in accounts under your name. You can take the site to another developer at any time without asking our permission.",
  },
  {
    question: "What does the five months of free maintenance cover?",
    answer: `From the day hosting goes live, five months of maintenance are included: content and price updates, bug fixes, security updates, backups and uptime and speed checks. After that you can continue from ${usd("Maintenance")} or simply get in touch when something needs changing.`,
  },
  {
    question: "How long will our project take?",
    answer: "Typical timelines are one to two weeks for a static website, three to five weeks for a 700+ page SEO website, two to four weeks for AI automation, four to eight weeks for an ecommerce store and six to twelve weeks for a custom web app. Slow content and approvals delay projects far more than the time difference does.",
  },
  {
    question: "Can we meet you in person in New Zealand?",
    answer: "No. We are a remote team in India and do not travel to client sites. Everything happens over video calls, WhatsApp, email and a shared staging link, and every decision is confirmed in writing.",
  },
  {
    question: "How do we start?",
    answer: "Send us a WhatsApp message or an email describing your business, what you need and a few websites you like. Expect a few questions back, followed by a written scope, a timeline and an itemised quote, normally inside two working days. Work begins once you approve the scope and pay the first milestone.",
  },
];

// ---------- Page meta ----------

const page = createPageSeo({
