  site: usd("Static"),
  seoSite: usd("SEO website"),
  shop: usd("Ecommerce"),
  app: usd("Custom web app"),
  ai: usd("AI automation"),
  seo: usd("Monthly SEO"),
  care: usd("Maintenance"),
};
const updated = "2026-09-21";

