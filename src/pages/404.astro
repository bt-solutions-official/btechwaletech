---
import BaseLayout from "@layouts/BaseLayout.astro";
import { staticPage } from "@data/page-seo/static-pages";

const page = staticPage("/404/", "Page Not Found");
---

<BaseLayout meta={{ ...page, robots: "noindex,follow" }}>
  <h1>{page.h1}</h1>
  <p>The page you requested does not exist. Use the navigation or return to the homepage to find BtechWaleTech services, locations, pricing, and contact details.</p>
</BaseLayout>
