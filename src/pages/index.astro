---
import BaseLayout from "@layouts/BaseLayout.astro";
import { createPageSeo } from "@lib/seo/seo-config";
import { createBreadcrumbs } from "@lib/breadcrumbs/breadcrumbs";
import { faqSchema } from "@lib/schema/schema";
import { siteContact } from "@data/site/site-config";
import { pricingPlans, usdPrice } from "@data/pricing/plans";
import { Image } from "astro:assets";
import heroImage from "../assets/images/heromain.png";
import cricketTakenImg from "../assets/images/crickettaken.png";
import cities from "@data/cities/cities.json";
import type { CityListing } from "@data/cities/types";

const faqs = [
  {
    question: "Do you build both static and dynamic websites?",
    answer:
      "Yes. We build static websites for SEO pages, portfolios, landing pages, and business sites, plus dynamic websites and web apps with dashboards, logins, databases, APIs, payments, and admin panels.",
  },
  {
    question: "Which IT services does Btechwale provide?",
    answer:
      "BtechWaleTech is a freelance IT services group providing website development, web design, deployment, SEO, ecommerce, custom software, AI automation, AI agents, multi-agent workflows, data analysis, and long-term support.",
  },
  {
    question: "Do you work with businesses in the USA, UK, Canada, Australia, and other countries?",
    answer:
      "Yes. We work remotely with businesses in the USA, UK, Canada, Australia, UAE, Singapore, Europe, and India. You get the same engineers, the same written scope, and the same 5 months of free maintenance wherever you are. Calls are scheduled in your business hours, and all communication is in English over WhatsApp, email, Google Meet, or Zoom.",
  },
  {
    question: "Why hire website developers from India instead of a local agency?",
    answer:
      "Cost and directness. A business website from a US or UK agency commonly runs into thousands of dollars or pounds, while our static websites start from US$150 and custom web apps from US$900. You also talk to the engineers building your site, not an account manager. You keep 100% ownership of the code, domain, and hosting accounts.",
  },
  {
    question: "How do international clients pay, and in which currency?",
    answer:
      "International projects are invoiced in USD (or your local currency on request) and paid by bank wire, Wise, or PayPal. Indian clients pay in INR by UPI or bank transfer. Payments are split into milestones: a deposit to start, a payment at staging review, and the balance on launch.",
  },
  {
    question: "How do you handle time zones with US, UK, and Australian clients?",
    answer:
      "We work from India (IST) and keep a fixed overlap window for each region: US Eastern mornings, UK business hours from late morning, and Australian afternoons. Async updates, a shared staging link, and written progress notes mean work moves forward while you sleep.",
  },
  {
    question: "Will my website be SEO friendly from day one?",
    answer:
      "Every website is planned with clean URLs, semantic HTML, title tags, meta descriptions, canonical URLs, sitemap support, schema foundations, performance basics, and crawlable static content where possible.",
  },
  {
    question: "Do you handle everything end to end, including hosting and deployment?",
    answer:
      "Yes. We handle the full delivery flow: requirements, page structure, web design, frontend and backend development, SEO setup, hosting, deployment, and testing. You are not coordinating between separate providers, and after hosting goes live you get 5 months of maintenance included free.",
  },
  {
    question: "What is included in the 5 months of free maintenance?",
    answer:
      "After your site is hosted and live, the next 5 months of maintenance cost nothing extra. That covers content and text updates, bug fixes, dependency and security updates, backups, uptime and speed checks, and basic SEO health checks. After that you can continue on a monthly plan from ₹8,000 (US$120) or just contact us when something needs changing.",
  },
  {
    question: "How much does a website cost?",
    answer:
      "A static website of up to 100 pages starts from ₹10,000 (US$150) and a 700+ page SEO website from ₹20,000 (US$300). Ecommerce starts from ₹50,000 (US$750), AI automation from ₹40,000 (US$600), and custom web applications from ₹60,000 (US$900). These are starting points: the final cost depends on pages, features, integrations, and content, so you get an itemised estimate.",
  },
  {
    question: "Do you provide AI automation and data analysis services?",
    answer:
      "Yes. We build practical AI automations, AI agents, workflow automation, dashboards, reporting systems, data cleaning, data analysis, and integrations that reduce manual work and improve decisions.",
  },
];

const page = createPageSeo({
  title: "Website Development & IT Services for USA, UK & India",
  description:
    "Hire website developers for businesses in the USA, UK, Canada, Australia, UAE & India. Web design, SEO, Android & iOS apps, ecommerce & AI from US$150.",
  canonicalPath: "/",
  h1: "Website development & IT services for businesses worldwide",
  intro:
    "BtechWaleTech is a team of engineers building fast, SEO-ready websites, Android and iOS apps, web apps, ecommerce stores, and AI automations for businesses in the USA, UK, Canada, Australia, UAE, and India, at a fraction of typical agency cost.",
  breadcrumbs: createBreadcrumbs([]),
  locale: "en_US",
  alternateLocales: ["en_GB", "en_CA", "en_AU", "en_IN"],
  keywords: [
    "website development company",
    "web development services",
    "hire website developers",
    "hire web developers from India",
    "offshore website development",
    "outsource web development",
    "affordable web design company",
    "website development USA",
    "website design company UK",
    "web developers Canada",
    "web development Australia",
    "website development Dubai UAE",
    "SEO services USA UK",
    "custom web application development company",
    "Android and iOS app development",
    "mobile app development company India",
    "Flutter app development",
    "React Native app development",
    "ecommerce website developers",
    "IT outsourcing India",
    "freelance IT services India",
    "freelance web development India",
    "website development services India",
    "website design and development India",
    "static website development",
    "dynamic website development",
    "custom web application development",
    "software development services India",
    "SEO services India",
    "local SEO services",
    "technical SEO agency",
    "ecommerce website development",
    "online store development India",
    "AI development services",
    "AI automation services India",
    "AI agents development",
    "multi agent AI workflows",
    "data analysis services India",
    "business automation services India",
    "website maintenance services",
    "website deployment services",
    "website redesign services",
    "hire web developers India",
    "web development Gurgaon",
    "web development Mumbai",
    "web development Bangalore",
    "website development Delhi NCR",
    "global IT services provider",
    "offshore web development India",
    "responsive website design",
    "freelance web developer India",
  ],
  ogImage: {
    url: "/banner_logo.png",
    alt: "Btechwale banner logo",
    width: 1536,
    height: 1024,
  },
});

const services = [
  {
    name: "Website development",
    summary:
      "Static and dynamic websites, landing pages, portfolios, business sites, and web apps built from design to deployment.",
    points: ["Business websites", "Landing pages", "Dynamic web apps", "Hosting and deployment"],
    href: "/services/web-development/",
    size: "lg",
  },
  {
    name: "SEO services",
    summary: "Technical SEO, local SEO, metadata, sitemap, schema, page structure, and content planning for search visibility.",
    points: ["Technical SEO setup", "Local SEO pages", "Schema and sitemap", "Search intent planning"],
    href: "/services/seo-services/",
    size: "md",
  },
  {
    name: "Android & iOS apps",
    summary: "Mobile apps for customers or staff in Flutter or React Native, published on Google Play and the App Store.",
    points: ["Flutter & React Native", "Payments and push alerts", "Admin panel and APIs", "Play Store & App Store launch"],
    href: "/it-services/android-ios-app/",
    size: "md",
  },
  {
    name: "AI automation",
    summary: "Automations that reduce repetitive manual work and speed up business operations.",
    points: ["Workflow automation", "AI task handling", "Form and CRM flows", "Chat and email automation"],
    size: "sm",
  },
  {
    name: "AI agents",
    summary: "Custom assistant systems that use tools, prompts, and workflows for real tasks.",
    points: ["AI assistants", "Meta-agent workflows", "Tool-based agents", "Business process agents"],
    size: "sm",
  },
  {
    name: "Data analysis",
    summary: "Turn raw data into clear reports, dashboards, and decision-ready insights.",
    points: ["Data cleaning", "Excel and Sheets automation", "Dashboards", "Reports and insights"],
    size: "sm",
  },
  {
    name: "Software, web & mobile apps",
    summary: "Custom tools, web apps and Android & iOS apps for internal teams, customers, and business workflows.",
    points: ["Android & iOS apps", "Admin panels", "APIs and integrations", "Portals and tools"],
    size: "sm",
  },
  {
    name: "Ecommerce",
    summary: "Online store setup and optimization for selling products or services online.",
    points: ["Store setup", "Product pages", "Payments and checkout", "Performance tuning"],
    size: "sm",
  },
  {
    name: "Maintenance & support",
    summary: "Keep your website, app, SEO setup, and deployment running cleanly after launch.",
    points: ["Bug fixes", "Content updates", "Backup checks", "SEO and speed checks"],
    size: "sm",
  },
];

const marquee = [
  "Static websites",
  "Dynamic web apps",
  "Website design",
  "Deployment",
  "Custom software",
  "Android & iOS apps",
  "SEO & content",
  "Ecommerce",
  "AI automation",
  "AI agents",
  "Meta agents",
  "Data analysis",
  "Workflow automation",
  "Maintenance & support",
  "Performance & Core Web Vitals",
  "Schema & sitemaps",
  "Freelance IT services",
];

const stats = [
  { value: 3, suffix: "", label: "Engineers you work with directly" },
  { value: 5, suffix: "", label: "Months maintenance included free" },
  { value: 1000, suffix: "+", label: "Indian cities covered" },
  { value: 100, suffix: "%", label: "Code and content ownership" },
];

const builds = [
  {
    name: "Static websites",
    tag: "Speed-first",
    summary: "Business websites, landing pages, portfolios, and SEO pages rendered as fast, crawlable HTML.",
    points: ["Fast loading", "Clean SEO structure", "Simple hosting", "Secure static output"],
  },
  {
    name: "Dynamic websites & web apps",
    tag: "Feature-first",
    summary: "Dashboards, databases, forms, bookings, payments, and custom tools built around real workflows.",
    points: ["Custom APIs", "User accounts", "Admin panels", "Deployment support"],
  },
];

const process = [
  ["Understand", "Clarify your goal, users, service intent, pages, features, data, and expected business outcome."],
  ["Build", "Create the website, web app, automation, AI agent, or data workflow with clean structure and SEO basics."],
  ["Deploy", "Set up hosting, production build, tracking basics, sitemap, performance checks, and post-launch support."],
];

const comparison = [
  {
    aspect: "Typical cost",
    agency: "US/UK agency rates, thousands per site",
    cheap: "Low, but hidden costs later",
    us: "From ₹10,000 (US$150), quoted to your scope",
  },
  {
    aspect: "Who you speak to",
    agency: "Account managers & coordinators",
    cheap: "Unknown freelancer, no guarantee",
    us: "Recently graduated engineers directly",
  },
  {
    aspect: "Project clarity",
    agency: "Briefs passed down, detail lost",
    cheap: "Vague scope, frequent surprises",
    us: "Itemised scope before work starts",
  },
  {
    aspect: "Post-launch support",
    agency: "Paid retainer required",
    cheap: "Usually disappears",
    us: "5 months free maintenance",
  },
  {
    aspect: "Code ownership",
    agency: "Often locked to their systems",
    cheap: "Varies, often no handover",
    us: "100% yours from day one",
  },
  {
    aspect: "SEO from the start",
    agency: "Separate SEO team, extra cost",
    cheap: "Rarely considered",
    us: "Built into every project",
  },
];

// Every city with a live /{city}/ page, biggest first. Grows automatically as content files are added.
const builtCitySlugs = new Set(
  Object.keys(import.meta.glob("../data/cities/content/*.ts")).map((p) => p.split("/").pop()!.replace(/\.ts$/, "")),
);
const locations = (cities as CityListing[]).filter((c) => builtCitySlugs.has(c.slug));

const priceTable = pricingPlans.map((p) => {
  const per = p.unit ? "/mo" : "";
  return { service: p.name, includes: p.includes.join(", "), timeline: p.timeline, inr: p.price + per, usd: usdPrice(p.price) + per };
});

const markets = [
  { country: "United States", code: "US", overlap: "US Eastern mornings (IST evenings)", billing: "USD · wire, Wise, PayPal", href: "/usa/" },
  { country: "United Kingdom", code: "UK", overlap: "UK business day from late morning", billing: "USD or GBP · Wise, wire", href: "/uk/" },
  { country: "Canada", code: "CA", overlap: "Eastern & Pacific mornings", billing: "USD or CAD · Wise, wire", href: "/canada/" },
  { country: "Australia & NZ", code: "AU", overlap: "Australian afternoons (IST mornings)", billing: "USD or AUD · Wise, wire", href: "/australia/" },
  { country: "UAE & Middle East", code: "AE", overlap: "Near full working day", billing: "USD or AED · Wise, wire", href: "/uae/" },
  { country: "Singapore & Asia", code: "SG", overlap: "Near full working day", billing: "USD or SGD · Wise, wire", href: "/singapore/" },
  { country: "Japan", code: "JP", overlap: "Japanese afternoons, from 12:30 pm JST", billing: "USD or JPY · Wise, wire", href: "/japan/" },
  { country: "Europe", code: "EU", overlap: "European business day from late morning", billing: "USD or EUR · Wise, wire", href: "/germany/" },
  { country: "India", code: "IN", overlap: "Same time zone (IST)", billing: "INR · UPI, bank transfer", href: "/india/" },
];

const techStack = [
  "Astro", "React", "Next.js", "Flutter", "React Native", "Node.js", "TypeScript", "Tailwind CSS", "WordPress", "Shopify",
  "Python", "PostgreSQL", "MongoDB", "Firebase", "AWS", "Cloudflare", "Vercel", "OpenAI & Claude APIs", "Google Analytics 4",
];

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "BtechWaleTech",
  url: "https://btechwaletech.in/",
  image: "https://btechwaletech.in/banner_logo.png",
  description: page.description,
  email: siteContact.email,
  telephone: siteContact.phone,
  priceRange: "₹8,000 – ₹60,000+ (US$120 – US$900+)",
  address: { "@type": "PostalAddress", addressCountry: "IN" },
  areaServed: ["US", "GB", "CA", "AU", "NZ", "AE", "SG", "IN", "DE", "IE", "NL"].map((c) => ({ "@type": "Country", name: c })),
  knowsLanguage: ["en", "hi"],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Website development and IT services",
    itemListElement: priceTable.map((p) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: p.service, description: p.includes },
      priceSpecification: {
        "@type": "PriceSpecification",
        minPrice: Number(p.inr.replace(/[^\d]/g, "")),
        priceCurrency: "INR",
      },
    })),
  },
};
---

<BaseLayout meta={page} schema={[professionalServiceSchema, faqSchema(faqs)]}>

  <!-- ===================== HERO ===================== -->
  <section class="hero" aria-labelledby="home-heading">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Web development company · Worldwide</p>
        <h1 id="home-heading">
          Website development &amp; <span class="h1-accent">IT services</span> for businesses worldwide
        </h1>
        <p class="lede">{page.intro}</p>
        <div class="hero-actions">
          <a class="btn-primary" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp Us</span>
            <span class="btn-arrow" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn-ghost" href="#proof-of-work">See our work</a>
        </div>

        <p class="hero-origin">
          <span class="origin-dot" aria-hidden="true"></span>
          Built in India &middot; Delivering to clients worldwide
        </p>
      </div>

      <!-- Hero Image -->
      <div class="hero-image-panel">
        <div class="hero-img-wrap">
          <Image
            src={heroImage}
            alt="BtechWaleTech workspace — laptop showing digital solutions, branded coffee mug, notebooks and office setup"
            loading="eager"
            class="hero-img"
            widths={[640, 960, 1440]}
            sizes="(max-width: 768px) 100vw, 55vw"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== MARQUEE ===================== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="marquee-set">
          {marquee.map((item) => (
            <span class="marquee-item">{item}</span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- ===================== STATS ===================== -->
  <section class="stats-section" aria-label="BtechWaleTech in numbers">
    <div class="section-wrap">
      <ul class="stat-band">
        {stats.map((s) => (
          <li>
            <span class="stat-num">{s.value}{s.suffix}</span>
            <span class="stat-label">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== SERVICES ===================== -->
  <section class="services" aria-labelledby="services-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Core services</p>
        <h2 id="services-heading">Practical IT services for businesses that need work done properly</h2>
        <p class="section-note">
          We help with the full digital work stack: website planning, design, development, SEO setup, AI automation,
          AI agents, data analysis, ecommerce, deployment, and maintenance.
        </p>
      </div>
      <div class="bento">
        {services.map((s) => {
          const inner = (
            <div class="card-core">
              <h3>{s.name}</h3>
              <p>{s.summary}</p>
              <ul class="service-points">
                {s.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              {s.href && <span class="card-link">Learn more <span aria-hidden="true">&rsaquo;</span></span>}
            </div>
          );
          return s.href ? (
            <a class={`card card-${s.size}`} href={s.href}>
              {inner}
            </a>
          ) : (
            <div class={`card card-${s.size}`}>
              {inner}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ===================== PRICING TABLE ===================== -->
  <section class="pricing-band" aria-labelledby="pricing-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow eyebrow-light">Transparent pricing</p>
        <h2 id="pricing-heading">Website development cost, timelines &amp; starting prices</h2>
        <p class="section-note">
          Agency-quality websites and web apps without agency overhead. Prices are quoted in INR for India and USD for international clients,
          so clients in the USA, UK, Canada, Australia, and the UAE can compare at a glance. Every figure is a starting price:
          you get an itemised quote based on your requirements before work starts.
        </p>
      </div>
      <div class="price-table-wrap">
        <table class="price-table">
          <caption class="sr-only">Starting prices and timelines for BtechWaleTech services</caption>
          <thead>
            <tr>
              <th scope="col">Service</th>
              <th scope="col">What's included</th>
              <th scope="col">Typical timeline</th>
              <th scope="col">Starts from</th>
            </tr>
          </thead>
          <tbody>
            {priceTable.map((p) => (
              <tr>
                <th scope="row">{p.service}</th>
                <td>{p.includes}</td>
                <td class="nowrap">{p.timeline}</td>
                <td class="price-cell"><strong><small>from</small> {p.inr}</strong><span>from {p.usd}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="table-foot">
        All figures are starting prices. USD applies to clients outside India, and your final quote depends on pages, features, integrations, and content.
        <a href="/pricing/">See full pricing &rarr;</a>
      </p>
      <p class="cloud-label cloud-label-light">Technologies we build with</p>
      <ul class="tech-list">
        {techStack.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- ===================== OUR WORKS / PROOF OF WORK ===================== -->
  <section class="proof-of-work" id="proof-of-work" aria-labelledby="works-heading">
    <div class="section-wrap">
      <div class="section-head">
        <p class="eyebrow">Our works / Proof of work</p>
        <h2 id="works-heading">Featured live project: CricketTaken</h2>
        <p class="section-note">
          A high-performance cricket records, dynamic scorecards & tournament analytics platform engineered for speed, deep data archiving, and organic sports search capture.
        </p>
      </div>

      <div class="work-showcase">
        <!-- Left: Project Information & Interactive Animated Tabs -->
        <div class="work-details">
          <div class="work-status-row">
            <span class="live-pulse-badge">
              <span class="pulse-dot"></span>
              Live in production
            </span>
            <span class="work-category">Web Platform &middot; Sports Intelligence</span>
          </div>

          <h3 class="work-title">CricketTaken &mdash; All Cricket Records &amp; Live Match History</h3>
          <p class="work-desc">
            Engineered from the ground up as a lightning-fast static-first sports database. Powers deep tournament records (IPL, ICC World Cup, SA20, BBL, The Ashes), head-to-head match histories, player career breakdowns, and interactive real-time fan polls.
          </p>

          <!-- Interactive Tabs -->
          <div class="work-tabs" role="tablist" aria-label="Project details">
            <button class="work-tab active" data-work-tab="overview" role="tab" aria-selected="true" type="button">
              Overview
            </button>
            <button class="work-tab" data-work-tab="features" role="tab" aria-selected="false" type="button">
              Key Features
            </button>
            <button class="work-tab" data-work-tab="stack" role="tab" aria-selected="false" type="button">
              Technical Stack
            </button>
          </div>

          <!-- Tab Panels -->
          <div class="work-panels">
            <div class="work-panel active" data-work-panel="overview" role="tabpanel">
              <ul class="work-checklist">
                <li>
                  <strong>Comprehensive Record Archives:</strong> Instant access to historical scorecards, tournament records, and player statistics across 15+ international leagues.
                </li>
                <li>
                  <strong>Sub-second Navigation:</strong> Pre-rendered static pages combined with reactive islands for zero layout shift and instant page transitions.
                </li>
                <li>
                  <strong>High-Intent Search Architecture:</strong> 1,000+ programmatic SEO routes driving organic search capture for player queries and match archives.
                </li>
              </ul>
            </div>

            <div class="work-panel" data-work-panel="features" role="tabpanel">
              <ul class="work-checklist">
                <li>
                  <strong>Interactive Fan Polls:</strong> Real-time voting widgets with instant client-side updates and anti-spam verification.
                </li>
                <li>
                  <strong>Playing XI Builder:</strong> Dynamic team constructor with balance analysis and custom match simulations.
                </li>
                <li>
                  <strong>Live Dark/Light Editorial Theme:</strong> High-contrast sports UI tailored for live match viewing in any environment.
                </li>
              </ul>
            </div>

            <div class="work-panel" data-work-panel="stack" role="tabpanel">
              <ul class="work-checklist">
                <li>
                  <strong>Astro &amp; TypeScript:</strong> Island architecture delivering 100/100 Core Web Vitals score.
                </li>
                <li>
                  <strong>TailwindCSS Design System:</strong> Custom dark-theme sports palette with responsive container queries.
                </li>
                <li>
                  <strong>Optimized Production Hosting:</strong> Edge deployment with automated cache invalidation and Schema.org rich results.
                </li>
              </ul>
            </div>
          </div>

          <!-- Actions -->
          <div class="work-actions">
            <a class="btn-primary" href="https://crickettaken.in/" target="_blank" rel="noopener noreferrer">
              <span>Visit crickettaken.in</span>
              <span class="btn-arrow" aria-hidden="true">&rarr;</span>
            </a>
            <a class="btn-ghost" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
              <span>Discuss a similar project</span>
            </a>
          </div>
        </div>

        <!-- Right: Browser Mockup Showcase Cover -->
        <div class="work-mockup-wrapper">
          <div class="browser-frame">
            <!-- Browser Header -->
            <div class="browser-bar">
              <div class="browser-dots" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <div class="browser-url">
                <span class="lock-icon material-symbols-outlined" aria-hidden="true">lock</span>
                https://crickettaken.in
              </div>
              <a class="browser-external-link" href="https://crickettaken.in/" target="_blank" rel="noopener noreferrer" title="Open crickettaken.in in new tab">
                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
              </a>
            </div>

            <!-- Browser Content Image -->
            <a class="browser-viewport" href="https://crickettaken.in/" target="_blank" rel="noopener noreferrer">
              <Image
                src={cricketTakenImg}
                alt="CricketTaken — Cricket records, scorecards and match history platform"
                loading="lazy"
                class="work-cover-img"
