const techStack = [
  "Astro", "React", "Next.js", "Flutter", "React Native", "Node.js", "TypeScript", "Tailwind CSS", "WordPress", "Shopify",
  "Python", "PostgreSQL", "MongoDB", "Firebase", "AWS", "Cloudflare", "Vercel", "OpenAI & Claude APIs", "Google Analytics 4",
];

const professionalServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "BtechWaleTech",
  url: "https://btechwaletech.in/",
  image: "https://btechwaletech.in/banner_logo.png",
  description: page.description,
  email: siteContact.email,
  telephone: siteContact.phone,
  priceRange: "₹10,000 – ₹60,000+ (US$150 – US$900+)",
  address: { "@type": "PostalAddress", addressCountry: "IN" },
  areaServed: ["US", "GB", "CA", "AU", "NZ", "AE", "SG", "IN", "DE", "IE", "NL"].map((c) => ({ "@type": "Country", name: c })),
  knowsLanguage: ["en", "hi"],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Website development and IT services",
    itemListElement: priceTable.map((p) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: p.service, description: p.includes },
      priceSpecification: {
        "@type": "PriceSpecification",
        minPrice: Number(p.inr.replace(/[^\d]/g, "")),
        priceCurrency: "INR",
      },
    })),
  },
};

// Portfolio as a crawlable ItemList: shipped client sites first, then the featured builds.
const portfolioSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "BtechWaleTech portfolio — shipped client websites and featured projects",
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  numberOfItems: shipped.length + projects.length,
  itemListElement: [
    ...shipped.map((item) => ({ name: item.name, url: item.href, description: item.summary })),
    ...projects.map((p) => ({ name: p.name, url: p.href, description: p.desc })),
  ].map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "CreativeWork",
      name: item.name,
      url: item.url,
      description: item.description,
      creator: { "@type": "Organization", name: "BtechWaleTech", url: "https://btechwaletech.in/" },
    },
  })),
};
---

<BaseLayout meta={page} schema={[professionalServiceSchema, portfolioSchema, faqSchema(faqs)]}>

  <!-- Icon sprite: one inline set, no icon webfont. -->
  <svg class="sprite" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
    <symbol id="i-lock" viewBox="0 0 24 24"><path d="M6 10V8a6 6 0 1 1 12 0v2h1a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h1Zm2 0h8V8a4 4 0 0 0-8 0v2Z"/></symbol>
    <symbol id="i-external" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 4h6v6M20 4 10 14M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m4 12.5 5 5L20 6.5"/></symbol>
    <symbol id="i-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5 8 12l7 7"/></symbol>
    <symbol id="i-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></symbol>
  </svg>

  <!-- ===================== HERO ===================== -->
  <section class="hero" aria-labelledby="home-heading">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="tag"><span class="tag-dot" aria-hidden="true"></span>Web development team &middot; Worldwide</p>

        <h1 id="home-heading">
          Website development &amp; IT services for businesses worldwide
        </h1>

        <p class="lede">{page.intro}</p>

        <div class="btn-row">
          <a class="btn btn-amber" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
            <span>WhatsApp us</span><span class="arr" aria-hidden="true">&rarr;</span>
          </a>
          <a class="btn btn-white" href="#proof-of-work">See our work</a>
        </div>

        <div class="team">
          <span class="team-faces" aria-hidden="true">
            <span>AK</span><span>SS</span><span>VS</span>
          </span>
          <p>
            <strong>Three engineers, start to finish</strong>
            You talk to the people building it, never an account manager.
          </p>
        </div>

        <ul class="hero-trust">
          <li><svg class="ico" aria-hidden="true"><use href="#i-check" /></svg>From ₹10,000 (US$150)</li>
          <li><svg class="ico" aria-hidden="true"><use href="#i-check" /></svg>2 months upkeep free</li>
          <li><svg class="ico" aria-hidden="true"><use href="#i-check" /></svg>100% code ownership</li>
        </ul>

        <p class="hero-origin">Built in India &middot; Delivering to clients worldwide</p>
      </div>

      <!-- Built in markup, not an image file: nothing to download, and it moves. -->
      <div class="hero-art" aria-hidden="true">
        <span class="chip chip-a">Lighthouse 100</span>
        <span class="chip chip-b">Live in 2 weeks</span>
        <span class="chip chip-c">SEO ready day one</span>

        <div class="logo3d">
          <Image src={logoMark} alt="" height={84} densities={[1, 2]} loading="eager" />
        </div>

        <div class="browser">
          <div class="b-bar">
            <i></i><i></i><i></i>
            <span class="b-url"><svg class="ico" aria-hidden="true"><use href="#i-lock" /></svg>btechwaletech.in</span>
          </div>
          <div class="b-body">
            <div class="b-nav"><span></span><span></span><span></span><span class="b-nav-cta"></span></div>
            <div class="b-hero">
              <span class="b-line l1"></span>
              <span class="b-line l2"></span>
              <span class="b-line l3"></span>
              <span class="b-btn"></span>
            </div>
            <div class="b-cards"><span></span><span></span><span></span></div>
          </div>
        </div>

        <div class="wa-note">
          <span class="wa-note-head"><span class="wa-dot"></span>New enquiry</span>
          <p>“Need a 300-page SEO website — what would it cost?”</p>
          <span class="wa-note-foot">Replied in 9 minutes</span>
        </div>
      </div>
    </div>

    <!-- Numbers sit in the hero so the page reaches real content sooner. -->
    <div class="shell">
      <ul class="stat-row">
        {stats.map((s) => (
          <li class="reveal"><strong data-count={s.value} data-suffix={s.suffix}>0{s.suffix}</strong><span>{s.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===================== MARQUEE ===================== -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="marquee-set">
          {marquee.map((item) => (<span class="marquee-item">{item}</span>))}
        </div>
      ))}
    </div>
  </div>

  <!-- ===================== SERVICES ===================== -->
  <section class="band band-butter" aria-labelledby="services-heading">
    <div class="shell">
      <div class="head reveal">
        <p class="tag tag-plain">Core services</p>
        <h2 id="services-heading">Practical IT services for businesses that need work done properly</h2>
        <p class="note">
          We help with the full digital work stack: website planning, design, development, SEO setup, AI automation,
          AI agents, data analysis, ecommerce, deployment, and maintenance.
        </p>
      </div>

      <div class="bento">
        {services.map((s, i) => {
          const inner = (
            <>
              <span class="card-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3>{s.name}</h3>
              <p>{s.summary}</p>
              <ul class="ticks">
                {s.points.map((point) => (
                  <li><svg class="ico" aria-hidden="true"><use href="#i-check" /></svg>{point}</li>
                ))}
              </ul>
            </>
          );
          return s.href
            ? <a class={`card card-${s.size} reveal`} href={s.href}>{inner}</a>
            : <div class={`card card-${s.size} reveal`}>{inner}</div>;
        })}
      </div>
    </div>
  </section>

  <!-- ===================== SHIPPED CLIENT SITES ===================== -->
  <section class="band" id="shipped" aria-labelledby="shipped-heading">
    <div class="shell">
      <div class="head reveal">
        <p class="tag tag-plain">Shipped projects</p>
        <h2 id="shipped-heading">Live client websites we <span class="mark">designed, built and shipped</span></h2>
        <p class="note">
          Three platforms running in production: a registered charitable trust in Uttar Pradesh taking donations
          through four separate funds, a study-abroad community where verified students and mentors answer the
          questions that decide a move abroad, and a cricket records database built for speed and organic search.
          All three were planned, designed, built, deployed and handed over by the same three engineers.
        </p>
      </div>

      <div class="ship-grid">
        {shipped.map((s) => (
          <article class="ship reveal">
            <a class="shot" href={s.href} target="_blank" rel="noopener noreferrer">
              <span class="b-bar">
                <i></i><i></i><i></i>
                <span class="b-url"><svg class="ico" aria-hidden="true"><use href="#i-lock" /></svg>{s.domain}</span>
                <svg class="ico shot-go" aria-hidden="true"><use href="#i-external" /></svg>
              </span>
              <span class="shot-view">
                <Image src={s.img} alt={s.alt} loading="lazy" class="shot-img" widths={[420, 640, 900]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 31vw" />
                <span class="shot-hover"><span class="shot-pill">Open the live site &rarr;</span></span>
              </span>
            </a>

            <div class="ship-body">
              <p class="flags">
                <span class="flag flag-live"><span class="pulse" aria-hidden="true"></span>Shipped &amp; live</span>
                <span class="flag">{s.kind}</span>
              </p>
              <h3>{s.name}</h3>
              <p class="ship-sector">{s.sector}</p>
              <p class="ship-sum">{s.summary}</p>

              <dl class="scope">
                {s.scope.map(([label, detail]) => (
                  <div>
                    <dt><svg class="ico" aria-hidden="true"><use href="#i-check" /></svg>{label}</dt>
                    <dd>{detail}</dd>
                  </div>
                ))}
              </dl>

              <div class="btn-row btn-row-sm">
                <a class="btn btn-amber" href={s.href} target="_blank" rel="noopener noreferrer">
                  <span>Visit {s.domain}</span><span class="arr" aria-hidden="true">&rarr;</span>
                </a>
                <a class="btn btn-white" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
                  <span>Build something like this</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== PROOF OF WORK (SLIDER) ===================== -->
  <section class="band band-sky" id="proof-of-work" aria-labelledby="works-heading">
    <div class="shell">
      <div class="head reveal">
        <p class="tag tag-plain">Our works / Proof of work</p>
        <h2 id="works-heading">Featured projects: live and in progress</h2>
        <p class="note">
          A recent client build &mdash; a bilingual webinar registration page that sells seats and confirms them on WhatsApp &mdash; and two builds in progress: a face and location attendance app for teams on site and in the field, and a tours and travels website covering all 75 districts of Uttar Pradesh.
        </p>
      </div>

      <div class="slider" data-slider="proof">
        <div class="rail" data-rail tabindex="0" role="group" aria-roledescription="carousel" aria-label="Featured projects">
          {projects.map((p, i) => (
            <article class="slide" data-slide aria-roledescription="slide" aria-label={`${i + 1} of ${projects.length}: ${p.name}`}>
              <div class="work">
                <div class="work-copy">
                  <p class="flags">
                    <span class="flag flag-live"><span class="pulse" aria-hidden="true"></span>{p.status}</span>
                    <span class="flag">{p.category}</span>
                  </p>

                  <h3 class="work-title">{p.name}</h3>
                  <p class="work-desc">{p.desc}</p>

                  <div class="tabs" role="tablist" aria-label={`${p.name} details`}>
                    {p.tabs.map((t, ti) => (
                      <button class={`tab${ti === 0 ? " active" : ""}`} data-work-tab={t.id} role="tab" aria-selected={ti === 0 ? "true" : "false"} type="button">{t.label}</button>
                    ))}
                  </div>

                  <div class="panels">
                    {p.tabs.map((t, ti) => (
                      <div class={`panel${ti === 0 ? " active" : ""}`} data-work-panel={t.id} role="tabpanel">
                        <ul class="checklist">
                          {t.items.map(([label, detail]) => (
                            <li><svg class="ico" aria-hidden="true"><use href="#i-check" /></svg><span><strong>{label}</strong> {detail}</span></li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>

                  <div class="btn-row btn-row-sm">
                    <a class="btn btn-amber" href={p.href} target="_blank" rel="noopener noreferrer">
                      <span>{p.cta}</span><span class="arr" aria-hidden="true">&rarr;</span>
                    </a>
                    <a class="btn btn-white" href={siteContact.whatsappHref} target="_blank" rel="noopener noreferrer">
                      <span>Discuss a similar project</span>
                    </a>
                  </div>
                </div>

                <div class="work-art">
                  <a class="shot" href={p.href} target="_blank" rel="noopener noreferrer">
                    <span class="b-bar">
                      <i></i><i></i><i></i>
                      <span class="b-url"><svg class="ico" aria-hidden="true"><use href="#i-lock" /></svg>{p.domain}</span>
                      <svg class="ico shot-go" aria-hidden="true"><use href="#i-external" /></svg>
                    </span>
                    <span class="shot-view">
                      <Image src={p.img} alt={p.alt} loading="lazy" class="shot-img" widths={[460, 700, 980]} sizes="(max-width: 1100px) 92vw, 46vw" />
                      <span class="shot-hover"><span class="shot-pill">{p.openLabel} &rarr;</span></span>
                    </span>
                  </a>

                  <ul class="pill-row">
                    {p.metrics.map(([val, lbl]) => (<li><strong>{val}</strong> {lbl}</li>))}
                  </ul>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="slider-ui">
          <button class="nav-btn" type="button" data-prev aria-label="Previous project"><svg class="ico" aria-hidden="true"><use href="#i-left" /></svg></button>
          <ol class="dots" data-dots>
            {projects.map((p, i) => (<li><button type="button" data-dot={i} aria-label={`Go to project ${i + 1}: ${p.name}`}></button></li>))}
          </ol>
          <button class="nav-btn" type="button" data-next aria-label="Next project"><svg class="ico" aria-hidden="true"><use href="#i-right" /></svg></button>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CLIENT REVIEWS ===================== -->
  <section class="band band-mint" id="reviews" aria-labelledby="reviews-heading">
    <div class="shell">
      <div class="head reveal">
        <p class="tag tag-plain">Client reviews</p>
        <h2 id="reviews-heading">What clients say after <span class="mark">the handover</span></h2>
        <p class="note">
          Every review below is a verbatim five-star review left on our Google Business Profile by a client whose
          project we planned, built, deployed and handed over.
        </p>
      </div>
    </div>

    <!-- Full-bleed ticker: the row keeps moving, and stops the moment you point at it. -->
    <div class="ticker" data-ticker>
      <div class="ticker-track">
        {[0, 1].map((copy) => (
          <div class="ticker-set" aria-hidden={copy === 1 ? "true" : undefined}>
            {reviews.map((r) => (
              <article class="review">
                <p class="stars" role="img" aria-label="Rated 5 out of 5">
                  {[0, 1, 2, 3, 4].map(() => (
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1L12 2Z" /></svg>
                  ))}
                </p>
                <h3>{r.headline}</h3>
                <p class="review-body">{r.body}</p>
                <footer class="review-who">
                  <span class="avatar" aria-hidden="true">{r.initials}</span>
                  <span>
                    <strong>{r.name}</strong>
                    <small>{r.meta} &middot; {r.when}</small>
                  </span>
                </footer>
              </article>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== PRICING ===================== -->
  <section class="band band-ink" aria-labelledby="pricing-heading">
    <div class="shell">
      <div class="head reveal">
        <p class="tag tag-plain tag-light">Transparent pricing</p>
        <h2 id="pricing-heading">Website development cost, timelines &amp; starting prices</h2>
        <p class="note">
          Agency-quality websites and web apps without agency overhead. Prices are quoted in INR for India and USD for international clients,
          so clients in the USA, UK, Canada, Australia, and the UAE can compare at a glance. Every figure is a starting price:
          you get an itemised quote based on your requirements before work starts.
        </p>
      </div>

      <div class="tbl-wrap reveal">
        <table class="tbl price-tbl">
          <caption class="sr-only">Starting prices and timelines for BtechWaleTech services</caption>
          <thead>
            <tr>
              <th scope="col">Service</th>
              <th scope="col">What's included</th>
              <th scope="col">Typical timeline</th>
              <th scope="col">Starts from</th>
            </tr>
          </thead>
          <tbody>
            {priceTable.map((p) => (
              <tr>
                <th scope="row">{p.service}</th>
                <td data-label="Included">{p.includes}</td>
                <td data-label="Timeline" class="nowrap">{p.timeline}</td>
                <td data-label="Starts from" class="price-cell"><strong>{p.inr}</strong><span>{p.usd}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="tbl-foot">
        All figures are starting prices. USD applies to clients outside India, and your final quote depends on pages, features, integrations, and content.
        <a href="/pricing/">See full pricing &rarr;</a>
      </p>

      <p class="mini-label">Technologies we build with</p>
      <ul class="tech-list">
        {techStack.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- ===================== ADVANTAGE ===================== -->
  <section class="band" aria-labelledby="advantage-heading">
    <div class="shell">
      <div class="head reveal">
        <p class="tag tag-plain">The heritage advantage</p>
        <h2 id="advantage-heading">Engineering ethics over speed, shortcuts, and hand-offs</h2>
        <p class="note">
          We are three freelance engineers with no layers of management, and we do not disappear post-launch.
          We are a focused group of recently graduated engineers who own your project from start to finish.
        </p>
      </div>

      <div class="tbl-wrap reveal">
        <table class="tbl cmp-tbl">
          <caption class="sr-only">How BtechWaleTech compares with a traditional agency and a cheap freelancer</caption>
          <thead>
            <tr>
              <th scope="col" class="c-aspect">What matters</th>
              <th scope="col" class="c-mid">Traditional agency</th>
              <th scope="col" class="c-mid">Cheap freelancer</th>
              <th scope="col" class="c-us">BtechWaleTech</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <th scope="row" class="c-aspect">{row.aspect}</th>
                <td data-label="Traditional agency" class="c-mid">{row.agency}</td>
                <td data-label="Cheap freelancer" class="c-mid">{row.cheap}</td>
                <td data-label="BtechWaleTech" class="c-us">
                  <span><svg class="ico" aria-hidden="true"><use href="#i-check" /></svg>{row.us}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===================== BUILD TYPES + PROCESS ===================== -->
  <section class="band band-blush" aria-labelledby="builds-heading">
    <div class="shell">
      <div class="head reveal">
        <p class="tag tag-plain">Static &amp; dynamic</p>
        <h2 id="builds-heading">Every kind of website, built the right way</h2>
        <p class="note">
          Some businesses need a fast static website. Others need a dynamic web app, dashboard, automation, or AI-powered
          workflow. We help choose the right setup before development starts.
        </p>
      </div>

      <div class="build-grid">
        {builds.map((b) => (
          <a class="build reveal" href="/services/web-development/">
            <span class="build-tag">{b.tag}</span>
            <h3>{b.name}</h3>
            <p>{b.summary}</p>
            <ul class="ticks">
              {b.points.map((p) => (<li><svg class="ico" aria-hidden="true"><use href="#i-check" /></svg>{p}</li>))}
            </ul>
          </a>
        ))}
      </div>

      <div class="head head-tight reveal">
        <p class="tag tag-plain">How work stays clean</p>
        <h2 id="process-heading">Clear requirement, clean build, smooth deployment</h2>
      </div>

      <ol class="steps" aria-labelledby="process-heading">
        {process.map(([step, detail], i) => (
          <li class="reveal">
            <span class="step-num">{i + 1}</span>
            <h3>{step}</h3>
            <p>{detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ===================== LOCATIONS ===================== -->
  <section class="band band-butter" aria-labelledby="locations-heading">
    <div class="shell">
      <div class="head reveal">
        <p class="tag tag-plain">Global delivery</p>
        <h2 id="locations-heading">Web development services for clients around the world</h2>
        <p class="note">
          Whether you are a startup in New York, an agency in London, a retailer in Toronto, a clinic in Sydney, or a
          trading company in Dubai, we work in your business hours, invoice in your currency, and ship to the same
          standard. Here is how working with us looks in each region, or <a href="/countries/">see all countries we serve</a>.
        </p>
      </div>

      <div class="tbl-wrap reveal">
        <table class="tbl mkt-tbl">
          <caption class="sr-only">Countries served, working-hour overlap and billing options</caption>
          <thead>
            <tr>
              <th scope="col">Region</th>
              <th scope="col">Working-hour overlap</th>
              <th scope="col">Billing &amp; payment</th>
            </tr>
          </thead>
          <tbody>
            {markets.map((m) => (
              <tr>
                <th scope="row"><span class="cc">{m.code}</span>{m.href ? <a href={m.href}>{m.country}</a> : m.country}</th>
                <td data-label="Overlap">{m.overlap}</td>
                <td data-label="Billing">{m.billing}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- City slider: 20 links per panel, every link still in the HTML for crawlers. -->
      <div class="city-block reveal">
        <div class="city-head">
          <div>
            <h3>Covering 1000+ cities across all 30 states in India</h3>
            <p class="note note-sm">
              In India we provide web development, SEO, and AI automation to businesses in metro hubs and tier-2 cities alike.
            </p>
          </div>
          <div class="city-nav">
            <span class="city-count" data-city-count>01 / {citySlides.length}</span>
            <button class="nav-btn" type="button" data-prev aria-label="Previous cities"><svg class="ico" aria-hidden="true"><use href="#i-left" /></svg></button>
