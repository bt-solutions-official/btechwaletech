  @keyframes tilt {
    0%, 100% { transform: rotate(-8deg) translateY(0); }
    50%      { transform: rotate(-3deg) translateY(-6px); }
  }

  .chip {
    position: absolute;
    z-index: 4;
    padding: 0.4rem 0.8rem;
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: 999px;
    box-shadow: var(--bw-sh-sm);
    font-size: 0.72rem;
    font-weight: 800;
    white-space: nowrap;
    animation: float-y-sm 6s ease-in-out infinite;
  }
  .chip-a { top: 1.4rem; right: 0.2rem; background: var(--bw-mint); transform: rotate(3deg); }
  .chip-b { top: 45%; left: -1.2rem; background: var(--bw-sky); transform: rotate(-4deg); animation-delay: 1.1s; }
  .chip-c { bottom: 3.6rem; right: -0.6rem; background: var(--bw-blush); transform: rotate(2deg); animation-delay: 2.2s; }

  @keyframes float-y-sm {
    0%, 100% { translate: 0 0; }
    50%      { translate: 0 -8px; }
  }

  .wa-note {
    position: absolute;
    z-index: 5;
    right: 0.4rem;
    bottom: -0.4rem;
    width: min(16rem, 70%);
    padding: 0.7rem 0.85rem;
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: var(--bw-r);
    box-shadow: var(--bw-sh);
    transform: rotate(1.5deg);
  }
  .wa-note-head {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--bw-ink-mute);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .wa-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--bw-green); box-shadow: 0 0 0 1.5px var(--bw-ink); }
  .wa-note p { margin: 0.35rem 0; font-size: 0.79rem; font-weight: 600; line-height: 1.45; }
  .wa-note-foot { color: var(--bw-ink-mute); font-size: 0.66rem; font-weight: 700; }

  /* ---------- stat row ---------- */
  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.7rem;
    margin: clamp(1.75rem, 3.5vw, 2.75rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .stat-row li {
    padding: 0.95rem 1.1rem;
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: var(--bw-r);
    box-shadow: var(--bw-sh-sm);
    transition: transform 240ms var(--bw-ease), box-shadow 240ms var(--bw-ease);
  }
  .stat-row li:hover { transform: translate(-2px, -2px); box-shadow: var(--bw-sh); }
  .stat-row strong { display: block; font-size: clamp(1.5rem, 2.6vw, 2.1rem); font-weight: 900; letter-spacing: -0.04em; line-height: 1.05; }
  .stat-row span { display: block; margin-top: 0.15rem; color: var(--bw-ink-soft); font-size: 0.76rem; font-weight: 500; line-height: 1.4; }

  /* =========================== MARQUEE =========================== */
  .marquee {
    overflow: hidden;
    padding: 0.6rem 0;
    background: var(--bw-ink);
    border-bottom: var(--bw-bd);
  }
  .marquee-track { display: flex; width: max-content; animation: slide-left 48s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  .marquee-set { display: flex; align-items: center; }
  .marquee-item {
    display: inline-flex;
    align-items: center;
    padding: 0 1.1rem;
    color: #FFFFFF;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .marquee-item::after { content: ""; width: 5px; height: 5px; margin-left: 1.1rem; border-radius: 50%; background: var(--bw-amber); }
  @keyframes slide-left { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* =========================== CARDS =========================== */
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .card {
    position: relative;
    display: block;
    min-width: 0;
    overflow-wrap: anywhere;
    padding: 1.4rem;
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: var(--bw-r);
    box-shadow: var(--bw-sh-sm);
    color: inherit;
    text-decoration: none;
    transition: transform 240ms var(--bw-ease), box-shadow 240ms var(--bw-ease);
  }
  .card:hover { transform: translate(-3px, -3px); box-shadow: var(--bw-sh-lg); }

  .card-lg { grid-column: span 6; }
  .card-md { grid-column: span 3; }
  .card-sm { grid-column: span 4; }

  .card-num {
    position: absolute;
    top: 1rem; right: 1.1rem;
    color: rgba(18, 19, 22, 0.14);
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: -0.05em;
  }
  .card:hover .card-num { color: var(--bw-amber); }

  .card h3 { font-size: 1.1rem; margin-bottom: 0.5rem; padding-right: 2rem; }
  .card > p { color: var(--bw-ink-soft); font-size: 0.875rem; font-weight: 400; line-height: 1.6; }

  .ticks { display: grid; gap: 0.32rem; margin: 0.95rem 0 0; padding: 0; list-style: none; }
  .ticks li {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    color: var(--bw-ink-soft);
    font-size: 0.79rem;
    font-weight: 600;
    line-height: 1.45;
  }
  .ticks .ico { margin-top: 0.22em; font-size: 0.72rem; color: var(--bw-amber-deep); }


  /* =========================== BROWSER SHOT =========================== */
  .shot {
    display: block;
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: var(--bw-r);
    box-shadow: var(--bw-sh);
    overflow: hidden;
    text-decoration: none;
    transition: transform 280ms var(--bw-ease), box-shadow 280ms var(--bw-ease);
  }
  .shot:hover { transform: translate(-3px, -3px); box-shadow: var(--bw-sh-lg); }

  .shot-go { margin-left: 0.2rem; color: var(--bw-ink); font-size: 0.85rem; }

  .shot-view { display: block; position: relative; overflow: hidden; border-top: var(--bw-bd); }

  .shot-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    transition: transform 700ms var(--bw-ease);
  }
  .shot:hover .shot-img { transform: scale(1.03); }
  .shot-view { will-change: transform; }

  .shot-hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 1.1rem;
    background: linear-gradient(to top, rgba(18, 19, 22, 0.7), transparent 55%);
    opacity: 0;
    transition: opacity 300ms var(--bw-ease);
  }
  .shot:hover .shot-hover, .shot:focus-visible .shot-hover { opacity: 1; }

  .shot-pill {
    padding: 0.55rem 1.1rem;
    background: var(--bw-amber);
    border: var(--bw-bd);
    border-radius: 999px;
    box-shadow: var(--bw-sh-sm);
    color: var(--bw-ink);
    font-size: 0.8rem;
    font-weight: 800;
  }

  /* =========================== SHIPPED =========================== */
  .ship-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: 1rem; }

  .ship {
    min-width: 0;
    overflow-wrap: anywhere;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1rem;
    background: var(--bw-paper-2);
    border: var(--bw-bd);
    border-radius: var(--bw-r-lg);
    box-shadow: var(--bw-sh);
  }

  .flags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.8rem; }
  .flag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.7rem;
    background: var(--bw-card);
    border: 2px solid var(--bw-ink);
    border-radius: 999px;
    color: var(--bw-ink);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .flag-live { background: var(--bw-amber); }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--bw-ink); animation: blink 2.2s ease-in-out infinite; }

  .ship h3 { font-size: clamp(1.25rem, 2vw, 1.6rem); }
  .ship-sector { margin-top: 0.35rem; color: var(--bw-ink-mute); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  .ship-sum { margin-top: 0.75rem; color: var(--bw-ink-soft); font-size: 0.9rem; font-weight: 400; line-height: 1.6; }

  .scope {
    display: grid;
    gap: 0.75rem;
    margin: 1.1rem 0 0;
    padding: 1rem;
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: var(--bw-r);
  }
  .scope dt { display: flex; align-items: center; gap: 0.4rem; font-size: 0.84rem; font-weight: 800; }
  .scope dt .ico { color: var(--bw-amber-deep); font-size: 0.78rem; }
  .scope dd { margin: 0.25rem 0 0 1.2rem; color: var(--bw-ink-soft); font-size: 0.82rem; font-weight: 400; line-height: 1.55; }

  /* Inline pills, so three numbers never become three stacked rows. */
  .pill-row { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1.1rem 0 0; padding: 0; list-style: none; }
  .pill-row li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.4rem 0.8rem;
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: 999px;
    box-shadow: var(--bw-sh-sm);
    color: var(--bw-ink-soft);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .pill-row strong { color: var(--bw-ink); font-size: 0.86rem; font-weight: 900; letter-spacing: -0.02em; }

  /* =========================== SLIDER =========================== */
  .slider { position: relative; }

  .rail {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .rail::-webkit-scrollbar { display: none; }
  .rail:focus-visible { outline-offset: 6px; }

  .slide { flex: 0 0 100%; min-width: 0; max-width: 100%; scroll-snap-align: start; }

  .slider-ui { display: flex; align-items: center; justify-content: center; gap: 0.9rem; margin-top: 1.4rem; }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem; height: 2.75rem;
    flex: none;
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: 50%;
    box-shadow: var(--bw-sh-sm);
    color: var(--bw-ink);
    font-size: 1rem;
    cursor: pointer;
    transition: transform 220ms var(--bw-ease), box-shadow 220ms var(--bw-ease), background 220ms ease, opacity 220ms ease;
  }
  .nav-btn:hover:not(:disabled) { background: var(--bw-amber); transform: translate(-2px, -2px); box-shadow: var(--bw-sh); }
  .nav-btn:active:not(:disabled) { transform: translate(2px, 2px); box-shadow: 0 0 0 var(--bw-ink); }
  .nav-btn:disabled { opacity: 0.35; cursor: not-allowed; }

  .dots {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    margin: 0;
    padding: 0.25rem 0.6rem;
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: 999px;
    box-shadow: var(--bw-sh-sm);
    list-style: none;
  }
  .dots button {
    position: relative;
    width: 24px; height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .dots button::before {
    content: "";
    position: absolute;
    top: 50%; left: 50%;
    width: 9px; height: 9px;
    border: 1.5px solid var(--bw-ink);
    border-radius: 999px;
    background: var(--bw-card);
    transform: translate(-50%, -50%);
    transition: width 320ms var(--bw-ease), background 320ms ease;
  }
  .dots button.on::before { width: 24px; background: var(--bw-amber); }

  /* =========================== PROOF OF WORK =========================== */
  .work {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2rem);
    align-items: start;
    padding: clamp(1rem, 2vw, 1.5rem);
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: var(--bw-r-lg);
    box-shadow: var(--bw-sh);
  }

  .work-title { font-size: clamp(1.3rem, 2.2vw, 1.8rem); }
  .work-desc { margin-top: 0.7rem; color: var(--bw-ink-soft); font-size: 0.9rem; font-weight: 400; line-height: 1.6; }

  .tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 1.1rem;
    padding: 0.3rem;
    background: var(--bw-paper-2);
    border: var(--bw-bd);
    border-radius: 999px;
  }
  .tab {
    padding: 0.45rem 0.95rem;
    border: 2px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--bw-ink-soft);
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease;
  }
  .tab:hover { color: var(--bw-ink); }
  .tab.active { background: var(--bw-amber); border-color: var(--bw-ink); color: var(--bw-ink); }

  .panels { margin-top: 0.9rem; }
  .panel { display: none; }
  .panel.active { display: block; animation: fade-up 420ms var(--bw-ease); }
  @keyframes fade-up { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .checklist {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0.95rem 1.05rem;
    background: var(--bw-paper-2);
    border: var(--bw-bd);
    border-radius: var(--bw-r);
    list-style: none;
  }
  .checklist li { display: flex; align-items: flex-start; gap: 0.5rem; color: var(--bw-ink-soft); font-size: 0.82rem; font-weight: 400; line-height: 1.55; }
  .checklist .ico { margin-top: 0.25em; font-size: 0.76rem; color: var(--bw-amber-deep); }
  .checklist strong { color: var(--bw-ink); font-weight: 800; }

  .work-art { display: flex; flex-direction: column; gap: 0.9rem; min-width: 0; }
  .work-art .pill-row { margin-top: 0; }

  /* Slide content eases in as its slide becomes active. */
  .slide .work-copy > *, .slide .work-art { transform: translateY(10px); transition: transform 520ms var(--bw-ease); }
  .slide.is-active .work-copy > *, .slide.is-active .work-art { transform: none; }
  .slide.is-active .work-copy > *:nth-child(2) { transition-delay: 50ms; }
  .slide.is-active .work-copy > *:nth-child(3) { transition-delay: 95ms; }
  .slide.is-active .work-copy > *:nth-child(4) { transition-delay: 140ms; }
  .slide.is-active .work-copy > *:nth-child(5) { transition-delay: 185ms; }
  .slide.is-active .work-copy > *:nth-child(6) { transition-delay: 230ms; }
  .slide.is-active .work-art { transition-delay: 80ms; }

  /* =========================== REVIEWS TICKER =========================== */
  .ticker {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }
  .ticker::-webkit-scrollbar { display: none; }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: slide-left 64s linear infinite;
    will-change: transform;
  }
  .ticker:hover .ticker-track,
  .ticker:focus-within .ticker-track { animation-play-state: paused; }

  .ticker-set { display: flex; align-items: flex-start; }

  .review {
    display: flex;
    flex-direction: column;
    width: clamp(17rem, 24vw, 22rem);
    flex: none;
    margin: 0 0.5rem;
    padding: 1.25rem;
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: var(--bw-r-lg);
    box-shadow: var(--bw-sh);
    transition: transform 240ms var(--bw-ease), box-shadow 240ms var(--bw-ease);
  }
  .review:hover { transform: translate(-3px, -3px); box-shadow: var(--bw-sh-lg); }

  .stars { display: flex; gap: 0.1rem; margin-bottom: 0.7rem; }
  .stars svg { width: 1.05rem; height: 1.05rem; fill: var(--bw-amber); stroke: var(--bw-ink); stroke-width: 1.1; }

  .review h3 { font-size: 1rem; margin-bottom: 0.5rem; }

  .review-body {
    color: var(--bw-ink-soft);
    font-size: 0.855rem;
    font-weight: 400;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  .review-who {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 2px solid rgba(18, 19, 22, 0.12);
  }
  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem; height: 2.2rem;
    flex: none;
    background: var(--bw-amber);
    border: var(--bw-bd);
    border-radius: 50%;
    font-size: 0.72rem;
    font-weight: 900;
  }
  .review-who strong { display: block; font-size: 0.85rem; font-weight: 800; }
  .review-who small { display: block; color: var(--bw-ink-mute); font-size: 0.71rem; font-weight: 600; }

  /* =========================== TABLES =========================== */
  .tbl-wrap {
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: var(--bw-r-lg);
    box-shadow: var(--bw-sh);
    overflow-x: auto;
  }
  .band-ink .tbl-wrap { background: #1B1D21; border-color: #3A3D43; box-shadow: 5px 5px 0 #000000; }

  .tbl { width: 100%; min-width: 42rem; border-collapse: collapse; font-size: 0.85rem; }

  .tbl thead th {
    padding: 0.85rem 1rem;
    background: var(--bw-paper-2);
    border-bottom: var(--bw-bd);
    color: var(--bw-ink);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: left;
    white-space: nowrap;
  }
  .band-ink .tbl thead th { background: #121316; border-bottom-color: #3A3D43; color: var(--bw-amber); }

  .tbl tbody th, .tbl td {
    padding: 0.9rem 1rem;
    border-bottom: 1.5px solid rgba(18, 19, 22, 0.1);
    text-align: left;
    vertical-align: top;
    line-height: 1.5;
  }
  .tbl tbody th { font-weight: 800; }
  .tbl td { color: var(--bw-ink-soft); font-weight: 400; }
  .tbl tbody tr:last-child > * { border-bottom: 0; }
  .tbl tbody tr:hover { background: var(--bw-paper-2); }

  .band-ink .tbl tbody th { color: #FFFFFF; border-bottom-color: #2C2F34; }
  .band-ink .tbl td { color: #A8ACB4; border-bottom-color: #2C2F34; }
  .band-ink .tbl tbody tr:hover { background: rgba(255, 255, 255, 0.04); }

  .tbl a { color: inherit; font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 3px; text-decoration-color: var(--bw-amber); }
  .nowrap { white-space: nowrap; }

  .price-cell strong { display: block; color: #FFFFFF; font-size: 1.05rem; font-weight: 900; letter-spacing: -0.02em; white-space: nowrap; }
  .price-cell span { display: block; color: var(--bw-amber); font-size: 0.78rem; font-weight: 700; white-space: nowrap; }

  .tbl-foot { margin-top: 1rem; color: #A8ACB4; font-size: 0.82rem; font-weight: 400; line-height: 1.6; }
  .tbl-foot a { color: var(--bw-amber); font-weight: 800; text-decoration: none; margin-left: 0.25rem; border-bottom: 2px solid var(--bw-amber); }

  .mini-label { margin-top: clamp(1.75rem, 3.5vw, 2.5rem); color: var(--bw-amber); font-size: 0.66rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; }

  .tech-list { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.8rem 0 0; padding: 0; list-style: none; }
  .tech-list li {
    padding: 0.4rem 0.85rem;
    border: 2px solid #3A3D43;
    border-radius: 999px;
    color: #C4C8CE;
    font-size: 0.76rem;
    font-weight: 700;
    transition: color 200ms ease, border-color 200ms ease, background 200ms ease;
  }
  .tech-list li:hover { background: var(--bw-amber); border-color: var(--bw-amber); color: var(--bw-ink); }

  .c-us span { display: flex; align-items: flex-start; gap: 0.4rem; color: var(--bw-ink); font-weight: 700; }
  .c-us .ico { margin-top: 0.25em; font-size: 0.75rem; color: var(--bw-amber-deep); }
  .c-mid { color: var(--bw-ink-mute); }
  .cmp-tbl .c-us { width: 28%; background: var(--bw-butter); }
  .cmp-tbl .c-aspect { width: 18%; }
  .cmp-tbl .c-mid { width: 27%; }

  .mkt-tbl { min-width: 36rem; }
  .mkt-tbl tbody th { white-space: nowrap; }
  .cc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    margin-right: 0.5rem;
    padding: 0.1rem 0;
    background: var(--bw-amber);
    border: 1.5px solid var(--bw-ink);
    border-radius: 6px;
    font-size: 0.64rem;
    font-weight: 900;
  }

  /* =========================== BUILDS + PROCESS =========================== */
  .build-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; }

  .build {
    display: block;
    min-width: 0;
    overflow-wrap: anywhere;
    padding: 1.5rem;
    background: var(--bw-card);
    border: var(--bw-bd);
    border-radius: var(--bw-r-lg);
    box-shadow: var(--bw-sh);
    text-decoration: none;
