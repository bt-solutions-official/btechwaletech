                  <a class="city" href={`/${c.slug}/`}>
                    <span class="city-name">{c.name}</span>
                    <span class="city-state">{c.state}</span>
                  </a>
                ))}
              </div>
            ))}
          </div>
          <div class="city-bar" aria-hidden="true"><span data-city-bar></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="band" aria-labelledby="faq-heading">
    <div class="shell faq-grid">
      <div class="head head-side reveal">
