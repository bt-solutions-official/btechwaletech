          <span>WhatsApp us</span><span class="arr" aria-hidden="true">&rarr;</span>
        </a>
        <a class="btn btn-white" href="/contact/"><span>Send a brief</span></a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  /* ---------- Project tabs (scoped per slide) ---------- */
  document.querySelectorAll<HTMLElement>(".work").forEach((work) => {
    const tabs = work.querySelectorAll<HTMLButtonElement>("[data-work-tab]");
    const panels = work.querySelectorAll<HTMLElement>("[data-work-panel]");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.getAttribute("data-work-tab");
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle("active", on);
          t.setAttribute("aria-selected", on ? "true" : "false");
        });
        panels.forEach((p) => p.classList.toggle("active", p.getAttribute("data-work-panel") === target));
      });
    });
  });

  /* ---------- Sliders ----------
     Native scroll-snap does the sliding; JS only drives the buttons, the
     active marker and the auto-advance. With JS off the rail still scrolls. */
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-slider]").forEach((slider) => {
    const rail = slider.querySelector<HTMLElement>("[data-rail]");
    if (!rail) return;

    const slides = Array.from(rail.querySelectorAll<HTMLElement>("[data-slide]"));
    const scope = slider.closest<HTMLElement>(".city-block") ?? slider;
    const prev = scope.querySelector<HTMLButtonElement>("[data-prev]");
    const next = scope.querySelector<HTMLButtonElement>("[data-next]");
    const dots = Array.from(scope.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const counter = scope.querySelector<HTMLElement>("[data-city-count]");
    const bar = scope.querySelector<HTMLElement>("[data-city-bar]");
    let index = 0;
    let touched = false;

    // Measured once (and on resize) so the scroll handler never touches layout.
    let offsets: number[] = [];
    const measure = () => { offsets = slides.map((s) => s.offsetLeft - rail.offsetLeft); };
    measure();
    addEventListener("resize", measure, { passive: true });

    const goTo = (i: number) => {
      const left = offsets[Math.max(0, Math.min(i, offsets.length - 1))];
      if (left === undefined) return;
      rail.scrollTo({ left, behavior: reduced.matches ? "auto" : "smooth" });
    };

    const paint = () => {
      // Whichever slide's left edge sits closest to the rail's scroll position is active.
      let best = 0;
      let bestGap = Infinity;
      const pos = rail.scrollLeft;
      offsets.forEach((off, i) => {
        const gap = Math.abs(off - pos);
        if (gap < bestGap) { bestGap = gap; best = i; }
      });
      index = best;
      slides.forEach((s, i) => s.classList.toggle("is-active", i === index));
      dots.forEach((d, i) => d.classList.toggle("on", i === index));
      if (counter) counter.textContent = `${String(index + 1).padStart(2, "0")} / ${slides.length}`;
      if (bar) bar.style.transform = `scaleX(${(index + 1) / slides.length})`;
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
    };

    let frame = 0;
    rail.addEventListener("scroll", () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(paint);
    }, { passive: true });

    prev?.addEventListener("click", () => { touched = true; goTo(index - 1); });
    next?.addEventListener("click", () => { touched = true; goTo(index + 1); });
    dots.forEach((d, i) => d.addEventListener("click", () => { touched = true; goTo(i); }));
    rail.addEventListener("pointerdown", () => { touched = true; });
    rail.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { touched = true; e.preventDefault(); goTo(index + 1); }
      if (e.key === "ArrowLeft") { touched = true; e.preventDefault(); goTo(index - 1); }
    });

    paint();

    // Gentle auto-advance for the project slider only, and only until the
    // visitor takes over. Paused off-screen, on hover, on focus, and under
    // prefers-reduced-motion.
    if (slider.dataset.slider === "proof" && !reduced.matches) {
      let timer = 0;
      const stop = () => { clearInterval(timer); timer = 0; };
      const start = () => {
        if (timer || touched) return;
        timer = window.setInterval(() => {
          if (touched) return stop();
          goTo(index === slides.length - 1 ? 0 : index + 1);
        }, 7000);
      };
      slider.addEventListener("pointerenter", stop);
      slider.addEventListener("pointerleave", start);
      slider.addEventListener("focusin", stop);
      new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop()), { threshold: 0.4 }).observe(slider);
    }
  });

  /* ---------- Stat numbers count up once, when they scroll into view ---------- */
  const counters = document.querySelectorAll<HTMLElement>("[data-count]");
  if (counters.length) {
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count ?? 0);
      const suffix = el.dataset.suffix ?? "";
      if (reduced.matches || !target) { el.textContent = `${target}${suffix}`; return; }
      const start = performance.now();
      const step = (now: number) => {
        // easeOutCubic, so it lands softly instead of stopping dead
        const t = Math.min((now - start) / 1100, 1);
        el.textContent = `${Math.round(target * (1 - Math.pow(1 - t, 3)))}${suffix}`;
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const co = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        run(entry.target as HTMLElement);
        co.unobserve(entry.target);
      });
    }, { threshold: 0.6 });
    counters.forEach((el) => co.observe(el));
  }

  /* ---------- Scroll reveal ---------- */
  const revealables = document.querySelectorAll<HTMLElement>(".reveal");
  if (reduced.matches) {
    revealables.forEach((el) => el.classList.add("shown"));
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("shown");
        io.unobserve(entry.target);
      });
    }, { rootMargin: "0px 0px -6% 0px", threshold: 0.05 });
    revealables.forEach((el) => io.observe(el));
  }
</script>

<style>
  /* =========================================================================
     Bold editorial system: cream paper, 2px ink outlines, hard offset shadows,
     amber as the only loud colour. Section bands alternate to break the page
     up without extra vertical space. Tokens live in global.css (--bw-*).
     ========================================================================= */
  .sprite { position: absolute; width: 0; height: 0; overflow: hidden; }

  .ico {
    width: 1em; height: 1em;
    flex: none;
    fill: currentColor;
    vertical-align: -0.125em;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  :global(body) {
    background: var(--bw-paper);
    color: var(--bw-ink);
    font-family: var(--font-display);
