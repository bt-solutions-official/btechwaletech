<script>
  // Interactive Tab Switcher for Proof of Work Section
  const initWorkTabs = () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-work-tab]');
    const panels = document.querySelectorAll<HTMLElement>('[data-work-panel]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-work-tab');
        tabs.forEach((t) => {
          const isActive = t === tab;
          t.classList.toggle('active', isActive);
          t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
        panels.forEach((panel) => {
          const isMatch = panel.getAttribute('data-work-panel') === target;
          panel.classList.toggle('active', isMatch);
        });
      });
    });
  };

  initWorkTabs();
</script>



