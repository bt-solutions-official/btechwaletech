---

<BaseLayout meta={page} schema={[faqSchema(faqs)]}>
  <section class="hero" aria-labelledby="home-heading">
    <div class="hero-copy">
      <p class="eyebrow">India-first freelance IT services group</p>
      <h1 id="home-heading">
        Freelance IT services for websites, AI automation, and <em class="accent">data analysis</em>
      </h1>
      <p class="lede">{page.intro}</p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="button button-primary" href="/contact/">
          <span>Start a project</span>
          <span class="button-orb" aria-hidden="true">&rarr;</span>
        </a>
        <a class="button button-ghost" href="/services/">Explore services</a>
      </div>
      <ul class="signal-row" aria-label="Homepage focus areas">
        <li>Design to deployment</li>
        <li>SEO-ready development</li>
        <li>AI, automation &amp; data work</li>
      </ul>
    </div>

    <div class="globe-stage" data-globe-stage>
      <div class="globe-halo" aria-hidden="true"></div>
      <canvas
        data-globe
        aria-label="Rotating globe showing delivery routes from India to Dubai, London, New York, Singapore and Sydney"
      ></canvas>
      <p class="globe-tag" aria-hidden="true">Delivering from India &rarr; worldwide</p>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map(() => (
        <div class="marquee-set">
          {marquee.map((item) => (
            <span class="marquee-item">{item}</span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <section class="services" aria-labelledby="services-heading">
    <div class="section-head">
      <p class="eyebrow">Core services</p>
      <h2 id="services-heading">Practical IT services for businesses that need work done <em class="accent">properly</em></h2>
      <p class="section-note">
        We help with the full digital work stack: website planning, design, development, SEO setup, AI automation,
        AI agents, data analysis, ecommerce, deployment, and maintenance.
      </p>
    </div>
    <div class="bento">
      {services.map((s) => {
        const inner = (
          <div class="card-core">
            <h3>{s.name}</h3>
            <p>{s.summary}</p>
            <ul class="service-points">
              {s.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            {s.href && <span class="card-arrow" aria-hidden="true">&rarr;</span>}
          </div>
        );
        return s.href ? (
          <a class={`card card-${s.size}`} href={s.href}>
            {inner}
          </a>
        ) : (
          <div class={`card card-${s.size}`}>
            {inner}
          </div>
        );
      })}
    </div>
  </section>

  <section class="builds" aria-labelledby="builds-heading">
    <div class="section-head">
      <p class="eyebrow">Static &amp; dynamic</p>
      <h2 id="builds-heading">Every kind of website, built the <em class="accent">right</em> way</h2>
      <p class="section-note">
        Some businesses need a fast static website. Others need a dynamic web app, dashboard, automation, or AI-powered
        workflow. We help choose the right setup before development starts.
      </p>
    </div>
    <div class="build-grid">
      {builds.map((b) => (
        <a class="build-card" href="/services/web-development/">
          <div class="card-core">
            <p class="build-tag">{b.tag}</p>
            <h3>{b.name}</h3>
            <p class="build-summary">{b.summary}</p>
            <ul class="build-points">
              {b.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            <span class="card-arrow" aria-hidden="true">&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="stats" aria-label="Btechwale in numbers">
    <ul class="stat-band">
      {stats.map((s) => (
        <li>
          <span class="stat-num">{s.value}{s.suffix}</span>
          <span class="stat-label">{s.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="process" aria-labelledby="process-heading">
    <div class="section-head">
      <p class="eyebrow">How work stays clean</p>
      <h2 id="process-heading">Clear requirement, clean build, smooth deployment</h2>
    </div>
    <ol class="steps">
      {process.map(([step, detail], i) => (
        <li>
          <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <h3>{step}</h3>
          <p>{detail}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="locations" aria-labelledby="locations-heading">
    <div class="section-head">
      <p class="eyebrow">Local reach</p>
      <h2 id="locations-heading">Local pages for 150+ cities across India</h2>
      <p class="section-note">
        Every state and major city has its own page covering the local business context, not the same text with a
        name swapped in. Start with your city, or browse the full directory.
      </p>
    </div>
    <div class="city-cloud">
      {locations.map(([name, href]) => (
        <a class="city-chip" href={href}>{name}</a>
      ))}
    </div>
    <p class="cloud-label">Browse by state</p>
    <div class="city-cloud city-cloud-muted">
      {stateHubs.map(([name, href]) => (
        <a class="city-chip" href={href}>{name}</a>
      ))}
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-heading">
    <div class="section-head">
      <p class="eyebrow">Questions</p>
      <h2 id="faq-heading">Answers before you even ask</h2>
    </div>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>
            <span>{f.question}</span>
            <span class="faq-mark" aria-hidden="true">+</span>
          </summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="closing" aria-labelledby="cta-heading">
    <div class="closing-panel">
      <p class="eyebrow eyebrow-light">Next step</p>
      <h2 id="cta-heading">Need a website, automation, AI agent, or data workflow?</h2>
      <p class="closing-note">
        Tell us what you want to build or fix. We will reply with a clear scope, honest estimate, and practical delivery
        plan for your website, SEO setup, AI automation, data analysis, or custom IT work.
      </p>
      <a class="button button-cream" href="/contact/">
        <span>Discuss the project</span>
        <span class="button-orb" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const stage = document.querySelector("[data-globe-stage]");
  const canvas = document.querySelector("[data-globe]");

  if (stage && canvas) {
    const ctx = canvas.getContext("2d");
    const TILT = -0.42;
    const BASE_SPEED = 0.00012;

    /* quasi-uniform sphere points via a fibonacci lattice */
    const DOTS = 1500;
    const points = [];
    const golden = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < DOTS; i++) {
      const y = 1 - (i / (DOTS - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      const t = golden * i;
      points.push([Math.cos(t) * r, y, Math.sin(t) * r]);
    }

    const ll = (lat, lon) => {
      const la = (lat * Math.PI) / 180;
      const lo = (lon * Math.PI) / 180;
      return [Math.cos(la) * Math.cos(lo), Math.sin(la), Math.cos(la) * Math.sin(lo)];
    };

    const delhi = ll(28.6, 77.2);
    const homes = [delhi, ll(19.1, 72.9), ll(12.97, 77.6)];
    const abroad = [ll(25.2, 55.3), ll(51.5, -0.1), ll(40.7, -74), ll(1.35, 103.8), ll(-33.9, 151.2)];
    const arcs = abroad.map((dest, i) => ({ a: delhi, b: dest, offset: i / abroad.length }));

    const slerp = (a, b, t) => {
      const dot = Math.min(1, Math.max(-1, a[0] * b[0] + a[1] * b[1] + a[2] * b[2]));
      const ang = Math.acos(dot);
      if (ang < 1e-4) return a;
      const s = Math.sin(ang);
      const w1 = Math.sin((1 - t) * ang) / s;
      const w2 = Math.sin(t * ang) / s;
      return [a[0] * w1 + b[0] * w2, a[1] * w1 + b[1] * w2, a[2] * w1 + b[2] * w2];
    };

    let rotY = -0.223; // starts with India facing the viewer
    let vel = BASE_SPEED;
    let dragging = false;
    let lastX = 0;
    let lastT = 0;
    let W = 0, H = 0, R = 0, CX = 0, CY = 0;

    const resize = () => {
      const rect = stage.getBoundingClientRect();
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      W = rect.width;
      H = rect.width;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      canvas.style.width = W + "px";
      canvas.style.height = H + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      R = W * 0.4;
      CX = W / 2;
      CY = H / 2;
    };

    const rot = (p) => {
      const cy = Math.cos(rotY), sy = Math.sin(rotY);
      const cx = Math.cos(TILT), sx = Math.sin(TILT);
      const x = p[0] * cy + p[2] * sy;
      const z0 = -p[0] * sy + p[2] * cy;
      const y = p[1] * cx - z0 * sx;
      const z = p[1] * sx + z0 * cx;
      return [x, y, z];
    };

    const draw = (now) => {
      ctx.clearRect(0, 0, W, H);

      ctx.beginPath();
      ctx.arc(CX, CY, R, 0, Math.PI * 2);
      ctx.strokeStyle = "rgba(22, 36, 46, 0.09)";
      ctx.lineWidth = 1;
      ctx.stroke();

      for (const p of points) {
        const [x, y, z] = rot(p);
        const depth = (z + 1) / 2;
        const alpha = z > 0 ? 0.08 + depth * 0.4 : 0.05;
        const size = 0.5 + depth * 1.2;
        ctx.beginPath();
        ctx.arc(CX + x * R, CY - y * R, size, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(31, 58, 82, " + alpha + ")";
        ctx.fill();
      }

      for (const arc of arcs) {
        const SEG = 42;
        ctx.beginPath();
        let visible = false;
        for (let i = 0; i <= SEG; i++) {
          const t = i / SEG;
          const p = slerp(arc.a, arc.b, t);
          const lift = 1 + 0.28 * Math.sin(Math.PI * t);
          const [x, y, z] = rot([p[0] * lift, p[1] * lift, p[2] * lift]);
          const px = CX + x * R;
          const py = CY - y * R;
          if (i === 0) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
          if (z > -0.15) visible = true;
        }
        if (visible) {
          ctx.strokeStyle = "rgba(224, 138, 0, 0.34)";
          ctx.lineWidth = 1.1;
          ctx.stroke();

          const t = (now * 0.00011 + arc.offset) % 1;
          const p = slerp(arc.a, arc.b, t);
          const lift = 1 + 0.28 * Math.sin(Math.PI * t);
          const [x, y, z] = rot([p[0] * lift, p[1] * lift, p[2] * lift]);
          if (z > -0.15) {
            const px = CX + x * R;
            const py = CY - y * R;
            const g = ctx.createRadialGradient(px, py, 0, px, py, 8);
            g.addColorStop(0, "rgba(224, 138, 0, 0.95)");
            g.addColorStop(1, "rgba(224, 138, 0, 0)");
            ctx.beginPath();
            ctx.arc(px, py, 8, 0, Math.PI * 2);
            ctx.fillStyle = g;
            ctx.fill();
          }
        }
      }

      const marker = (p, color, glow, size) => {
        const [x, y, z] = rot(p);
        if (z < -0.05) return;
        const px = CX + x * R;
        const py = CY - y * R;
        const g = ctx.createRadialGradient(px, py, 0, px, py, size * 4);
        g.addColorStop(0, glow);
        g.addColorStop(1, "rgba(255,255,255,0)");
        ctx.beginPath();
        ctx.arc(px, py, size * 4, 0, Math.PI * 2);
        ctx.fillStyle = g;
        ctx.fill();
        ctx.beginPath();
        ctx.arc(px, py, size, 0, Math.PI * 2);
        ctx.fillStyle = color;
        ctx.fill();
      };
      for (const h of homes) marker(h, "rgba(224, 138, 0, 1)", "rgba(224, 138, 0, 0.3)", 2.6);
      for (const d of abroad) marker(d, "rgba(18, 144, 124, 0.95)", "rgba(18, 144, 124, 0.24)", 2);
    };

    let raf = null;
    let prev = 0;
    let running = false;

    const loop = (now) => {
      const dt = prev ? Math.min(48, now - prev) : 16;
      prev = now;
      if (!dragging) {
        rotY += vel * dt;
        vel += (BASE_SPEED - vel) * 0.015;
      }
      draw(now);
      if (running) raf = requestAnimationFrame(loop);
    };

    const start = () => {
      if (!running) {
        running = true;
        prev = 0;
        raf = requestAnimationFrame(loop);
      }
    };
    const stop = () => {
      running = false;
      if (raf !== null) cancelAnimationFrame(raf);
      raf = null;
    };

    resize();
    draw(0);
    window.addEventListener("resize", () => {
      resize();
      if (!running) draw(performance.now());
    });

    if (!reduced) {
      /* only animate while the globe is actually on screen */
      new IntersectionObserver((entries) => {
        entries[0].isIntersecting ? start() : stop();
      }, { threshold: 0.05 }).observe(stage);

      canvas.addEventListener("pointerdown", (e) => {
        dragging = true;
        lastX = e.clientX;
        lastT = e.timeStamp;
        canvas.setPointerCapture(e.pointerId);
      });
      canvas.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        const dx = e.clientX - lastX;
        const dt = Math.max(1, e.timeStamp - lastT);
        rotY += dx * 0.005;
        vel = Math.max(-0.004, Math.min(0.004, (dx * 0.005) / dt));
        lastX = e.clientX;
        lastT = e.timeStamp;
      });
      const release = () => { dragging = false; };
      canvas.addEventListener("pointerup", release);
      canvas.addEventListener("pointercancel", release);
    }
  }
</script>

<style>
  /* ================= tokens ================= */
  .hero,
  .services,
  .builds,
  .stats,
  .process,
  .locations,
  .faq,
  .closing {
    --paper: #f8f5ef;
    --card: #ffffff;
    --ink: #16242e;
    --muted: #46555c;
    --hairline: rgba(22, 36, 46, 0.1);
    --teal: #0f766e;
    --saffron: #8d5100;
    --ease: cubic-bezier(0.32, 0.72, 0, 1);
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 7.5rem) clamp(1rem, 4vw, 3rem);
  }

  :global(body) {
    color: #16242e;
    background: #f8f5ef;
  }

  :global(::selection) {
    color: #ffffff;
    background: #0f766e;
  }

  /* ================= type ================= */
  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1,
  h2 {
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-weight: 640;
    letter-spacing: -0.028em;
  }

  h1 {
    margin-bottom: 1rem;
    max-width: 19ch;
    font-size: clamp(2.25rem, 3.9vw, 3.55rem);
    line-height: 1.06;
  }

  h2 {
    max-width: 24ch;
    font-size: clamp(1.85rem, 3.8vw, 3rem);
    line-height: 1.08;
  }

  .accent {
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-weight: 480;
    letter-spacing: -0.01em;
    color: var(--teal);
    white-space: nowrap;
  }

  .accent-warm {
    color: var(--saffron);
  }

  .lede {
    max-width: 30rem;
    color: var(--muted);
    font-size: clamp(1rem, 1.35vw, 1.12rem);
    line-height: 1.65;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: fit-content;
    margin: 0 0 1.3rem;
    color: var(--teal);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    width: 1.8rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    content: "";
  }

  .eyebrow-light {
    color: #7fd6c6;
  }

  .section-head {
    max-width: 46rem;
    margin-bottom: clamp(2.2rem, 4vw, 3.4rem);
  }

  .section-note {
    margin-top: 1.1rem;
    color: var(--muted);
    line-height: 1.7;
  }

  .marquee,
  .services,
  .builds,
  .stats,
  .process,
  .locations,
  .faq,
  .closing {
    content-visibility: auto;
    contain-intrinsic-size: auto 44rem;
  }

  /* ================= buttons ================= */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.8rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.3rem;
    padding: 0 0.5rem 0 1.5rem;
    border-radius: 999px;
    font-size: 0.98rem;
    font-weight: 650;
    text-decoration: none;
    transition:
      transform 550ms var(--ease),
      background-color 550ms var(--ease),
      box-shadow 550ms var(--ease),
      border-color 550ms var(--ease);
  }

  .button:active {
    transform: scale(0.97);
  }

  .button-orb {
    display: inline-grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 50%;
    transition: transform 550ms var(--ease);
  }

  .button:hover .button-orb,
  .button:focus-visible .button-orb {
    transform: translateX(3px);
  }

  .button-primary {
    color: #f8f5ef;
    background: var(--ink);
    box-shadow: 0 18px 40px -12px rgba(22, 36, 46, 0.4);
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    background: var(--teal);
    box-shadow: 0 18px 44px -10px rgba(18, 144, 124, 0.45);
  }

  .button-primary .button-orb {
    color: var(--ink);
    background: #f8f5ef;
  }

  .button-ghost {
    padding-inline: 1.5rem;
    color: var(--ink);
    border: 1px solid var(--hairline);
    background: rgba(255, 255, 255, 0.65);
  }

  .button-ghost:hover,
  .button-ghost:focus-visible {
    border-color: rgba(22, 36, 46, 0.25);
    background: #ffffff;
  }

  .button-cream {
    color: var(--ink);
    background: #f8f5ef;
    box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.45);
  }

  .button-cream:hover,
  .button-cream:focus-visible {
    background: #ffffff;
  }

  .button-cream .button-orb {
    color: #f8f5ef;
    background: var(--ink);
  }

  /* ================= hero ================= */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.8fr);
    gap: clamp(1.25rem, 2.5vw, 2.75rem);
    align-items: center;
    min-height: calc(78dvh - 4.5rem);
    padding-top: clamp(2.2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
    overflow: hidden;
  }

  .hero-copy {
    max-width: 34rem;
  }

  .signal-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 1.55rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 550;
  }

  .signal-row li {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 0.75rem;
    border: 1px solid rgba(22, 36, 46, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.58);
  }

  .signal-row li + li::before {
    content: none;
  }

  .globe-stage {
    position: relative;
    display: grid;
    place-items: center;
    justify-self: center;
    width: min(100%, 26rem);
    max-width: 100%;
    aspect-ratio: 1;
  }

  .globe-stage canvas {
    position: relative;
    z-index: 1;
    display: block;
    max-width: 100%;
    cursor: grab;
    touch-action: pan-y;
  }

  .globe-stage canvas:active {
    cursor: grabbing;
  }

  .globe-halo {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, rgba(18, 144, 124, 0.1), rgba(18, 144, 124, 0.02) 55%, transparent 72%);
    filter: blur(6px);
  }

  .globe-tag {
    position: absolute;
    bottom: 4%;
    z-index: 2;
    padding: 0.5rem 1rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(12px);
    font-size: 0.82rem;
    font-weight: 550;
  }

  /* ================= marquee ================= */
  .marquee {
    position: relative;
    z-index: 1;
    overflow: hidden;
    padding: 1.1rem 0;
    border-top: 1px solid rgba(22, 36, 46, 0.09);
    border-bottom: 1px solid rgba(22, 36, 46, 0.09);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: slide 36s linear infinite;
  }

  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-set {
    display: flex;
    align-items: center;
  }

  .marquee-item {
    color: #46555c;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.95rem;
    font-weight: 560;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .marquee-item::after {
    margin: 0 1.6rem;
    color: rgba(224, 138, 0, 0.6);
    content: "\2726";
  }

  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }

  /* ================= services bento ================= */
  .bento {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
    align-items: start;
  }

  .card,
  .build-card {
    display: block;
    padding: 0.45rem;
    border: 1px solid var(--hairline);
    border-radius: 1.7rem;
    background: rgba(22, 36, 46, 0.03);
    text-decoration: none;
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)) translateY(var(--lift, 0px));
    transition:
      transform 350ms var(--ease),
      border-color 600ms var(--ease),
      box-shadow 600ms var(--ease);
  }

  .card-core {
    position: relative;
    overflow: hidden;
    height: 100%;
    padding: clamp(1.4rem, 2.5vw, 1.9rem);
    border-radius: calc(1.7rem - 0.45rem);
    background: var(--card);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 1px 2px rgba(22, 36, 46, 0.04);
  }

  /* cursor spotlight */
  .card .card-core::before,
  .build-card .card-core::before {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: radial-gradient(13rem circle at var(--mx, 50%) var(--my, 50%), rgba(18, 144, 124, 0.07), transparent 65%);
    transition: opacity 500ms var(--ease);
    content: "";
    pointer-events: none;
  }

  .card:hover .card-core::before,
  .build-card:hover .card-core::before {
    opacity: 1;
  }

  .card-lg,
  .card-md,
  .card-sm {
    grid-column: auto;
  }

  .card h3 {
    margin-bottom: 0.65rem;
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    font-weight: 620;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }

  .card-lg h3 {
    font-size: clamp(1.25rem, 2vw, 1.65rem);
  }

  .card p {
    max-width: 34rem;
    margin-bottom: 1rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .service-points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-points li {
    position: relative;
    padding-left: 1rem;
    color: #52616a;
    font-size: 0.86rem;
    line-height: 1.35;
  }

  .service-points li::before {
    position: absolute;
    top: 0.58em;
    left: 0;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--teal);
    content: "";
  }

  .card-arrow {
    position: absolute;
    right: 1.3rem;
    bottom: 1.2rem;
    display: inline-grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    color: var(--teal);
    background: rgba(18, 144, 124, 0.06);
    transition: transform 600ms var(--ease), background-color 600ms var(--ease), color 600ms var(--ease);
  }

  a.card:hover,
  a.card:focus-visible,
  .build-card:hover,
  .build-card:focus-visible {
    --lift: -5px;
    border-color: rgba(18, 144, 124, 0.35);
    box-shadow: 0 30px 60px -24px rgba(22, 36, 46, 0.25);
  }

  a.card:hover .card-arrow,
  a.card:focus-visible .card-arrow,
  .build-card:hover .card-arrow,
  .build-card:focus-visible .card-arrow {
    transform: translate(3px, -3px);
    color: #ffffff;
    background: var(--teal);
  }

  .card-lg .card-core,
  .card-md .card-core,
  .card-sm .card-core {
    min-height: 18rem;
  }

  /* ================= static vs dynamic ================= */
  .build-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .build-card .card-core {
    padding-bottom: 4rem;
  }

  .build-tag {
    width: fit-content;
    margin-bottom: 1rem;
    padding: 0.28rem 0.7rem;
    border: 1px solid rgba(224, 138, 0, 0.35);
    border-radius: 999px;
    color: var(--saffron);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .build-card h3 {
    margin-bottom: 0.7rem;
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(1.4rem, 2.2vw, 1.8rem);
    font-weight: 630;
    letter-spacing: -0.015em;
  }

  .build-summary {
    color: var(--muted);
    line-height: 1.65;
  }

  .build-points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem 1rem;
    margin: 1.3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .build-points li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .build-points li::before {
    position: absolute;
    left: 0;
    color: var(--teal);
    font-weight: 700;
    content: "\2713";
  }

  /* ================= stats ================= */
  .stats {
    padding-top: 0;
  }

  .stat-band {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 3rem);
    border: 1px solid var(--hairline);
    border-radius: 2rem;
    background: var(--card);
    box-shadow: 0 30px 70px -30px rgba(22, 36, 46, 0.18);
    list-style: none;
  }

  .stat-band li {
    display: grid;
    gap: 0.35rem;
    text-align: center;
  }

  .stat-num {
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 680;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* ================= process ================= */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: clamp(1.8rem, 3vw, 2.4rem) 0 0;
    border-top: 1px solid var(--hairline);
    list-style: none;
  }

  .steps li {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .step-num {
    color: var(--saffron);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .steps h3 {
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 1.32rem;
    font-weight: 630;
    letter-spacing: -0.01em;
  }

  .steps p {
    color: var(--muted);
    line-height: 1.65;
  }

  /* ================= locations ================= */
  .city-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .city-chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    padding: 0 1.3rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    color: var(--ink);
    background: var(--card);
    font-size: 0.96rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 24px -14px rgba(22, 36, 46, 0.25);
    transition:
      transform 550ms var(--ease),
      border-color 550ms var(--ease),
      background-color 550ms var(--ease),
      color 550ms var(--ease),
      box-shadow 550ms var(--ease);
  }

  .city-chip:nth-child(odd) {
    transform: rotate(-0.7deg);
  }

  .city-chip:nth-child(even) {
    transform: rotate(0.6deg);
  }

  .city-chip:hover,
  .city-chip:focus-visible {
    transform: translateY(-3px) rotate(0deg);
    border-color: rgba(18, 144, 124, 0.4);
    color: var(--teal);
    box-shadow: 0 18px 34px -14px rgba(18, 144, 124, 0.35);
  }

  .city-chip:active {
    transform: scale(0.97);
  }

  .cloud-label {
    margin: 2rem 0 0.9rem;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .city-cloud-muted .city-chip {
    min-height: 2.5rem;
    padding: 0 1.05rem;
    background: transparent;
    box-shadow: none;
    font-size: 0.9rem;
    font-weight: 550;
  }

  /* ================= faq ================= */
  .faq-list {
    border-top: 1px solid var(--hairline);
  }

  .faq-item {
    border-bottom: 1px solid var(--hairline);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 0.25rem;
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    list-style: none;
    cursor: pointer;
    transition: color 400ms var(--ease);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:hover {
    color: var(--teal);
  }

  .faq-mark {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    color: var(--teal);
    font-size: 1.1rem;
    font-weight: 500;
    transition: transform 500ms var(--ease), background-color 500ms var(--ease), color 500ms var(--ease);
  }

  .faq-item[open] .faq-mark {
    transform: rotate(45deg);
    color: #ffffff;
    background: var(--teal);
  }

  .faq-item p {
    max-width: 52rem;
    padding: 0 0.25rem 1.4rem;
    color: var(--muted);
    line-height: 1.75;
  }

  /* ================= closing ================= */
  .closing {
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }

  .closing-panel {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 7vw, 5.5rem) clamp(1.5rem, 5vw, 5rem);
    border-radius: 2.4rem;
    background:
      radial-gradient(38rem 22rem at 50% -35%, rgba(18, 144, 124, 0.28), transparent 70%),
      linear-gradient(180deg, #1a2f3c, #121e28);
    box-shadow:
      inset 0 1px 0 rgba(248, 245, 239, 0.1),
      0 40px 90px -35px rgba(22, 36, 46, 0.5);
    text-align: center;
  }

  .closing-panel .eyebrow,
  .closing-panel h2 {
    margin-inline: auto;
  }

  .closing-panel h2 {
    max-width: 22ch;
    margin-bottom: 1.1rem;
    color: #f8f5ef;
  }

  .closing-note {
    max-width: 44rem;
    margin: 0 auto 2.3rem;
    color: rgba(248, 245, 239, 0.72);
    font-size: 1.03rem;
    line-height: 1.7;
  }

  /* ================= responsive ================= */
  @media (max-width: 980px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 2rem;
      padding-top: 2.5rem;
    }

    h1 {
      max-width: 14.5ch;
    }

    .globe-stage {
      width: min(82vw, 24rem);
      margin: 0 auto;
    }

    .build-grid {
      grid-template-columns: 1fr;
    }

    .stat-band {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1rem;
    }
  }

  @media (max-width: 760px) {
    .bento {
      grid-template-columns: 1fr;
    }

    .card-lg .card-core,
    .card-md .card-core,
    .card-sm .card-core {
      min-height: 0;
    }
  }

  @media (max-width: 620px) {
    .hero,
    .services,
    .builds,
    .stats,
    .process,
    .locations,
    .faq,
    .closing {
      padding-inline: 1rem;
    }

    .steps {
      grid-template-columns: 1fr;
    }

    h1 {
      max-width: 100%;
      font-size: clamp(2.05rem, 10vw, 2.95rem);
      line-height: 1.08;
    }

    .eyebrow {
      font-size: 0.68rem;
      letter-spacing: 0.1em;
    }

    .hero-actions {
      gap: 0.65rem;
      margin-top: 1.45rem;
    }

    .button {
      min-height: 3rem;
      padding-left: 1.15rem;
      font-size: 0.92rem;
    }

    .globe-stage {
      width: min(78vw, 20rem);
    }

    .globe-tag {
      bottom: 0;
      font-size: 0.72rem;
    }

    .signal-row {
      gap: 0.45rem;
    }

    .signal-row li {
      min-height: 1.85rem;
      padding-inline: 0.65rem;
      font-size: 0.78rem;
    }

    .service-points {
      grid-template-columns: 1fr;
    }

    .build-points {
      grid-template-columns: 1fr;
