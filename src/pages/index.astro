// Every city with a live /{city}/ page, biggest first. Grows automatically as content files are added.
const builtCitySlugs = new Set(
  Object.keys(import.meta.glob("../data/cities/content/*.ts")).map((p) => p.split("/").pop()!.replace(/\.ts$/, "")),
);
const locations = (cities as CityListing[]).filter((c) => builtCitySlugs.has(c.slug));

// 20 city links per slide: every link stays in the HTML for crawlers, but the block
// occupies one panel's worth of space instead of a 700-chip wall.
const CITIES_PER_SLIDE = 20;
const citySlides = Array.from({ length: Math.ceil(locations.length / CITIES_PER_SLIDE) }, (_, i) =>
  locations.slice(i * CITIES_PER_SLIDE, (i + 1) * CITIES_PER_SLIDE),
);

const priceTable = pricingPlans.map((p) => {
  const per = p.unit ? "/mo" : "";
  return { service: p.name, includes: p.includes.join(", "), timeline: p.timeline, inr: p.price + per, usd: usdPrice(p.price) + per };
});

