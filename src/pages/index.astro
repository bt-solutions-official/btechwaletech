          </div>
        </div>

        <div class="slider" data-slider="cities">
          <div class="rail city-rail" data-rail tabindex="0" role="group" aria-roledescription="carousel" aria-label={`${locations.length} Indian cities with a dedicated page`}>
            {citySlides.map((group, i) => (
              <div class="slide city-panel" data-slide aria-label={`Cities ${i * CITIES_PER_SLIDE + 1} to ${i * CITIES_PER_SLIDE + group.length}`}>
